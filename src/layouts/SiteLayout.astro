---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { path } from '../lib/paths';
import '../styles/global.css';
import '../styles/responsive.css';
import '../styles/editorial-images.css';
import '../styles/editorial-detail.css';
import '../styles/portrait.css';
import '../styles/aula-card-layout.css';
const { title = 'SOMA CONSCIENTE', description = 'Cuatro caminos, un mismo núcleo. Aprendizaje, prácticas gratuitas y acompañamiento desde el cuerpo, la emoción, la consciencia y la naturaleza.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#f7f1e8"/>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical.toString()}/>
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')}/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="SOMA CONSCIENTE"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <title>{title === 'SOMA CONSCIENTE' ? title + ' · Cuatro caminos, un mismo núcleo' : title + ' · SOMA CONSCIENTE'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet"/>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header/>
    <main id="contenido"><slot/></main>
    <Footer/>
  </body>
</html>
