---
import { Icon } from 'astro-icon/components';
import EditorialPhoto from '../components/EditorialPhoto.astro';
import OfferingAction from '../components/OfferingAction.astro';
import SignupDialog from '../components/SignupDialog.astro';
import SomaAulaSymbol from '../components/SomaAulaSymbol.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadAulas } from '../lib/content';
import { loadHomepage } from '../lib/home';
import { mediaUrl } from '../lib/media';
import { offeringUrl, offerings, type Offering } from '../lib/offerings';
import { path } from '../lib/paths';

const home = await loadHomepage();
const aulas = await loadAulas();
const areas = ['nicole', 'jasper', 'yanina', 'nico']
  .map((slug) => aulas.find((aula) => aula.slug === slug))
  .filter((aula) => aula !== undefined);
const encounter = offerings.find(offer => offer.slug === 'encuentro-enero');
const door = offerings.find(offer => offer.slug === 'puerta-abierta');
const retreatDates = encounter && 'dates' in encounter && encounter.dates?.length
  ? encounter.dates
  : [];
const retreatEvents: Offering[] = encounter
  ? (retreatDates.length ? retreatDates : [{
      when: encounter.when || '',
      venue: encounter.venue || '',
      details: encounter.details || '',
      action: encounter.action,
      actionHint: encounter.actionHint,
      url: encounter.url,
    }]).map((date, index) => ({
      ...encounter,
      slug: index === 0 ? encounter.slug : encounter.slug + '-' + (index + 1),
      when: date.when,
      venue: date.venue,
      details: date.details,
      action: date.action,
      actionHint: date.actionHint,
      url: date.url,
    }))
  : [];
const link = encounter && offeringUrl(encounter);
const message = link?.startsWith('https://wa.me/') ? new URL(link).searchParams.get('text') : undefined;
const requestsEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const showDialog = requestsEnabled && [encounter, door].some(offer => offer && !offeringUrl(offer));
const action = encounter && link ? { label: encounter.action, href: link } : undefined;
const fire = { src: mediaUrl(home.encountersImage), alt: home.encountersAlt };
const journal = { src: mediaUrl(home.onlineImage), alt: home.onlineAlt };
---
<SiteLayout title="Retiro SOMA Consciente" description="Retiro SOMA Consciente. El encuentro presencial reúne las cuatro áreas. La próxima fecha es el 23 y 24 de enero de 2027 en Casa Sabia, La Falda, e incluye cuatro encuentros grupales de integración online." openJourney journeyAction={action}>
  {encounter ? (
    <article id={encounter.slug} class="offering retreat" aria-labelledby="encuentro-title">
      <div class:list={['container', 'journey-hero', { 'journey-hero--photo': fire.src }]}>
        <div class="journey-hero__copy">
          <span class="eyebrow">Encuentros presenciales</span>
          <h1 id="encuentro-title">{encounter.title}</h1>
          <p class="journey-lead">{encounter.description}</p>
          <ul class="retreat-areas" aria-label="Cuatro áreas del retiro">
            {areas.map((area) => (
              <li>
                <SomaAulaSymbol symbol={area.symbol} />
                <span>{area.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <EditorialPhoto image={fire} class="journey-photo--campfire" priority>
          {message && (
            <figcaption class="event-message">
              <span class="eyebrow">Mensaje preparado para Yanina</span>
              <p>«{message}»</p>
            </figcaption>
          )}
        </EditorialPhoto>
      </div>
      <div class="container retreat-dates">
        <h2>Próximas fechas</h2>
        <div class="event-grid">
          {retreatEvents.map((event, index) => {
            const featured = index === 0;
            return (
              <section class:list={['event-card', { 'event-card--featured': featured }]} aria-labelledby={event.slug + '-card-title'}>
                <div class="event-card__content">
                  <p class="event-meta event-card__date"><Icon name="iconoir:calendar" size={18} aria-hidden="true" /><strong>{event.when}</strong></p>
                  <h3 id={event.slug + '-card-title'}>
                    {featured ? <>Cuerpo, respiración <em>y naturaleza</em></> : event.title}
                  </h3>
                  <div class="event-card__facts">
                    {event.venue && <p class="event-meta"><Icon name="iconoir:map-pin" size={18} aria-hidden="true" /><span>{event.venue}</span></p>}
                    <p class="event-meta"><Icon name="iconoir:language" size={18} aria-hidden="true" /><span>{retreatDates[index]?.language || 'Español'}</span></p>
                  </div>
                  {event.details && (
                    <div class="event-benefit">
                      <h4>Qué incluye</h4>
                      <p>{event.details}</p>
                      <a class="journey-link" href={path('/acompanamiento/#circulos')}>Conocer los círculos <span aria-hidden="true">↗</span></a>
                    </div>
                  )}
                  <div class="event-card__actions">
                    {featured && <a class="btn event-card__details" href={path('/encuentros/retiro-enero-2027/')}>Ver programa y precios <span aria-hidden="true">↗</span></a>}
                    <OfferingAction offer={event} requestsEnabled={requestsEnabled} class={featured ? 'btn btn--outline' : 'btn'} showArrow />
                  </div>
                </div>
                {featured && (
                  <figure class="event-card__photo">
                    <img
                      src={path('/media/retreat/caballos-en-el-bosque.webp')}
                      alt="Una persona sentada cerca de varios caballos en un claro del bosque"
                      width="1280"
                      height="718"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                )}
              </section>
            );
          })}
        </div>
      </div>
    </article>
  ) : (
    <section class="container journey-hero">
      <h1>Encuentros presenciales</h1>
    </section>
  )}
  {door && (
    <section class="container other-events" aria-labelledby="otros-eventos">
      <h2 id="otros-eventos">Otros eventos</h2>
      <div class="event-grid">
        <article id={door.slug} class="event-card" aria-labelledby="puerta-title">
          <h3 id="puerta-title">{door.title}</h3>
          <p class="event-meta"><Icon name="iconoir:language" size={18} aria-hidden="true" /><span>Español</span></p>
          {door.when && <p class="event-meta"><Icon name="iconoir:calendar" size={18} aria-hidden="true" /><span>{door.when}</span></p>}
          {(door.venue || door.details) && <p class="event-meta"><Icon name="iconoir:map-pin" size={18} aria-hidden="true" /><span>{[door.venue, door.details].filter(Boolean).join(' · ')}</span></p>}
          {door.description && <p>{door.description}</p>}
          <div class="offering__action">
            <OfferingAction offer={door} requestsEnabled={requestsEnabled} class="btn btn--outline" showArrow />
            {!offeringUrl(door) && requestsEnabled && door.followUp && <p class="event-note">{door.followUp}</p>}
          </div>
        </article>
      </div>
    </section>
  )}
  <section class="journey-band">
    <div class:list={['container', 'journey-hero', 'continuity', { 'journey-hero--photo': journal.src }]}>
      <EditorialPhoto image={journal} class="journey-photo--wide" />
      <div>
        <h2>Después del encuentro</h2>
        <p>El encuentro de enero incluye cuatro encuentros grupales de integración online. Después del retiro, el equipo te comparte por WhatsApp los horarios y cómo sumarte.</p>
        <a class="btn btn--light" href={path('/acompanamiento/#circulos')}>Conocer los círculos <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  {showDialog && <SignupDialog />}
</SiteLayout>

<style>
  .offering { scroll-margin-top: 1.25rem; }
  .retreat-areas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .85rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .retreat-areas li {
    display: grid;
    justify-items: center;
    gap: .4rem;
    min-width: 0;
    color: var(--pine-dark);
    font-size: .82rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }
  .retreat-areas :global(img) { width: 3.4rem; height: 3.4rem; }
  .retreat-dates { padding-block: clamp(1.5rem, 4vw, 3rem) 0; }
  .retreat-dates > h2, .other-events > h2 { margin-bottom: .85rem; color: var(--pine-dark); font-size: clamp(2rem, 4vw, 3rem); }
  .other-events { padding-block: clamp(1rem, 3vw, 2rem) clamp(1.5rem, 4vw, 3rem); }
  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.15rem;
  }
  .event-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .35rem;
    min-width: 0;
    padding: clamp(1.15rem, 2.5vw, 1.6rem);
    border: 1px solid var(--line);
    border-radius: 22px;
    background: color-mix(in srgb, var(--cream) 78%, white);
  }
  .event-card h3 { margin: 0 0 .35rem; color: var(--pine-dark); font-size: clamp(1.45rem, 2.4vw, 1.9rem); }
  .event-card--featured {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr);
    align-items: stretch;
    gap: 0;
    grid-column: 1 / -1;
    padding: 0;
    overflow: clip;
    border-color: #d9c7a9;
    background: #fcf8ef;
  }
  .event-card__content { min-width: 0; }
  .event-card--featured .event-card__content { padding: clamp(1.25rem, 4vw, 2.65rem); }
  .event-card .event-card__date {
    color: #944a36;
    font-size: .9rem;
    line-height: 1.35;
  }
  .event-card__content h3 {
    margin-block: .65rem .85rem;
    font-size: clamp(1.85rem, 3.2vw, 3rem);
    line-height: 1.05;
    text-wrap: balance;
  }
  .event-card__content h3 em { color: #944a36; }
  .event-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem 1rem;
    font-size: .94rem;
  }
  .event-card__photo {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    overflow: clip;
    margin: 0;
    padding: clamp(1rem, 3.5vw, 2.5rem);
    background: #203b31;
  }
  .event-card__photo::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 14% -6% 12% 2%;
    border: 1px solid #b99a64;
    border-radius: 57% 43% 49% 45% / 65% 32% 61% 36%;
    transform: rotate(-13deg);
  }
  .event-card__photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.37;
    object-fit: cover;
    object-position: center 42%;
    border-radius: 52% 44% 51% 43% / 60% 39% 54% 42%;
    box-shadow: 0 0 0 1px #d7ba85;
  }
  .event-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .55rem .65rem;
    margin-top: 1.15rem;
  }
  .event-card__actions :global(.btn) {
    gap: .6rem;
    min-block-size: 44px;
    padding-inline: 1rem;
  }
  .event-card__actions :global(.offering-action-hint) {
    flex: 0 0 100%;
    max-inline-size: 54ch;
    margin: .15rem 0 0;
  }
  .event-card__actions .event-card__details {
    background: #203b31;
    color: #fff;
  }
  .event-card__actions .event-card__details:hover { background: #152d24; }
  .event-card__actions :global(.btn--outline) {
    border-color: #a78f6e;
    background: transparent;
    color: #203b31;
  }
  .event-card__actions :global(.btn--outline:hover) { background: #efe4cf; }
  .event-meta {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin: 0;
    color: var(--pine-dark);
  }
  .event-meta :global(svg) { flex: none; color: var(--terra); }
  .event-benefit {
    margin-top: 1rem;
    padding-inline-start: .85rem;
    border-inline-start: 2px solid #d9c7a9;
    font-size: .94rem;
  }
  .event-benefit h4 { margin: 0 0 .15rem; color: var(--pine-dark); font-size: 1em; }
  .event-benefit p { margin: 0; }
  .event-benefit .journey-link { margin-top: .28rem; font-size: .89rem; }
  .event-note { margin: .55rem 0 0; color: var(--muted); font-size: .9rem; }
  .event-message {
    position: absolute;
    z-index: 3;
    inset: auto 0 -.25rem auto;
    inline-size: min(73%, 19rem);
    padding: .75rem 1rem;
    border-inline-start: 2px solid #9f7546;
    color: var(--pine-dark);
    background: var(--cream);
    box-shadow: 0 12px 24px #342a1b20;
  }
  .event-message p { font: 1.04rem/1.35 var(--font-display); margin: .3rem 0 0; }
  .continuity { padding-block: clamp(1.75rem, 3.7vw, 3rem); }
  .continuity.journey-hero--photo { grid-template-columns: minmax(0,.75fr) minmax(0,1.25fr); }
  .continuity h2 { font-size: clamp(1.85rem, 3.7vw, 3.6rem); margin-block-end: .6rem; }
  .continuity p { max-inline-size: 58ch; }
  @media (max-width: 720px) {
    .event-card--featured { grid-template-columns: minmax(0, 1fr); }
    .event-card__photo { grid-row: 1; padding: 1rem; }
    .event-card__photo img { aspect-ratio: 2.05; }
    .event-card__photo::before { inset: 5% 10% 5% 4%; }
    .event-card__actions :global(.btn) { flex: 1 1 auto; }
    .event-message { position: relative; inset: auto; margin: -.75rem 0 0 auto; inline-size: min(89%, 19rem); }
    .continuity.journey-hero--photo { grid-template-columns: minmax(0,1fr); }
    .continuity > div { grid-row: 1; }
    .continuity :global(.journey-photo) { max-inline-size: 26rem; }
    .retreat-areas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
