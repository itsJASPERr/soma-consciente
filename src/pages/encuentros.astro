---
import SiteLayout from '../layouts/SiteLayout.astro';
import Offerings from '../components/Offerings.astro';
import { offerings } from '../lib/offerings';
import { path } from '../lib/paths';
import { loadHomepage } from '../lib/home';
import { mediaUrl } from '../lib/media';

const home = await loadHomepage();
const events = offerings.filter(({ slug }) => slug === 'encuentro-enero' || slug === 'puerta-abierta');
---
<SiteLayout title="Encuentros presenciales" description="Vivencias y retiros presenciales de SOMA. Conocé el encuentro del 15 y 16 de enero de 2027, con un mes de integración online incluido, y Puerta Abierta en La Falda.">
  <section class="page-hero">
    <div class="container">
      <h1>Encuentros presenciales</h1>
      <p>Vivencias y retiros para compartir prácticas y encontrarnos. Después del encuentro, los círculos online nos dan un espacio para integrar lo vivido.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Próximos encuentros</h2>
      <Offerings offers={events} encounterImage={{ src: mediaUrl(home.encountersImage) || '', alt: home.encountersAlt }} />
    </div>
  </section>
  <section class="section--tight digital-band">
    <div class="container">
      <h2>Integrar después del encuentro</h2>
      <p class="section-intro">El encuentro de enero incluye un mes de círculos online. Después del encuentro, el equipo te comparte por WhatsApp los horarios y cómo sumarte.</p>
      <a class="btn" href={path('/acompanamiento/#circulos')}>Conocer los círculos ↗</a>
    </div>
  </section>
</SiteLayout>
