---
import SiteLayout from '../layouts/SiteLayout.astro';
import Offerings from '../components/Offerings.astro';
import { offeringIntro, offerings } from '../lib/offerings';
import { path } from '../lib/paths';
const events = offerings.filter(({ slug }) => slug === 'encuentro-enero' || slug === 'puerta-abierta');
---
<SiteLayout title="Encuentro de enero" description="Encuentro presencial del 15 y 16 de enero de 2027 en Casa Sabia, La Falda. Incluye un mes de círculos de integración online. La inscripción se consulta con Yanina y el equipo confirma si hay lugar.">
  <section class="page-hero">
    <div class="container">
      <h1>Encuentros presenciales</h1>
      <p>{offeringIntro}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <Offerings offers={events} />
    </div>
  </section>
  <section class="section--tight digital-band">
    <div class="container">
      <h2>Integrar después del encuentro</h2>
      <p class="section-intro">En los círculos online retomamos lo vivido para llevarlo a la vida cotidiana. El encuentro de enero incluye un mes.</p>
      <a class="btn" href={path('/acompanamiento/#circulos')}>Conocer los círculos ↗</a>
    </div>
  </section>
</SiteLayout>
