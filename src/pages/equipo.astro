---
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadAulas } from '../lib/content';
const aulas = await loadAulas();
import { path } from '../lib/paths';
import { mediaUrl } from '../lib/media';
---
<SiteLayout title="El equipo">
  <section class="page-hero"><div class="container"><span class="eyebrow">Las personas detrás de SOMA</span><h1>Cuatro historias. Una construcción compartida.</h1><p>Nuestras experiencias no son idénticas. Es justamente esa diversidad la que nos invita a crear un espacio de aprendizaje, encuentro y acompañamiento.</p></div></section>
  <section class="section"><div class="container feature-grid">
    {aulas.map((aula,index)=><article class="feature-card">{mediaUrl(aula.portraitImage) && <img class="team-authentic-portrait" src={mediaUrl(aula.portraitImage) || ''} alt={aula.portraitAlt || 'Retrato de '+aula.guide} loading="lazy" decoding="async" width="840" height="1050"/>}<span class="eyebrow">Integrante 0{index+1}</span><h3>{aula.guide}</h3><p><strong>{aula.qualification}</strong></p>
      {aula.credentials?.length>0 && <ul class="team-credentials">{aula.credentials.map(credential=><li>{credential}</li>)}</ul>}
      <p>{aula.approach}</p><a class="text-link" href={path('/aulas/' + aula.slug + '/')}>Conocer su Aula ↗</a></article>)}
  </div></section>
  <section class="section--tight digital-band"><div class="container"><span class="eyebrow">Nuestro punto de encuentro</span><h2>El Núcleo es lo que construimos juntos.</h2><p class="section-intro">Cada disciplina conserva su identidad y al mismo tiempo puede dialogar con las demás.</p><a class="btn" href={path('/nucleo/')}>Descubrir el Núcleo ↗</a></div></section>
</SiteLayout>
