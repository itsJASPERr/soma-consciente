---
import SiteLayout from '../../layouts/SiteLayout.astro';
import type { Aula } from '../../lib/content';
import { loadAulas } from '../../lib/content';
import { path } from '../../lib/paths';
import { loadCourses, loadSections, loadLessons, courseTree } from '../../lib/learning';
import SomaAulaSymbol from '../../components/SomaAulaSymbol.astro';
import { mediaUrl } from '../../lib/media';
import CourseCard from '../../components/CourseCard.astro';
import { Icon } from 'astro-icon/components';
export async function getStaticPaths() {
  const aulas = await loadAulas();
  return aulas.map(aula => ({params:{slug:aula.slug},props:{aula}}));
}
const { aula } = Astro.props as { aula: Aula };
const courses = (await loadCourses()).filter(c=>c.aula===aula.slug);
const sections = await loadSections();
const lessons = await loadLessons();
---
<SiteLayout title={aula.name} description={aula.description}>
  <div class:list={['aula-page-theme','aula-page-theme--'+aula.theme,'aula-page-theme--symbol-'+aula.symbol]}>
    <section class="aula-hero">
      <div class="container aula-hero__grid">
        <div class="aula-hero__copy">
          <div class="breadcrumbs"><a href={path('/aulas/')}>Las Aulas</a><span>/</span><span>{aula.shortName}</span></div>
          <span class="eyebrow aula-hero__eyebrow">SOMA CONSCIENTE · Un espacio para explorar</span>
          <h1>{aula.name}</h1>
          <p class="aula-hero__subtitle">{aula.summary}</p>
          <p>{aula.description}</p>
          <div class="btn-row"><a class="btn btn--rust" href="#recorridos">Explorar el Aula <Icon name="iconoir:arrow-down" size={17}/></a><a class="btn btn--outline" href={path('/biblioteca/')}>Biblioteca abierta <Icon name="iconoir:arrow-up-right" size={17}/></a></div>
          <div class="aula-hero__host"><Icon name="iconoir:user" size={18}/><span>Un Aula creada por <strong>{aula.guide}</strong></span></div>
        </div>
        <div class:list={['aula-hero__visual',{'aula-hero__visual--photo':!!aula.coverImage}]}>
          {mediaUrl(aula.coverImage) && <img class="aula-hero__photo" src={mediaUrl(aula.coverImage) || ''} alt={aula.coverAlt || 'Imagen ilustrativa de este Aula'} loading="eager" decoding="async" width="1050" height="1050"/>}
          <div class="aula-hero__visual-inner" aria-hidden="true"><SomaAulaSymbol symbol={aula.symbol} eager/></div>
          <span class="aula-hero__ring aula-hero__ring--one"></span>
          <span class="aula-hero__ring aula-hero__ring--two"></span>
        </div>
      </div>
    </section>
    <section class="section" id="recorridos"><div class="container">
      <div class="section-head"><div><span class="eyebrow">Aprender · Practicar · Integrar</span><h2>Recorridos de este Aula</h2><p>Los cursos se organizan en etapas y lecciones que podés explorar a tu ritmo, desde cualquier lugar.</p></div></div>
      {courses.length ? <div class="learning-course-list">{courses.map(course=><CourseCard aula={aula} course={course} available={courseTree(course,sections,lessons).available.length} planned={courseTree(course,sections,lessons).plannedCount}/>)}</div>
      : <div class="learning-empty"><Icon name="iconoir:book-stack" size={30}/><h3>Un espacio en construcción</h3><p>Pronto encontrarás recorridos y contenidos propios de esta Aula. Mientras tanto, podés explorar las prácticas gratuitas que compartimos en SOMA.</p><a class="btn" href={path('/biblioteca/')}>Ir a la Biblioteca <Icon name="iconoir:arrow-up-right" size={17}/></a></div>}
    </div></section>
    <section class="section--tight aula-about"><div class="container aula-about__grid">
      <div>{mediaUrl(aula.portraitImage) && <figure class="aula-authentic-portrait"><img src={mediaUrl(aula.portraitImage) || ''} alt={aula.portraitAlt || 'Retrato de '+aula.guide} loading="lazy" width="840" height="1050" decoding="async"/></figure>}<span class="eyebrow">La persona detrás del Aula</span><h2>{aula.guide}</h2><p class="detail-meta">{aula.qualification}</p><p class="section-intro">{aula.approach}</p><blockquote class="aula-about__quote">“{aula.invitation}”</blockquote></div>
      <div><h3>Lo que exploramos</h3><ul class="aula-focus-list">{aula.practices.map(p=><li><Icon name="iconoir:check-circle" size={18}/>{p}</li>)}</ul><a class="text-link" href={path('/nucleo/')}>Cómo se integra en el Núcleo <Icon name="iconoir:arrow-up-right" size={18}/></a></div>
    </div></section>
    <section class="section"><div class="container learning-final-cta"><span class="eyebrow">Sin registro · Contenido abierto</span><h2>Un primer paso también puede ser pequeño.</h2><p>Encontrá meditaciones, ejercicios y textos disponibles gratuitamente en la Biblioteca de SOMA.</p><a class="btn" href={path('/biblioteca/')}>Explorar recursos <Icon name="iconoir:arrow-up-right" size={18}/></a></div></section>
  </div>
</SiteLayout>
