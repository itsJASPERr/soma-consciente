---
import EditorialPhoto from '../../components/EditorialPhoto.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadResources, type Resource } from '../../lib/content';
import { path } from '../../lib/paths';
import { mediaUrl } from '../../lib/media';
import { somaOrganizationId } from '../../lib/site-identity';

export async function getStaticPaths() {
  const resources = await loadResources();
  return resources.map(resource => ({ params: { slug: resource.slug }, props: { resource } }));
}

const { resource } = Astro.props as { resource: Resource };
const image = { src: mediaUrl(resource.image), alt: resource.imageAlt || resource.title };
const description = resource.summary + ' ' + resource.category + ' de ' + resource.duration + ' en la Biblioteca abierta de SOMA.';
const article = {
  '@type': 'Article',
  headline: resource.title,
  description,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: 'es-AR',
  ...(image.src && { image: new URL(image.src, Astro.site).href }),
  publisher: { '@id': somaOrganizationId(Astro.site) },
};
---
<SiteLayout
  title={resource.title}
  description={description}
  ogType="article"
  ogImage={image.src}
  ogImageAlt={image.alt}
  breadcrumbs={[{ name: 'Biblioteca', href: '/biblioteca/' }]}
  structuredData={[article]}
  openJourney
>
  <section class:list={['container', 'journey-hero', { 'journey-hero--photo': image.src }]}>
    <div class="journey-hero__copy">
      <a class="journey-link resource-back" href={path('/biblioteca/')}><span aria-hidden="true">←</span> Biblioteca</a>
      <h1>{resource.title}</h1>
      <p class="eyebrow">Práctica abierta · {resource.duration}</p>
      <p class="journey-lead">{resource.summary}</p>
    </div>
    <EditorialPhoto image={image} class="journey-photo--wide" priority />
  </section>
  <div class="container resource-reading">
    <article class="resource-reading__article">
      <p class="journey-lead">{resource.introduction}</p>
      {resource.sections.map(section => (
        <section>
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
        </section>
      ))}
      <blockquote>«{resource.reflection}»</blockquote>
      <p class="resource-reading__care">Esta práctica es una invitación educativa y no sustituye atención de salud mental o médica. Si alguna sensación resulta incómoda, podés detenerte, orientarte en tu entorno o pedir apoyo.</p>
    </article>
    <div>
      <a class="btn btn--outline" href={path('/biblioteca/')}>Volver a la Biblioteca <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</SiteLayout>

<style>
  .resource-back { margin-block-end: .5rem; }
  .resource-reading {
    display: grid;
    grid-template-columns: minmax(0, 45rem) auto;
    align-items: start;
    justify-content: space-between;
    gap: 1.25rem 2.2rem;
    padding-block: clamp(1.4rem, 3vw, 2.5rem) var(--journey-spacing);
    border-block-start: 1px solid var(--journey-rule);
  }
  .resource-reading__article { min-inline-size: 0; }
  .resource-reading__article p { max-inline-size: 66ch; }
  .resource-reading__article section { padding-block-start: 1.35rem; }
  .resource-reading h2 { margin-block-end: .45rem; font-size: clamp(1.5rem, 2.6vw, 2.5rem); color: var(--pine-dark); }
  .resource-reading blockquote { border-inline-start: 2px solid #a07547; padding-inline-start: 1rem; margin: 1.3rem 0; font: 1.3rem/1.3 var(--font-display); }
  .resource-reading__care { font-size: .93rem; color: var(--muted); }
  @media (max-width: 690px) {
    .resource-reading { grid-template-columns: minmax(0,1fr); }
  }
</style>
