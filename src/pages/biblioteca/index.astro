---
import EditorialPhoto from '../../components/EditorialPhoto.astro';
import ResourceList from '../../components/ResourceList.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadResources } from '../../lib/content';
import { mediaUrl } from '../../lib/media';
import { path } from '../../lib/paths';

const resources = await loadResources();
const featured = resources.find(resource => resource.slug === 'pausa-de-presencia') || resources[0];
const image = featured && { src: mediaUrl(featured.image), alt: featured.imageAlt || featured.title };
---
<SiteLayout title="Biblioteca abierta" openJourney>
  <section class:list={['container', 'journey-hero', { 'journey-hero--photo': image?.src }]}>
    <div class="journey-hero__copy">
      <span class="eyebrow">Biblioteca abierta</span>
      <h1>Una Biblioteca para tu camino.</h1>
      <p class="journey-lead">Prácticas sencillas, lecturas y preguntas para explorar a tu ritmo. Podés empezar gratuitamente y sin registro.</p>
      {featured && (
        <div class="journey-actions">
          <a class="btn" href={path('/biblioteca/' + featured.slug + '/')}>Leer «{featured.title}» <span aria-hidden="true">↗</span></a>
        </div>
      )}
    </div>
    <EditorialPhoto image={image} priority />
  </section>
  {resources.length > 0 && (
    <section class="container library-list">
      <h2>Prácticas para empezar</h2>
      <ResourceList resources={resources} />
    </section>
  )}
  <section class="journey-band">
    <div class="container journey-band__one library-end">
      <h2>Un primer paso es suficiente.</h2>
      <p>Adaptá cada práctica a tu situación, escuchá tus límites y elegí a tu propio ritmo.</p>
    </div>
  </section>
</SiteLayout>

<style>
  .library-list { padding-block-end: var(--journey-spacing); }
  .library-list h2 { color: var(--pine-dark); font-size: clamp(1.9rem, 3vw, 3rem); }
  .library-end { text-align: center; }
  .library-end h2 { font-size: clamp(1.9rem, 3.5vw, 3.4rem); margin-block-end: .65rem; }
</style>
