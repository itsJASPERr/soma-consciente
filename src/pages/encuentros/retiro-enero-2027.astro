---
import OfferingAction from '../../components/OfferingAction.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadAulas } from '../../lib/content';
import { loadHomepage } from '../../lib/home';
import { mediaUrl } from '../../lib/media';
import { offerings } from '../../lib/offerings';
import { path } from '../../lib/paths';

const home = await loadHomepage();
const aulas = await loadAulas();
const nico = aulas.find((aula) => aula.slug === 'nico');
const encounter = offerings.find((offer) => offer.slug === 'encuentro-enero');
const requestsEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';

const horses = mediaUrl(nico?.coverImage);
const morning = mediaUrl(home.heroImage);
const hills = mediaUrl(home.nucleoImage);
const circle = mediaUrl(home.onlineImage);

const saturday = [
  { time: '09:00', text: 'Llegada, caminata y movimiento con Nicky.' },
  { time: 'Por la mañana', text: 'Charla y práctica de respiración con Yani.' },
  { time: '13:30', text: 'Almuerzo liviano.' },
  { time: '16:00 a 19:00', text: 'Baño de sonido y vivencia con caballos, en Casa Sabia.' },
  { time: '20:00', text: 'Merienda.' },
  { time: '22:30', text: 'Cena al disco y fogón. Risotto de hongos y verduras.' },
  { time: 'Después de cenar', text: 'Guitarra con Pedro, baile y peña.' },
];

const sunday = [
  { time: '08:00', text: 'Desayuno.' },
  { time: '09:30', text: 'Salida al campo.' },
  { time: '10:30', text: 'Actividad con caballos en el corral.' },
  { time: '13:30', text: 'Almuerzo junto al arroyo.' },
  { time: 'Después de almorzar', text: 'Círculo de palabra.' },
  { time: '19:00', text: 'Merienda libre y cierre.' },
];

const payments = [
  { label: 'Un pago', amount: '$610.000', note: 'El total del retiro.' },
  { label: '2 cuotas', amount: '$330.000', note: 'Total $660.000.' },
  { label: '3 cuotas', amount: '$230.000', note: 'Total $690.000.' },
  { label: '4 cuotas', amount: '$185.000', note: 'Total $740.000.' },
];
---
<SiteLayout
  title="Retiro de enero en Casa Sabia"
  description="Retiro SOMA Consciente, sábado 23 y domingo 24 de enero de 2027 en Casa Sabia, La Falda. El precio incluye los dos días y cuatro encuentros grupales de integración online."
  openJourney
>
  <article class="retreat">
    <header class="retreat-cover">
      <p class="eyebrow">Retiro presencial</p>
      <h1>Cuerpo, respiración <em>y naturaleza</em></h1>
      <p class="retreat-cover__date">23 y 24 de enero de 2027</p>
      <p class="retreat-cover__place">Casa Sabia · La Falda, Córdoba</p>
      {horses && (
        <img
          class="retreat-cover__photo"
          src={horses}
          alt={nico?.coverAlt || 'Encuentro con un caballo'}
          width="1200"
          height="800"
        />
      )}
      <a class="retreat-cover__more" href="#sabado">
        <span>Deslizá para ver el cronograma</span>
        <span aria-hidden="true">→</span>
      </a>
    </header>

    <section class="retreat-day" aria-labelledby="sabado-title">
      <p class="eyebrow">Cronograma</p>
      <h2 id="sabado-title">Sábado 23</h2>
      <p class="retreat-day__meta">Enero 2027 · Casa Sabia</p>
      {morning && <img class="retreat-day__photo" src={morning} alt="Luz de amanecer sobre las montañas" width="1600" height="1000" />}
      <ol class="timeline">
        {saturday.map((item) => (
          <li>
            <time>{item.time}</time>
            <span class="timeline__dot" aria-hidden="true"></span>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="retreat-day" aria-labelledby="domingo-title">
      <p class="eyebrow">Cronograma</p>
      <h2 id="domingo-title">Domingo 24</h2>
      <p class="retreat-day__meta">Enero 2027 · Casa Sabia</p>
      {hills && <img class="retreat-day__photo" src={hills} alt="Montañas y bosques entre la bruma" width="1100" height="733" />}
      <ol class="timeline">
        {sunday.map((item) => (
          <li>
            <time>{item.time}</time>
            <span class="timeline__dot" aria-hidden="true"></span>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="retreat-after" aria-labelledby="integracion-title">
      <p class="eyebrow">Integración</p>
      <p class="retreat-after__kicker">Después del fin de semana</p>
      <h2 id="integracion-title">La experiencia <em>sigue.</em></h2>
      <div class="retreat-after__row">
        <div>
          <p class="retreat-after__count">4</p>
          <p class="retreat-after__label">encuentros grupales de integración online</p>
          <p>Para compartir lo vivido y llevarlo a lo cotidiano.</p>
          <p class="retreat-after__included">Incluidos en el retiro</p>
        </div>
        {circle && <img src={circle} alt="Cuaderno sobre una mesa, para lo que queda del encuentro" width="1600" height="1000" />}
      </div>
    </section>

    <section class="retreat-price" aria-labelledby="precio-title">
      <h2 id="precio-title">Inversión</h2>
      <ul>
        {payments.map((payment) => (
          <li>
            <span>{payment.label}</span>
            <strong>{payment.amount}</strong>
            <small>{payment.note}</small>
          </li>
        ))}
      </ul>
      <p>El primer pago reserva el lugar. El resto es mensual y tiene que estar pago antes del retiro. El precio incluye los dos días y cuatro encuentros grupales de integración online.</p>
    </section>

    <section class="retreat-close">
      <h2>Nos vemos <em>en La Falda.</em></h2>
      <p class="retreat-cover__date">23 y 24 de enero de 2027</p>
      <p class="retreat-cover__place">Casa Sabia · La Falda, Córdoba</p>
      <p class="retreat-close__ask">Consultá por tu lugar.</p>
      {encounter && (
        <div class="retreat-close__action">
          <OfferingAction offer={encounter} requestsEnabled={requestsEnabled} showArrow />
          <a class="journey-link" href={path('/acompanamiento/#circulos')}>Conocer los círculos <span aria-hidden="true">↗</span></a>
        </div>
      )}
    </section>
  </article>
</SiteLayout>

<style>
  .retreat {
    width: min(40rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(1.6rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .retreat-cover h1,
  .retreat-day h2,
  .retreat-after h2,
  .retreat-close h2,
  .retreat-price h2 {
    margin: 0;
    color: var(--pine-dark);
    font-weight: 400;
  }
  .retreat-cover h1 {
    max-inline-size: 11ch;
    font-size: clamp(2.8rem, 7vw, 4.4rem);
    line-height: 0.95;
  }
  .retreat em {
    font-style: italic;
    color: var(--terra);
  }
  .retreat-cover__date {
    margin: 1rem 0 0;
    color: var(--pine-dark);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .retreat-cover__place {
    margin: .25rem 0 0;
    color: #4d564a;
  }
  .retreat-cover__photo {
    display: block;
    width: min(86%, 26rem);
    aspect-ratio: 1.55;
    margin: 1.6rem auto -2rem;
    object-fit: cover;
    border-radius: 50%;
    position: relative;
    z-index: 1;
  }
  .retreat-cover__more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 3.3rem 1.4rem 1.15rem;
    border-radius: 0 0 7rem 7rem;
    background: #2f4a3f;
    color: #f6f1e7;
    font-weight: 700;
    text-decoration: none;
  }
  .retreat-day { padding-top: clamp(2.4rem, 6vw, 3.6rem); }
  .retreat-day h2 { font-size: clamp(2.4rem, 6vw, 3.6rem); }
  .retreat-day__meta {
    margin: .35rem 0 0;
    color: #6a6258;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .retreat-day__photo {
    display: block;
    width: 100%;
    aspect-ratio: 2.1;
    margin-top: 1.1rem;
    object-fit: cover;
    border-radius: 1.4rem;
  }
  .timeline {
    --time: 8.4rem;
    position: relative;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: .45rem;
    bottom: .45rem;
    left: calc(var(--time) + .7rem + .35rem);
    width: 1px;
    background: #e4d3c4;
    transform: translateX(-50%);
  }
  .timeline li {
    display: grid;
    grid-template-columns: var(--time) .7rem minmax(0, 1fr);
    gap: .7rem;
    align-items: start;
    padding-bottom: 1.15rem;
  }
  .timeline time {
    color: var(--terra);
    font-size: .86rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: right;
    white-space: nowrap;
  }
  .timeline__dot {
    width: .55rem;
    height: .55rem;
    margin-top: .28rem;
    border-radius: 50%;
    background: var(--terra);
    justify-self: center;
    position: relative;
    z-index: 1;
  }
  .timeline p { margin: 0; line-height: 1.35; }
  .retreat-after { padding-top: clamp(2.6rem, 6vw, 4rem); }
  .retreat-after__kicker {
    margin: .8rem 0 .2rem;
    color: #6a6258;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .retreat-after h2 { font-size: clamp(2.3rem, 5vw, 3.3rem); }
  .retreat-after__row {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
  }
  .retreat-after__count {
    margin: 0;
    color: var(--pine-dark);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 6.5rem);
    line-height: .85;
  }
  .retreat-after__label {
    margin: .2rem 0 .6rem;
    color: var(--pine-dark);
    font-weight: 700;
  }
  .retreat-after p { margin: 0; }
  .retreat-after__included {
    display: inline-block;
    margin-top: .9rem;
    padding: .35rem .7rem;
    border-radius: 999px;
    background: #efe4d2;
    color: var(--pine-dark);
    font-size: .82rem;
    font-weight: 700;
  }
  .retreat-after img {
    width: 100%;
    aspect-ratio: .82;
    object-fit: cover;
    border-radius: 50% 50% 42% 42%;
  }
  .retreat-price {
    margin-top: clamp(2.2rem, 5vw, 3.2rem);
    padding: 1.4rem 1.2rem 1.3rem;
    border-radius: 1.4rem;
    background: #2f4a3f;
    color: #f6f1e7;
  }
  .retreat-price h2 { color: #f6f1e7; font-size: clamp(2rem, 4vw, 2.8rem); }
  .retreat-price ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .9rem 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .retreat-price li { min-width: 0; }
  .retreat-price span {
    display: block;
    color: #c9a96b;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .retreat-price strong {
    display: block;
    margin-top: .15rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 400;
  }
  .retreat-price small { color: #f6f1e7; }
  .retreat-price p { margin: 1rem 0 0; max-inline-size: 46ch; line-height: 1.45; }
  .retreat-close { padding-top: clamp(2.4rem, 6vw, 3.6rem); }
  .retreat-close h2 { font-size: clamp(2.4rem, 6vw, 3.5rem); }
  .retreat-close__ask {
    margin: 1.2rem 0 .8rem;
    color: var(--pine-dark);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }
  .retreat-close__action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .8rem 1.1rem;
  }
  @media (max-width: 640px) {
    .timeline { --time: 7.2rem; }
    .timeline time { white-space: normal; }
    .retreat-after__row,
    .retreat-price ul { grid-template-columns: 1fr; }
    .retreat-after img { max-height: 16rem; aspect-ratio: 1.4; border-radius: 1.6rem; }
  }
</style>
