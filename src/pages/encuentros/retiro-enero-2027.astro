---
import OfferingAction from '../../components/OfferingAction.astro';
import SignupDialog from '../../components/SignupDialog.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { offeringUrl, offerings } from '../../lib/offerings';
import { path } from '../../lib/paths';

const encounter = offerings.find((offer) => offer.slug === 'encuentro-enero');
const registrationUrl = encounter ? offeringUrl(encounter) : undefined;
const analyticsEnabled = import.meta.env.PROD && import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true';
const whatsappEvent = analyticsEnabled && registrationUrl && new URL(registrationUrl, Astro.site).hostname === 'wa.me'
  ? 'retreat_whatsapp_clicked'
  : undefined;
const requestsEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const canRegister = encounter && (registrationUrl || requestsEnabled);
const date = encounter?.when || '23 y 24 de enero de 2027';
const venue = encounter?.venue || 'Casa Sabia · La Falda, Córdoba';

type ScheduleEntry = {
  text: string;
} & ({ time: string; end?: string } | { label: string });

const days: {
  id: string;
  title: string;
  photo: string;
  alt: string;
  schedule: ScheduleEntry[];
}[] = [
  {
    id: 'sabado',
    title: 'Sábado 23',
    photo: 'caminata-en-el-campo',
    alt: 'Un grupo reunido a la sombra de los árboles al borde del campo',
    schedule: [
      { time: '09:00', text: 'Llegada, caminata y movimiento con Nicky.' },
      { label: 'Por la mañana', text: 'Charla y práctica de respiración con Yani.' },
      { time: '13:30', text: 'Almuerzo liviano.' },
      { time: '16:00', end: '19:00', text: 'Baño de sonido y vivencia con caballos en Casa Sabia.' },
      { time: '20:00', text: 'Merienda.' },
      { time: '22:30', text: 'Cena al disco y fogón. Opción de risotto de hongos y verduras.' },
      { label: 'Después de cenar', text: 'Guitarra con Pedro, baile y peña.' },
    ],
  },
  {
    id: 'domingo',
    title: 'Domingo 24',
    photo: 'encuentro-con-caballos',
    alt: 'Personas y caballos reunidos en un claro junto al bosque',
    schedule: [
      { time: '08:00', text: 'Desayuno.' },
      { time: '09:30', text: 'Salida al campo.' },
      { time: '10:30', text: 'Actividad con caballos en el corral.' },
      { time: '13:30', text: 'Almuerzo junto al arroyo.' },
      { label: 'Después de almorzar', text: 'Círculo de palabra.' },
      { time: '19:00', text: 'Merienda libre y cierre.' },
    ],
  },
];

const registrationSteps = [
  'Escribile a Yanina para consultar disponibilidad.',
  'Elegí cómo pagar y mencioná si venís con alguien o con tu carpa.',
  'Coordiná el pago con Yanina y confirmá tu lugar con ella.',
];
---
<SiteLayout
  title="Retiro SOMA · Cuerpo, respiración y naturaleza"
  description={'Retiro SOMA Consciente, ' + date + ' en ' + venue + '. Dos días de prácticas y cuatro encuentros grupales de integración online.'}
  openJourney
  journeyAction={canRegister ? { label: 'Consultar por un lugar', href: '#participar' } : undefined}
>
  <article class="retreat">
    <header class="retreat-hero">
      <div class="retreat-inner retreat-hero__layout">
        <div class="retreat-hero__copy">
          <p class="retreat-label">Retiro presencial</p>
          <h1>Cuerpo, respiración <em>y naturaleza</em></h1>
          <p class="retreat-hero__date">{date}</p>
          <p class="retreat-hero__place">{venue}</p>
          <p class="retreat-hero__intro">Dos días para bajar el ritmo, mover el cuerpo y estar en la naturaleza.</p>
          <div class="retreat-actions">
            {canRegister && <a class="btn retreat-button" href="#participar">Consultar por un lugar <span aria-hidden="true">↗</span></a>}
            <a
              class="retreat-link"
              href="#cronograma"
              data-umami-event={analyticsEnabled ? 'retreat_schedule_clicked' : undefined}
            >Ver el cronograma <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <figure class="retreat-hero__image">
          <img
            src={path('/media/retreat/caballos-en-el-bosque.webp')}
            alt="Una persona sentada cerca de varios caballos en un claro del bosque"
            width="1280"
            height="718"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </header>

    <section id="cronograma" class="retreat-schedule" aria-labelledby="cronograma-title">
      <div class="retreat-inner">
        <div class="retreat-section-head">
          <p class="retreat-label">Cronograma</p>
          <h2 id="cronograma-title">Dos días en Casa Sabia</h2>
        </div>
        <div class="retreat-days">
          {days.map((day) => (
            <section id={day.id} class="retreat-day" aria-labelledby={day.id + '-title'}>
              <h3 id={day.id + '-title'}>{day.title}</h3>
              <img
                class="retreat-day__photo"
                src={path('/media/retreat/' + day.photo + '.webp')}
                alt={day.alt}
                width="840"
                height="471"
                loading="lazy"
                decoding="async"
              />
              <ol class="retreat-timeline" role="list">
                {day.schedule.map((item) => (
                  <li>
                    <span class="retreat-timeline__when">
                      {'time' in item ? (
                        <>
                          <time datetime={item.time}>{item.time}</time>
                          {item.end && <> a <time datetime={item.end}>{item.end}</time></>}
                        </>
                      ) : item.label}
                    </span>
                    <p>{item.text}</p>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="retreat-integration" aria-labelledby="integracion-title">
      <div class="retreat-inner retreat-integration__layout">
        <div class="retreat-integration__copy">
          <p class="retreat-label">Después del fin de semana</p>
          <h2 id="integracion-title">La experiencia <em>sigue.</em></h2>
          <p class="retreat-integration__count"><strong>4</strong> encuentros grupales de integración online</p>
          <p>Están incluidos en el retiro. Nos volvemos a encontrar para compartir lo vivido y llevarlo a lo cotidiano.</p>
          <a class="retreat-link" href={path('/acompanamiento/#circulos')}>Conocer los círculos <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="retreat-integration__image">
          <img
            src={path('/media/retreat/circulo-entre-arboles.webp')}
            alt="Un grupo sentado en círculo entre los árboles"
            width="471"
            height="840"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section id="inversion" class="retreat-pricing" aria-labelledby="inversion-title">
      <div class="retreat-inner retreat-pricing__layout">
        <div class="retreat-price">
          <h2 id="inversion-title">Inversión</h2>
          <p>Incluye los dos días y los cuatro encuentros de integración online.</p>
          <dl class="retreat-price__options" data-retreat-pricing={analyticsEnabled ? '' : undefined}>
            <div>
              <dt>Pago contado</dt>
              <dd><strong>ARS 450.000</strong></dd>
            </div>
            <div>
              <dt>Pago en cuotas</dt>
              <dd>
                <strong>2 × ARS 250.000</strong>
                <span>Total ARS 500.000</span>
              </dd>
            </div>
          </dl>
        </div>
        <div class="retreat-discounts">
          <h3 class="retreat-label">Descuentos</h3>
          <dl>
            <div>
              <dt>10%</dt>
              <dd>Si venís con un amigo o una amiga.</dd>
            </div>
            <div>
              <dt>ARS 50.000</dt>
              <dd>Si venís con tu carpa.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    {canRegister && encounter && (
      <section id="participar" class="retreat-join" aria-labelledby="participar-title">
        <div class="retreat-inner retreat-join__layout">
          <div class="retreat-join__copy">
            <p class="retreat-label">Inscripción</p>
            <h2 id="participar-title">Cómo participar</h2>
            <ol class="retreat-steps" role="list">
              {registrationSteps.map((step, index) => (
                <li>
                  <span aria-hidden="true">{index + 1}</span>
                  <p>{step}</p>
                </li>
              ))}
            </ol>
            <OfferingAction
              offer={encounter}
              requestsEnabled={requestsEnabled}
              class="btn retreat-button"
              analyticsEvent={whatsappEvent}
              showArrow
            />
            {!registrationUrl && <SignupDialog />}
          </div>
          <figure class="retreat-join__image">
            <img
              src={path('/media/retreat/caballos-y-grupo.webp')}
              alt="Dos personas de pie frente a varios caballos en el campo"
              width="404"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>
    )}
  </article>
</SiteLayout>

<script>
  const pricing = import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true'
    ? document.querySelector('[data-retreat-pricing]')
    : null;

  if (pricing) {
    const observePricing = () => {
      const { umami } = window as Window & {
        umami?: { track(event: 'retreat_pricing_viewed'): unknown };
      };
      if (!umami || typeof IntersectionObserver === 'undefined') return;

      const observer = new IntersectionObserver(async ([entry]) => {
        if (!entry || entry.intersectionRatio < 0.5) return;
        observer.disconnect();
        try {
          await umami.track('retreat_pricing_viewed');
        } catch {
          // The page remains usable if analytics is unavailable.
        }
      }, { threshold: 0.5 });
      observer.observe(pricing);
    };

    // Wait for the deferred Umami script before checking for the tracker.
    if (document.readyState === 'complete') observePricing();
    else window.addEventListener('load', observePricing, { once: true });
  }
</script>

<style>
  .retreat {
    --retreat-paper: #f6f1e7;
    --retreat-sand: #efe4cf;
    --retreat-card: #fcf8ef;
    --retreat-pine: #203b31;
    --retreat-ink: #263a31;
    --retreat-clay: #944a36;
    --retreat-muted: #425950;
    --retreat-line: #d9c7a9;
    --retreat-gold: #e7c488;
    background: var(--retreat-paper);
    color: var(--retreat-ink);
  }
  .retreat :is(h1, h2, h3, p, figure, ol, dl, dt, dd) { margin: 0; }
  .retreat :is(h1, h2, h3) { color: var(--retreat-pine); }
  .retreat h1 { font-size: clamp(2.65rem, 4.7vw, 4rem); line-height: .98; }
  .retreat h2 { font-size: clamp(2rem, 4.5vw, 3.9rem); line-height: 1.01; }
  .retreat h3 { font-size: clamp(1.8rem, 3.5vw, 2.75rem); line-height: 1.04; }
  .retreat em { color: var(--retreat-clay); }
  .retreat section[id] { scroll-margin-block-start: 6.5rem; }
  .retreat-inner {
    width: min(1140px, calc(100% - clamp(2rem, 7vw, 6rem)));
    margin-inline: auto;
  }
  .retreat p { line-height: 1.55; }
  .retreat .retreat-label {
    color: var(--retreat-clay);
    font: 700 .73rem/1.45 var(--font-body, sans-serif);
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .retreat-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(2.6rem, 7vw, 7rem) clamp(3.3rem, 8vw, 6.5rem);
    border-bottom: 1px solid var(--retreat-line);
  }
  .retreat-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -32% -12% auto auto;
    width: min(59vw, 64rem);
    height: 92%;
    background: var(--retreat-sand);
    border-radius: 20% 0 35% 65%;
    transform: rotate(15deg);
  }
  .retreat-hero__layout {
    display: grid;
    grid-template-columns: 1fr minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.65rem, 4vw, 4.5rem);
  }
  .retreat-hero__copy h1 { margin-top: .75rem; }
  .retreat-hero__copy h1 em { display: block; }
  .retreat-hero__copy .retreat-hero__date {
    margin-top: clamp(1.15rem, 2.7vw, 1.65rem);
    font-size: clamp(1.06rem, 1.9vw, 1.38rem);
    font-weight: 700;
  }
  .retreat-hero__copy .retreat-hero__place { color: var(--retreat-muted); }
  .retreat-hero__copy .retreat-hero__intro {
    max-inline-size: 32ch;
    margin-top: .8rem;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
  }
  .retreat-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .45rem 1.1rem;
    margin-top: 1.25rem;
  }
  .retreat :global(.retreat-button) {
    min-block-size: 44px;
    gap: .65rem;
    background: var(--retreat-pine);
  }
  .retreat :global(.retreat-button:hover) { background: #152d24; }
  .retreat-link {
    display: inline-flex;
    align-items: center;
    gap: .45em;
    min-block-size: 44px;
    color: var(--retreat-pine);
    font-size: .92rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .25em;
  }
  .retreat a:focus-visible, .retreat button:focus-visible {
    outline: 2px solid var(--retreat-clay);
    outline-offset: 4px;
  }
  .retreat-hero__image,
  .retreat-integration__image,
  .retreat-join__image { position: relative; isolation: isolate; }
  .retreat-hero__image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.56;
    object-fit: cover;
    border-radius: 56% 40% 42% 46% / 59% 50% 49% 43%;
  }
  .retreat-hero__image::before,
  .retreat-hero__image::after {
    content: "";
    position: absolute;
    pointer-events: none;
    z-index: -1;
    inset: .25rem .2rem -.75rem -.65rem;
    border: 1px solid #aa8852;
    border-radius: 56% 40% 42% 46% / 59% 50% 49% 43%;
  }
  .retreat-hero__image::after {
    inset: .7rem -.65rem -.42rem .25rem;
    border-color: #b8836a;
    transform: rotate(3deg);
  }
  .retreat-schedule {
    padding-block: clamp(2.9rem, 6vw, 5.25rem);
    background: linear-gradient(var(--retreat-paper), #f4ecde);
  }
  .retreat-section-head { margin-bottom: clamp(1.25rem, 3vw, 2.2rem); }
  .retreat-section-head h2, .retreat-integration h2, .retreat-join h2 { margin-top: .55rem; }
  .retreat-days {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.8vw, 2.1rem);
  }
  .retreat-day {
    min-inline-size: 0;
    padding: clamp(1.05rem, 3vw, 2rem);
    background: var(--retreat-card);
    border: 1px solid var(--retreat-line);
    border-radius: 1.35rem;
  }
  .retreat-day__photo {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 1rem 1.2rem;
    aspect-ratio: 3.25;
    object-fit: cover;
    object-position: center 49%;
    border-radius: 27% 9% 27% 12% / 62% 27% 59% 36%;
  }
  #domingo .retreat-day__photo { object-position: center 42%; }
  .retreat-timeline { list-style: none; padding: 0; }
  .retreat-timeline li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 6.5rem) minmax(0, 1fr);
    column-gap: .85rem;
    min-block-size: 2.8rem;
    padding: 0 0 .8rem .8rem;
    border-left: 1px solid var(--retreat-line);
  }
  .retreat-timeline li:last-child {
    min-block-size: 0;
    border-color: transparent;
    padding-bottom: 0;
  }
  .retreat-timeline li::before {
    content: "";
    position: absolute;
    top: .43rem;
    left: -.23rem;
    width: .4rem;
    height: .4rem;
    background: var(--retreat-clay);
    border-radius: 50%;
  }
  .retreat-timeline__when {
    color: var(--retreat-clay);
    font-size: .82rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .retreat-timeline p { font-size: .94rem; line-height: 1.42; }
  .retreat-integration {
    padding-block: clamp(2.65rem, 5.2vw, 4.4rem);
    background: var(--retreat-sand);
    border-block: 1px solid var(--retreat-line);
  }
  .retreat-integration__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    gap: clamp(1.4rem, 6vw, 5rem);
    align-items: center;
  }
  .retreat-integration__copy > p:not(.retreat-label) { max-inline-size: 39ch; }
  .retreat-integration__copy .retreat-integration__count {
    display: flex;
    align-items: center;
    gap: .7em;
    max-inline-size: 20em;
    margin-block: .7rem .55rem;
    color: var(--retreat-pine);
    font-size: clamp(1.08rem, 2vw, 1.36rem);
    font-weight: 700;
    line-height: 1.23;
  }
  .retreat-integration__count strong {
    color: var(--retreat-clay);
    font: 400 clamp(3.1rem, 7vw, 5.1rem)/1 var(--font-display);
  }
  .retreat-integration__copy .retreat-link { margin-top: .45rem; }
  .retreat-integration__image { width: min(100%, 18rem); justify-self: center; }
  .retreat-integration__image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: .87;
    object-fit: cover;
    object-position: center 62%;
    border-radius: 47% 54% 43% 46% / 56% 45% 55% 45%;
  }
  .retreat-integration__image::before,
  .retreat-join__image::before {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
    inset: .2rem -.55rem -.45rem .3rem;
    border: 1px solid #aa8852;
    border-radius: 49% 50% 44% 46% / 56% 45% 55% 45%;
  }
  .retreat-pricing { padding-block: clamp(2.75rem, 6vw, 5.25rem) 0; }
  .retreat-pricing__layout {
    overflow: clip;
    border: 1px solid var(--retreat-line);
    border-radius: 1.55rem;
    background: var(--retreat-sand);
  }
  .retreat-price {
    position: relative;
    isolation: isolate;
    padding: clamp(1.25rem, 4.2vw, 3.15rem);
    background: var(--retreat-pine);
    color: var(--retreat-paper);
  }
  .retreat-price::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -15% -5% auto auto;
    width: min(26vw, 18rem);
    height: 140%;
    border: 1px solid #a18a5d;
    border-radius: 50%;
    transform: rotate(-25deg);
    opacity: .65;
  }
  .retreat-price h2 { color: inherit; }
  .retreat-price > p { margin-top: .65rem; }
  .retreat-price__options,
  .retreat-discounts dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: .9rem 1.25rem;
  }
  .retreat-price .retreat-price__options { margin-top: 1.45rem; }
  .retreat-price__options dt {
    color: var(--retreat-gold);
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .retreat-price__options dd { margin-top: .2rem; }
  .retreat-price__options strong,
  .retreat-discounts dt {
    display: block;
    font: 400 clamp(1.55rem, 4vw, 3.3rem)/1.15 var(--font-display);
  }
  .retreat-price__options span { display: block; margin-top: .2rem; font-size: .92rem; }
  .retreat-discounts { padding: clamp(1.15rem, 3vw, 2rem) clamp(1.25rem, 4.2vw, 3.15rem); }
  .retreat-discounts dl { margin-top: .5rem; }
  .retreat-discounts dt { color: var(--retreat-clay); font-size: clamp(1.45rem, 3.2vw, 2.5rem); }
  .retreat-discounts dd { margin-top: .25rem; line-height: 1.4; }
  .retreat-join { padding-block: clamp(2.8rem, 6vw, 5rem); }
  .retreat-join__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .75fr);
    gap: clamp(1.4rem, 5vw, 3.5rem);
    align-items: center;
  }
  .retreat-join__copy .retreat-steps {
    display: grid;
    gap: .65rem;
    margin-block: 1.1rem 1.25rem;
    padding: 0;
    list-style: none;
  }
  .retreat-steps li {
    display: grid;
    grid-template-columns: 1.62rem 1fr;
    align-items: start;
    gap: .65rem;
  }
  .retreat-steps span {
    display: grid;
    place-items: center;
    width: 1.62rem;
    aspect-ratio: 1;
    margin-top: .03rem;
    border-radius: 50%;
    background: var(--retreat-pine);
    color: var(--retreat-paper);
    font-size: .82rem;
    font-weight: 700;
  }
  .retreat-join__copy :global(.offering-action-hint) {
    max-inline-size: 37ch;
    margin-top: .55rem;
  }
  .retreat-join__image { width: min(100%, 18rem); justify-self: center; }
  .retreat-join__image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.1;
    object-fit: cover;
    object-position: center 55%;
    border-radius: 55% 43% 48% 40% / 55% 51% 48% 42%;
  }

  @media (max-width: 51rem) {
    .retreat-hero__layout,
    .retreat-days { grid-template-columns: 1fr; }
    .retreat-hero__image { width: min(100%, 34rem); justify-self: center; }
    .retreat-hero::before { width: 66vw; height: 63%; }
    .retreat-hero { padding-bottom: 2.65rem; }
  }
  @media (max-width: 32rem) {
    .retreat-integration__layout,
    .retreat-join__layout { grid-template-columns: 1fr; }
    .retreat-integration__image,
    .retreat-join__image { width: min(82%, 15.5rem); }
    .retreat-price__options { grid-template-columns: 1fr; }
    .retreat-timeline li { grid-template-columns: minmax(0, 4.65rem) minmax(0, 1fr); gap: .55rem; }
    .retreat-timeline__when { font-size: .77rem; }
  }
</style>
