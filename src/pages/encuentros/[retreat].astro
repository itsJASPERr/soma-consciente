---
import type { GetStaticPaths } from 'astro';
import RetreatPage from '../../components/RetreatPage.astro';
import { retreatEditions } from '../../lib/offerings';

export const getStaticPaths = (() => retreatEditions.map(encounter => ({
  params: { retreat: encounter.pageSlug },
  props: { encounter },
}))) satisfies GetStaticPaths;

const { encounter } = Astro.props;
---
<RetreatPage encounter={encounter} />
