---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProgramWaitlist from '../components/ProgramWaitlist.astro';
import SomaAulaSymbol from '../components/SomaAulaSymbol.astro';
import SignupDialog from '../components/SignupDialog.astro';
import { loadAulas, loadResources } from '../lib/content';
import { loadHomepage } from '../lib/home';
import { mediaUrl } from '../lib/media';
import { retreatCta } from '../lib/analytics';
import { offerings } from '../lib/offerings';
import { path } from '../lib/paths';

const aulas = await loadAulas();
const themes = ['nicole', 'jasper', 'yanina', 'nico']
  .map(slug => aulas.find(aula => aula.slug === slug))
  .filter(aula => aula !== undefined);
const resources = await loadResources();
const meditation = resources.find(resource => resource.slug === 'primeros-pasos-meditacion');
const featuredResource = meditation ?? resources[0];
const featuredPhoto = meditation
  ? { src: path('/media/photography/pausa-de-presencia.jpg'), alt: 'Luz del sol entre hojas verdes' }
  : { src: mediaUrl(featuredResource?.image), alt: featuredResource?.imageAlt || featuredResource?.title };
const remainingResources = resources.filter(resource => resource !== featuredResource);
const resourcePath = (slug: string) => path('/biblioteca/' + slug + '/');
const home = await loadHomepage();
const sunrise = mediaUrl(home.heroImage);
const landscape = mediaUrl(home.nucleoImage);
const heroPhoto = sunrise
  ? { src: sunrise, alt: home.heroAlt, position: home.heroPosition || 'center' }
  : { src: mediaUrl(home.encountersImage), alt: home.encountersAlt, position: 'center' };
const signupEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const nucleusStatements = [
  'Prácticas y herramientas compartidas',
  'Prácticas interdisciplinarias',
  'Acompañamiento e integración',
  'Encuentros y experiencias',
];
const retreatPath = path('/encuentros/retiro-enero-2027/');
const retreat = offerings.find(offer => offer.slug === 'encuentro-enero');
const door = offerings.find(offer => offer.slug === 'puerta-abierta');
const retreatDates = retreat && 'dates' in retreat && retreat.dates?.length ? retreat.dates : [];
const calendar = [
  ...(retreat ? (retreatDates.length ? retreatDates : [{ when: retreat.when, venue: retreat.venue }]).map((date, index) => ({
    title: retreat.title,
    when: date.when,
    venue: date.venue,
    href: index === 0 ? retreatPath : path('/encuentros/#' + retreat.slug + '-' + (index + 1)),
  })) : []),
  ...(door ? [{
    title: door.title,
    when: door.when,
    venue: [door.venue, door.details].filter(Boolean).join(' · '),
    href: path('/encuentros/#puerta-abierta'),
  }] : []),
];
---
<SiteLayout openJourney description="La consciencia se vive. Somos cuatro miradas unidas por un propósito: vivir cada día con más presencia, disfrute y conexión.">
  <section class="home-hero" aria-labelledby="participation-heading">
    {heroPhoto.src && (
      <img
        class="home-hero__photo"
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        style={`object-position: ${heroPhoto.position}`}
        width="1600"
        height="1000"
        fetchpriority="high"
        decoding="async"
      />
    )}
    <div class="home-hero__copy">
      <h1 id="participation-heading">La consciencia<br /> se vive.</h1>
      <p>Somos cuatro miradas unidas por un propósito: vivir cada día con más presencia, disfrute y conexión.</p>
      {calendar.length > 0 && (
        <a class="home-hero__dates" href="#proximos-encuentros">Ver próximas fechas <span aria-hidden="true">↓</span></a>
      )}
    </div>
  </section>

  <ul class="home-values" aria-label="Nuestros valores" role="list">
    <li>Presencia</li><li>Integración</li><li>Autonomía</li><li>Respeto</li><li>Comunidad</li>
  </ul>

  <section class="program-section" id="metodologia" aria-labelledby="metodologia-title">
    {signupEnabled && landscape && <img class="program-overlay-art" src={landscape} alt="" width="1100" height="780" loading="lazy" decoding="async" />}
    <div class="container program-preview">
      <p class="eyebrow">Un camino integrado</p>
      <h2 id="metodologia-title">Cuatro miradas, un núcleo</h2>
      <p class="program-preview__intro">Donde las distintas miradas se encuentran hay un espacio para cocrear propuestas que conectan cuerpo, emoción, consciencia y naturaleza sin perder la singularidad de cada disciplina. Compartimos desde el lugar de nuestra propia práctica.</p>
      <div class="program-preview__composition">
        <div class="program-preview__shape">
          <div class="program-preview__window">
            {landscape && <img class="program-preview__landscape" src={landscape} alt="" loading="lazy" decoding="async" />}
          </div>
          <div class="program-preview__emblem">
            <img src={path('/media/soma-original-emblem.png')} alt="Emblema original de SOMA CONSCIENTE" width="520" height="405" loading="lazy" decoding="async" />
          </div>
        </div>
        <ul class="program-preview__themes" role="list" aria-label="Perspectivas de nuestra metodología">
          {themes.map(({ slug, name, symbol }) => (
            <li class={`program-preview__theme--${slug}`}><span aria-hidden="true"><SomaAulaSymbol symbol={symbol} /></span>{name}</li>
          ))}
        </ul>
      </div>
      <ol class="nucleus-points">
        {nucleusStatements.map((statement, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{statement}</li>
        ))}
      </ol>
      <ProgramWaitlist signupEnabled={signupEnabled} />
    </div>
  </section>

  {calendar.length > 0 && (
    <section class="container home-calendar" aria-labelledby="proximos-encuentros">
      <div class="home-calendar__intro">
        <h2 id="proximos-encuentros">Próximos encuentros</h2>
        <p class="home-calendar__lead">Encuentros presenciales. Integración online.</p>
        <p>Reunimos las cuatro miradas en el encuentro presencial y las seguimos en los círculos de integración online.</p>
      </div>
      <ul class="home-calendar__list" role="list">
        {calendar.map((event) => {
          const featured = event.href === retreatPath;
          return (
            <li class:list={['home-calendar__event', { 'home-calendar__event--featured': featured }]}>
              {featured && (
                <img
                  class="home-calendar__photo"
                  src={path('/media/retreat/caballos-en-el-bosque.webp')}
                  alt="Una persona sentada frente a varios caballos en el bosque"
                  width="1280"
                  height="718"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="home-calendar__content">
                <div>
                  {event.when && <p class="home-calendar__date">{event.when}</p>}
                  <h3><a href={event.href} {...(featured ? retreatCta('details', 'home_calendar_title') : {})}>{event.title}</a></h3>
                  {event.venue && <p class="home-calendar__venue">{event.venue}</p>}
                </div>
                <a class={featured ? 'btn btn--rust' : 'journey-link'} href={event.href} {...(featured ? retreatCta('details', 'home_calendar_link') : {})}>{event.title === door?.title ? 'Ver el evento' : 'Ver el encuentro'} <span aria-hidden="true">↗</span></a>
              </div>
            </li>
          );
        })}
      </ul>
      <div class="home-base">
        <img src={path('/media/photography/casa-sabia.jpg')} alt="Casa de piedra con pileta y jardín en Casa Sabia, Huerta Grande" width="1126" height="718" loading="lazy" decoding="async" />
        <div class="home-base__content">
          <p class="eyebrow">Nuestra base</p>
          <h3>Casa Sabia</h3>
          <p><strong>Huerta Grande, Córdoba.</strong> Desde aquí salen los encuentros presenciales.</p>
        </div>
      </div>
    </section>
  )}
  {featuredResource && (
    <section class="container home-library" aria-labelledby="biblioteca-home-title">
      <div class="home-library__header">
        <div>
          <p class="eyebrow">Abierto para todos</p>
          <h2 id="biblioteca-home-title">Contenido para tu camino</h2>
          <p>Recursos gratuitos para empezar hoy. Explorá, practicá y elegí a tu propio ritmo.</p>
        </div>
        <a class="journey-link" href={path('/biblioteca/')}>Ir a la Biblioteca <span aria-hidden="true">↗</span></a>
      </div>
      <div class:list={['home-library__reading', { 'home-library__reading--split': remainingResources.length > 0 }]}>
        <article class="home-library__feature">
          {featuredPhoto.src && (
            <img src={featuredPhoto.src} alt={featuredPhoto.alt || ''} width="900" height="520" loading="lazy" decoding="async" />
          )}
          <p class="eyebrow">{featuredResource.category} · {featuredResource.duration}</p>
          <h3><a href={resourcePath(featuredResource.slug)}>{featuredResource.title} <span aria-hidden="true">↗</span></a></h3>
          <p>{featuredResource.summary}</p>
        </article>
        {remainingResources.length > 0 && (
          <ul class="home-library__list" aria-label="Más recursos de la biblioteca" role="list">
            {remainingResources.map(resource => (
              <li>
                <a href={resourcePath(resource.slug)}>
                  <div>
                    <h3>{resource.title}</h3>
                    <p>{resource.category} · {resource.duration}</p>
                  </div>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}
  {signupEnabled && <SignupDialog />}
</SiteLayout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-block-size: clamp(29rem, 70svh, 43rem);
    padding: clamp(4rem, 9vw, 7rem) 1.25rem;
    overflow: hidden;
    text-align: center;
    color: light-dark(#223d33, #fff1db);
    background: light-dark(#e8c9a8, #363d32);
  }
  .home-hero__photo {
    position: absolute;
    z-index: -2;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .home-hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 52%, light-dark(#fff3dbdf, transparent), light-dark(#fff0d796, transparent) 42%, transparent 77%),
      linear-gradient(light-dark(#eed8bc26, #18261c8a), light-dark(#eed8bc26, #18261cc4));
  }
  .home-hero__copy { max-inline-size: min(100%, 44rem); }
  .home-hero h1 {
    margin: 0;
    color: inherit;
    font-size: clamp(3rem, 7.8vw, 6.85rem);
    line-height: .96;
    text-wrap: balance;
  }
  .home-hero p {
    max-inline-size: 36ch;
    margin: clamp(.95rem, 2.2vw, 1.45rem) auto .55rem;
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    line-height: 1.55;
    text-wrap: balance;
  }
  .home-hero__dates {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    min-block-size: 44px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .28em;
  }
  .home-values {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: .6rem clamp(.9rem, 4.6vw, 3.15rem);
    margin: 0;
    padding: 1.1rem 6%;
    list-style: none;
    border-block-end: 1px solid var(--journey-rule);
    background: var(--cream);
    color: var(--pine-dark);
    font-size: .71rem;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
  }
  .program-section {
    padding-block-start: clamp(3.5rem, 8vw, 6.5rem);
    scroll-margin-top: 6.5rem;
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .program-overlay-art {
    position: absolute;
    z-index: -1;
    inset: 14% -6% auto auto;
    inline-size: min(63%, 51rem);
    block-size: 105%;
    object-fit: cover;
    border-radius: 54% 43% 41% 53% / 44% 44% 45% 47%;
    visibility: hidden;
  }
  :global(html:has(#program-launch-dialog[open][data-program-open])) .program-overlay-art { visibility: visible; opacity: .45; }
  .program-preview { text-align: center; }
  .program-preview .eyebrow { margin-bottom: .45rem; }
  .program-preview h2 {
    margin: 0 auto .85rem;
    color: var(--pine-dark);
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    text-wrap: balance;
  }
  .program-preview__intro {
    max-inline-size: 62ch;
    margin: 0 auto;
    text-wrap: pretty;
  }
  .program-preview__composition {
    position: relative;
    isolation: isolate;
    max-inline-size: 51rem;
    block-size: clamp(22rem, 55vw, 28.5rem);
    margin: clamp(.65rem, 2vw, 1.4rem) auto 1.2rem;
    background: radial-gradient(ellipse at 47% 53%, light-dark(#e7e9da, #465341) 0%, transparent 63%);
  }
  .program-preview__shape {
    --nucleus-shape: 57% 42% 50% 46% / 54% 38% 62% 45%;
    position: absolute;
    isolation: isolate;
    display: grid;
    place-items: center;
    inset: 50% auto auto 48%;
    inline-size: 59%;
    aspect-ratio: 1.42;
    transform: translate(-50%, -50%) rotate(-8deg);
  }
  .program-preview__shape::before,
  .program-preview__shape::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .program-preview__shape::before {
    inset: -5% -4% -5% -5%;
    border: 1px solid light-dark(#aa8b51, #bca06c);
    border-radius: 49% 45% 48% 44% / 56% 50% 55% 43%;
    transform: rotate(9deg);
  }
  .program-preview__shape::after {
    inset: 8% -7% -7% -4%;
    border: 1px solid light-dark(#869484, #a4b19b);
    border-radius: 46% 55% 45% 49% / 49% 39% 60% 47%;
    background: light-dark(#e6e5d3, #465342);
    transform: rotate(-9deg);
  }
  .program-preview__window {
    position: absolute;
    inset: 0;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--nucleus-shape);
    background: var(--surface-sand);
  }
  .program-preview__landscape {
    position: absolute;
    inset: 0;
    z-index: -1;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 54%;
    transform: rotate(8deg) scale(1.12);
  }
  .program-preview__emblem {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 45%;
    aspect-ratio: 1.27;
    border-radius: 57% 43% 49% 53% / 47% 58% 42% 53%;
    background: #faf3e0f5;
    transform: rotate(8deg);
  }
  .program-preview__emblem img {
    display: block;
    inline-size: 76%;
    block-size: auto;
    object-fit: contain;
  }
  .program-preview__themes {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .program-preview__themes li {
    position: absolute;
    inset: var(--theme-y) auto auto var(--theme-x);
    display: grid;
    justify-items: center;
    gap: .32rem;
    inline-size: 24%;
    max-inline-size: 9.15rem;
    color: var(--pine-dark);
    font-size: clamp(.78rem, 1.45vw, .94rem);
    font-weight: 700;
    line-height: 1.27;
    text-align: center;
    text-wrap: balance;
    transform: translate(-50%, -50%);
  }
  .program-preview__theme--nicole { --theme-x: 20%; --theme-y: 10%; --theme-tint: #e5eadc; }
  .program-preview__theme--jasper { --theme-x: 86%; --theme-y: 26%; --theme-tint: #f1dfd3; }
  .program-preview__theme--yanina { --theme-x: 79%; --theme-y: 87%; --theme-tint: #efe3d7; }
  .program-preview__theme--nico { --theme-x: 12%; --theme-y: 75%; --theme-tint: #f4e7cb; }
  .program-preview__themes li span {
    display: grid;
    place-items: center;
    inline-size: clamp(2rem, 5vw, 2.65rem);
    aspect-ratio: 1;
    padding: .18rem;
    border-radius: 53% 43% 51% 45%;
    background: var(--theme-tint);
  }
  .program-preview__themes li :global(img) { display: block; inline-size: 79%; block-size: auto; }
  .nucleus-points {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem clamp(.8rem, 2vw, 1.6rem);
    max-inline-size: 62rem;
    margin: clamp(1.2rem, 3vw, 2rem) auto 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }
  .nucleus-points li {
    min-inline-size: 0;
    color: var(--pine-dark);
    font-weight: 700;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .nucleus-points span {
    display: block;
    margin-bottom: .25rem;
    color: var(--journey-clay, var(--terra));
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
  }
  .home-calendar { padding-block-start: clamp(4rem, 9.5vw, 7rem); }
  .home-calendar__intro { margin-block-end: clamp(1.3rem, 3vw, 2rem); }
  .home-calendar__intro h2, .home-library h2 {
    margin: 0 0 .55rem;
    color: var(--pine-dark);
    font-size: clamp(2.25rem, 4.6vw, 4.15rem);
    text-wrap: balance;
  }
  .home-calendar__intro p { max-inline-size: 58ch; margin: 0; }
  .home-calendar__intro .home-calendar__lead {
    margin-block-end: .5rem;
    color: var(--pine-dark);
    font: 400 clamp(1.27rem, 2.45vw, 1.8rem)/1.22 var(--font-display);
  }
  #proximos-encuentros { scroll-margin-block-start: 1.6rem; }
  .home-calendar__list {
    display: grid;
    gap: .8rem;
    margin: .4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .home-calendar__event {
    padding-block: 1rem;
    border-block-start: 1px solid var(--journey-rule);
  }
  .home-calendar__event--featured {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--journey-rule);
    border-radius: 1.15rem;
    background: var(--surface-editorial);
  }
  .home-calendar__photo {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 13rem;
    aspect-ratio: 1.85;
    object-fit: cover;
    object-position: 54% 45%;
  }
  .home-calendar__content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .65rem 1.4rem;
  }
  .home-calendar__event--featured .home-calendar__content {
    flex-direction: column;
    align-items: start;
    justify-content: center;
    gap: 1rem;
    padding: clamp(1.15rem, 3.4vw, 2.5rem);
  }
  .home-calendar__content h3 {
    margin: .2rem 0 .3rem;
    color: var(--pine-dark);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
  }
  .home-calendar__event--featured h3 { font-size: clamp(1.65rem, 3.4vw, 3rem); }
  .home-calendar__content h3 a:hover { text-decoration: underline; }
  .home-calendar__date {
    margin: 0;
    color: var(--journey-clay);
    font-size: .9rem;
    font-weight: 700;
  }
  .home-calendar__venue { margin: 0; color: var(--muted); }
  .home-calendar__content .journey-link { text-decoration: underline; text-underline-offset: .2em; }

  .home-base {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr);
    overflow: hidden;
    margin-top: clamp(1.6rem, 4vw, 2.8rem);
    border-radius: 1.15rem;
    background: var(--pine-band);
    color: var(--on-pine);
  }
  .home-base img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 1.57;
    object-fit: cover;
  }
  .home-base__content {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    align-content: center;
    gap: .45rem;
    padding: clamp(1.25rem, 4.3vw, 3.6rem);
  }
  .home-base__content::after {
    content: '';
    position: absolute;
    inset: 48% -28% -54% 57%;
    z-index: -1;
    border: 1px solid #9e885a;
    border-radius: 50%;
    opacity: .68;
    transform: rotate(-27deg);
  }
  .home-base__content .eyebrow { margin: 0; color: #e4c38b; }
  .home-base h3 {
    margin: 0;
    color: inherit;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }
  .home-base p:not(.eyebrow) { margin: 0; max-inline-size: 32ch; }
  .home-base strong { display: block; margin-block-end: .25rem; }

  .home-library { padding-block: clamp(4.25rem, 10vw, 7rem) var(--journey-spacing); }
  .home-library__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: .55rem 1.5rem;
    margin-block-end: clamp(1.1rem, 3vw, 2rem);
  }
  .home-library__header p { max-inline-size: 50ch; margin-block-end: 0; }
  .home-library__header .eyebrow { margin-block-end: .55rem; }
  .home-library__header .journey-link { align-self: end; }
  .home-library__reading { display: grid; gap: clamp(1.35rem, 5.3vw, 4.25rem); }
  .home-library__reading--split { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .home-library__feature { display: grid; gap: .5rem; }
  .home-library__feature img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1.73;
    object-fit: cover;
    object-position: 50% 48%;
    border-radius: .65rem;
    margin-block-end: .38rem;
  }
  .home-library__feature h3, .home-library__list h3 { margin: 0; color: var(--pine-dark); }
  .home-library__feature h3 { font-size: clamp(1.55rem, 3vw, 2.55rem); }
  .home-library__feature p { margin: 0; max-inline-size: 45ch; }
  .home-library__feature h3 span { font: 700 .9rem var(--font-body); }
  .home-library__feature a:hover, .home-library__list a:hover h3 { text-decoration: underline; }
  .home-library__list { margin: 0; padding: 0; list-style: none; border-block-start: 1px solid var(--journey-rule); }
  .home-library__list li { border-block-end: 1px solid var(--journey-rule); }
  .home-library__list a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-block-size: 5.2rem; padding-block: .85rem; }
  .home-library__list h3 { font-size: clamp(1.28rem, 2.6vw, 1.95rem); }
