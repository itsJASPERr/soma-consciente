---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomepageOfferings from '../components/HomepageOfferings.astro';
import ProgramWaitlist from '../components/ProgramWaitlist.astro';
import ResourceList from '../components/ResourceList.astro';
import SomaAulaSymbol from '../components/SomaAulaSymbol.astro';
import SignupDialog from '../components/SignupDialog.astro';
import { offeringIntro } from '../lib/offerings';
import { loadAulas, loadResources } from '../lib/content';
import { loadHomepage } from '../lib/home';
import { mediaUrl } from '../lib/media';
import { path } from '../lib/paths';

const aulas = await loadAulas();
const themes = ['nicole', 'jasper', 'yanina', 'nico']
  .map(slug => aulas.find(aula => aula.slug === slug))
  .filter(aula => aula !== undefined);
const resources = await loadResources();
const home = await loadHomepage();
const sunrise = mediaUrl(home.heroImage);
const landscape = mediaUrl(home.nucleoImage);
const heroPhoto = sunrise
  ? { src: sunrise, alt: home.heroAlt, position: home.heroPosition }
  : { src: mediaUrl(home.encountersImage), alt: home.encountersAlt };
const circlePhoto = { src: mediaUrl(home.onlineImage), alt: home.onlineAlt };
const signupEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
---
<SiteLayout openJourney description={offeringIntro + ' Conocé el próximo encuentro, los círculos semanales y la comunidad de SOMA.'}>
  <HomepageOfferings image={heroPhoto} circleImage={circlePhoto} requestsEnabled={signupEnabled} />
  <section class="program-section" id="metodologia" aria-labelledby="metodologia-title">
    {signupEnabled && landscape && <img class="program-overlay-art" src={landscape} alt="" width="1100" height="780" loading="lazy" decoding="async" />}
    <div class="container program-preview">
      <h2 id="metodologia-title">Cuatro miradas, un mismo núcleo</h2>
      <p class="program-preview__intro">Estas perspectivas se encuentran en nuestras vivencias presenciales y en la integración de lo que compartimos.</p>
      <div class="program-preview__composition">
        <div class="program-preview__mark">
          <img src={path('/media/soma-original-emblem.png')} alt="Emblema original de SOMA CONSCIENTE" width="520" height="405" loading="lazy" decoding="async" />
        </div>
        <ul class="program-preview__themes" role="list" aria-label="Perspectivas de nuestra metodología">
          {themes.map(({ name, symbol }) => (
            <li><span aria-hidden="true"><SomaAulaSymbol symbol={symbol} /></span>{name}</li>
          ))}
        </ul>
      </div>
      <ProgramWaitlist signupEnabled={signupEnabled} />
    </div>
  </section>
  <section class="container journey-row">
    <div>
      <h2>Nuestra mirada</h2>
      <p>Creamos espacios para estar presentes, disfrutar y compartir lo que nos pasa, con respeto por el ritmo de cada persona.</p>
    </div>
    <div class="journey-actions">
      <a class="journey-link" href={path('/enfoque/')}>Conocer el enfoque <span aria-hidden="true">↗</span></a>
      <a class="journey-link" href={path('/nucleo/')}>Descubrir el Núcleo <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="container home-library">
    <div class="journey-row">
      <div><h2>Biblioteca abierta</h2><p>Recursos gratuitos para explorar y practicar a tu propio ritmo.</p></div>
      <a class="btn btn--outline" href={path('/biblioteca/')}>Ir a la Biblioteca <span aria-hidden="true">↗</span></a>
    </div>
    <ResourceList resources={resources} />
  </section>
  {signupEnabled && <SignupDialog />}
</SiteLayout>

<style>
  .program-section {
    padding-block: var(--journey-spacing);
    scroll-margin-top: 1.5rem;
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .program-overlay-art {
    position: absolute;
    z-index: -1;
    inset: 14% -6% auto auto;
    inline-size: min(63%, 51rem);
    block-size: 105%;
    object-fit: cover;
    border-radius: 54% 43% 41% 53% / 44% 44% 45% 47%;
    visibility: hidden;
  }
  :global(html:has(#program-launch-dialog[open][data-program-open])) .program-overlay-art { visibility: visible; opacity: .45; }
  .program-preview { text-align: center; }
  .program-preview h2 {
    margin: 0 auto .85rem;
    color: var(--pine-dark);
    font-size: clamp(2.1rem, 4.4vw, 4rem);
    text-wrap: balance;
  }
  .program-preview__intro { max-inline-size: 57ch; margin: 0 auto; text-wrap: pretty; }
  .program-preview__composition {
    --method-center: clamp(9rem, 22vw, 16rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--method-center) minmax(0, 1fr);
    align-items: center;
    max-inline-size: 64rem;
    margin: 1.35rem auto;
  }
  .program-preview__mark {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: clamp(.6rem, 2vw, 1.4rem);
    border: 1px solid #a77d473f;
    border-radius: 50%;
    background: radial-gradient(circle, #fffaf0 15%, transparent 70%);
  }
  .program-preview__mark img { display: block; inline-size: 100%; block-size: auto; }
  .program-preview__themes {
    grid-column: 1 / -1;
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0,1fr) var(--method-center) minmax(0,1fr);
    grid-template-rows: auto auto;
    grid-auto-flow: column;
    gap: .7rem clamp(.75rem, 2vw, 1.7rem);
    padding: 0;
    margin: 0;
    list-style: none;
    color: var(--pine-dark);
    font-size: clamp(.88rem, 1.35vw, 1rem);
    font-weight: 700;
    line-height: 1.4;
  }
  .program-preview__themes li {
    display: flex;
    align-items: center;
    gap: .55rem;
    text-align: start;
    min-inline-size: 0;
  }
  .program-preview__themes li:nth-child(-n + 2) { justify-content: flex-end; }
  .program-preview__themes li:nth-child(n + 3) { grid-column: 3; }
  .program-preview__themes li span { flex: 0 0 1.5rem; }
  .program-preview__themes li :global(img) { display: block; inline-size: 100%; block-size: auto; }
  .home-library { margin-block-end: var(--journey-spacing); }
  @media (max-width: 710px) {
    .program-preview__composition { display: block; }
    .program-preview__mark { inline-size: min(70%, 13rem); margin: 0 auto 1.2rem; }
    .program-preview__themes {
      max-inline-size: 32rem;
      margin-inline: auto;
      grid-template-columns: repeat(2, minmax(0,1fr));
      grid-auto-flow: row;
    }
    .program-preview__themes li:nth-child(n) { grid-column: auto; justify-content: start; }
  }
  @media (max-width: 360px) {
    .program-preview__themes { grid-template-columns: minmax(0,1fr); }
  }
</style>
