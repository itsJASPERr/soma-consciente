---
import { Icon } from 'astro-icon/components';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProgramWaitlist from '../components/ProgramWaitlist.astro';
import ResourceList from '../components/ResourceList.astro';
import SomaAulaSymbol from '../components/SomaAulaSymbol.astro';
import SignupDialog from '../components/SignupDialog.astro';
import { loadAulas, loadResources } from '../lib/content';
import { loadHomepage } from '../lib/home';
import { mediaUrl } from '../lib/media';
import { offerings } from '../lib/offerings';
import { path } from '../lib/paths';

const aulas = await loadAulas();
const themes = ['nicole', 'jasper', 'yanina', 'nico']
  .map(slug => aulas.find(aula => aula.slug === slug))
  .filter(aula => aula !== undefined);
const resources = await loadResources();
const home = await loadHomepage();
const sunrise = mediaUrl(home.heroImage);
const landscape = mediaUrl(home.nucleoImage);
const heroPhoto = sunrise
  ? { src: sunrise, alt: home.heroAlt, position: home.heroPosition || 'center' }
  : { src: mediaUrl(home.encountersImage), alt: home.encountersAlt, position: 'center' };
const signupEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const nucleusStatements = [
  'Prácticas y herramientas compartidas',
  'Prácticas interdisciplinarias',
  'Acompañamiento e integración',
  'Encuentros y experiencias',
];
const retreat = offerings.find(offer => offer.slug === 'encuentro-enero');
const door = offerings.find(offer => offer.slug === 'puerta-abierta');
const retreatDates = retreat && 'dates' in retreat && retreat.dates?.length ? retreat.dates : [];
const calendar = [
  ...(retreat ? (retreatDates.length ? retreatDates : [{ when: retreat.when, venue: retreat.venue }]).map((date, index) => ({
    title: retreat.title,
    when: date.when,
    venue: date.venue,
    href: index === 0 ? path('/encuentros/retiro-enero-2027/') : path('/encuentros/#' + retreat.slug + '-' + (index + 1)),
  })) : []),
  ...(door ? [{
    title: door.title,
    when: door.when,
    venue: [door.venue, door.details].filter(Boolean).join(' · '),
    href: path('/encuentros/#puerta-abierta'),
  }] : []),
];
---
<SiteLayout revealHeader openJourney description="La consciencia se vive. Somos cuatro miradas unidas por un propósito: vivir cada día con más presencia, disfrute y conexión.">
  <section class="home-hero" aria-labelledby="participation-heading">
    {heroPhoto.src && (
      <img
        class="home-hero__photo"
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        style={`object-position: ${heroPhoto.position}`}
        width="1600"
        height="1000"
        fetchpriority="high"
        decoding="async"
      />
    )}
    <div class="home-hero__copy">
      <h1 id="participation-heading">La consciencia se vive.</h1>
      <p>Somos cuatro miradas unidas por un propósito: vivir cada día con más presencia, disfrute y conexión.</p>
    </div>
    <button class="home-hero__down" type="button" aria-label="Bajar">
      <Icon name="iconoir:nav-arrow-down" size={22} aria-hidden="true" />
    </button>
  </section>
  <script>
    const down = document.querySelector<HTMLButtonElement>('.home-hero__down');
    const next = document.querySelector('.values-strip');
    if (down && next) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const settle = () => down.classList.toggle('is-quiet', reduce || window.scrollY > 24);
      down.addEventListener('click', () => next.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' }));
      settle();
      window.addEventListener('scroll', settle, { passive: true });
    }
  </script>

  <div class="values-strip">
    <div class="container values-list">
      <span>Presencia</span><span>Integración</span><span>Autonomía</span><span>Respeto</span><span>Comunidad</span>
    </div>
  </div>

  <section class="program-section" id="metodologia" aria-labelledby="metodologia-title">
    {signupEnabled && landscape && <img class="program-overlay-art" src={landscape} alt="" width="1100" height="780" loading="lazy" decoding="async" />}
    <div class="container program-preview">
      <p class="eyebrow">Un camino integrado</p>
      <h2 id="metodologia-title">Cuatro miradas, un núcleo</h2>
      <p class="program-preview__intro">Donde las distintas miradas se encuentran hay un espacio para cocrear propuestas que conectan cuerpo, emoción, consciencia y naturaleza sin perder la singularidad de cada disciplina. Compartimos desde el lugar de nuestra propia práctica.</p>
      <div class="program-preview__composition">
        <div class="program-preview__orbit">
          <svg class="program-preview__form" viewBox="0 0 430 441" role="presentation">
            <defs>
              <clipPath id="miradas-form">
                <path d="M 400.00 214.00 C 399.84 220.41 399.31 226.84 398.44 233.18 C 397.57 239.51 396.33 245.82 394.77 252.00 C 393.21 258.18 391.30 264.29 389.09 270.24 C 386.88 276.19 384.33 282.04 381.52 287.70 C 378.71 293.36 375.59 298.88 372.22 304.20 C 368.86 309.51 365.21 314.67 361.36 319.61 C 357.50 324.55 353.38 329.30 349.08 333.82 C 344.78 338.35 340.24 342.68 335.54 346.77 C 330.84 350.85 325.94 354.73 320.88 358.36 C 315.83 361.99 310.59 365.40 305.23 368.54 C 299.86 371.69 294.32 374.60 288.68 377.23 C 283.03 379.87 277.23 382.26 271.35 384.35 C 265.46 386.44 259.44 388.27 253.36 389.78 C 247.28 391.29 241.08 392.52 234.86 393.41 C 228.63 394.30 222.31 394.89 216.00 395.12 C 209.69 395.36 203.32 395.27 197.00 394.81 C 190.68 394.36 184.33 393.56 178.08 392.40 C 171.83 391.23 165.60 389.71 159.52 387.83 C 153.44 385.95 147.41 383.71 141.59 381.13 C 135.77 378.54 130.05 375.60 124.58 372.34 C 119.11 369.09 113.79 365.48 108.76 361.61 C 103.72 357.74 98.89 353.53 94.36 349.10 C 89.82 344.67 85.54 339.94 81.57 335.04 C 77.60 330.14 73.91 324.97 70.55 319.68 C 67.18 314.39 64.11 308.88 61.36 303.28 C 58.61 297.69 56.18 291.92 54.05 286.11 C 51.92 280.29 50.11 274.35 48.59 268.39 C 47.07 262.44 45.87 256.40 44.94 250.36 C 44.02 244.32 43.40 238.24 43.04 232.18 C 42.69 226.12 42.63 220.04 42.82 214.00 C 43.02 207.96 43.49 201.93 44.22 195.95 C 44.95 189.97 45.95 184.01 47.21 178.12 C 48.46 172.24 49.98 166.39 51.75 160.63 C 53.52 154.88 55.56 149.17 57.85 143.59 C 60.15 138.00 62.70 132.49 65.52 127.12 C 68.33 121.75 71.41 116.47 74.75 111.38 C 78.09 106.28 81.69 101.30 85.54 96.53 C 89.39 91.77 93.50 87.15 97.85 82.78 C 102.20 78.41 106.80 74.23 111.61 70.32 C 116.42 66.42 121.48 62.73 126.72 59.36 C 131.95 55.98 137.41 52.86 143.01 50.06 C 148.61 47.27 154.41 44.77 160.31 42.60 C 166.21 40.44 172.28 38.59 178.40 37.10 C 184.52 35.60 190.77 34.44 197.04 33.62 C 203.31 32.81 209.67 32.35 216.00 32.23 C 222.33 32.11 228.72 32.34 235.03 32.90 C 241.35 33.47 247.68 34.39 253.91 35.63 C 260.15 36.87 266.35 38.45 272.42 40.35 C 278.50 42.24 284.51 44.46 290.36 46.98 C 296.21 49.50 301.97 52.34 307.54 55.45 C 313.11 58.57 318.55 61.99 323.77 65.67 C 329.00 69.34 334.06 73.32 338.88 77.52 C 343.71 81.73 348.34 86.21 352.70 90.91 C 357.07 95.61 361.21 100.56 365.06 105.70 C 368.90 110.84 372.50 116.22 375.78 121.75 C 379.05 127.29 382.05 133.03 384.70 138.89 C 387.35 144.75 389.69 150.80 391.68 156.92 C 393.66 163.04 395.31 169.31 396.60 175.61 C 397.88 181.91 398.82 188.33 399.39 194.73 C 399.95 201.12 400.15 207.59 400.00 214.00 Z" />
              </clipPath>
            </defs>
            {landscape && <image href={landscape} x="18" y="8" width="394" height="410" preserveAspectRatio="xMidYMid slice" clip-path="url(#miradas-form)" />}
            <path d="M 418.00 214.00 C 417.84 221.04 417.28 228.10 416.34 235.06 C 415.41 242.01 414.07 248.95 412.38 255.74 C 410.69 262.53 408.61 269.26 406.21 275.80 C 403.81 282.35 401.03 288.78 397.97 295.02 C 394.90 301.25 391.49 307.33 387.81 313.20 C 384.14 319.06 380.14 324.74 375.92 330.19 C 371.69 335.63 367.18 340.88 362.45 345.87 C 357.73 350.86 352.75 355.63 347.59 360.14 C 342.42 364.65 337.02 368.92 331.46 372.92 C 325.90 376.92 320.14 380.67 314.23 384.13 C 308.31 387.59 302.22 390.79 296.00 393.68 C 289.78 396.57 283.39 399.18 276.91 401.47 C 270.43 403.75 263.80 405.74 257.10 407.38 C 250.41 409.02 243.59 410.35 236.74 411.31 C 229.89 412.26 222.94 412.89 216.00 413.12 C 209.06 413.36 202.06 413.23 195.11 412.71 C 188.17 412.19 181.20 411.30 174.34 410.00 C 167.48 408.71 160.63 407.02 153.96 404.95 C 147.28 402.88 140.67 400.41 134.27 397.57 C 127.87 394.73 121.60 391.50 115.58 387.93 C 109.56 384.37 103.72 380.41 98.18 376.17 C 92.63 371.93 87.31 367.32 82.31 362.48 C 77.31 357.63 72.58 352.45 68.20 347.08 C 63.81 341.71 59.72 336.06 55.98 330.26 C 52.25 324.46 48.84 318.42 45.77 312.28 C 42.71 306.14 39.99 299.81 37.60 293.43 C 35.22 287.04 33.18 280.51 31.47 273.96 C 29.76 267.40 28.39 260.75 27.34 254.10 C 26.28 247.45 25.56 240.74 25.14 234.06 C 24.72 227.38 24.63 220.67 24.82 214.00 C 25.02 207.33 25.53 200.67 26.32 194.06 C 27.12 187.46 28.21 180.88 29.60 174.38 C 30.98 167.88 32.66 161.42 34.63 155.07 C 36.60 148.72 38.86 142.43 41.41 136.27 C 43.96 130.11 46.80 124.03 49.93 118.12 C 53.06 112.21 56.48 106.40 60.19 100.80 C 63.89 95.19 67.89 89.72 72.16 84.49 C 76.43 79.26 80.99 74.19 85.81 69.41 C 90.62 64.62 95.71 60.03 101.03 55.76 C 106.35 51.49 111.94 47.46 117.72 43.77 C 123.49 40.08 129.52 36.67 135.69 33.62 C 141.86 30.57 148.25 27.84 154.75 25.49 C 161.24 23.13 167.92 21.12 174.66 19.49 C 181.39 17.86 188.27 16.60 195.16 15.72 C 202.05 14.84 209.04 14.35 216.00 14.23 C 222.96 14.11 229.97 14.37 236.92 15.00 C 243.86 15.63 250.81 16.65 257.66 18.02 C 264.50 19.39 271.32 21.14 277.99 23.23 C 284.66 25.31 291.26 27.76 297.68 30.54 C 304.11 33.31 310.43 36.44 316.54 39.86 C 322.65 43.29 328.62 47.06 334.35 51.10 C 340.08 55.15 345.64 59.52 350.93 64.15 C 356.22 68.77 361.30 73.70 366.08 78.87 C 370.86 84.03 375.41 89.47 379.62 95.12 C 383.83 100.77 387.78 106.68 391.36 112.75 C 394.95 118.83 398.23 125.14 401.14 131.57 C 404.04 138.00 406.62 144.64 408.79 151.36 C 410.97 158.07 412.79 164.96 414.21 171.87 C 415.62 178.78 416.65 185.82 417.29 192.84 C 417.92 199.87 418.15 206.96 418.00 214.00 Z" fill="none" stroke="#c4a36a" stroke-width="1.15" />
          </svg>
          <div class="program-preview__mark">
            <img src={path('/media/soma-original-emblem.png')} alt="Emblema original de SOMA CONSCIENTE" width="520" height="405" loading="lazy" decoding="async" />
          </div>
        </div>
        <ul class="program-preview__themes" role="list" aria-label="Perspectivas de nuestra metodología">
          {themes.map(({ name, symbol, slug }) => (
            <li class={'program-preview__theme program-preview__theme--' + slug}>
              <span class="program-preview__glyph" aria-hidden="true"><SomaAulaSymbol symbol={symbol} /></span>
              <span>{name}</span>
            </li>
          ))}
        </ul>
      </div>
      <ol class="nucleus-points">
        {nucleusStatements.map((statement, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{statement}</li>
        ))}
      </ol>
      <ProgramWaitlist signupEnabled={signupEnabled} />
    </div>
  </section>

  <section class="home-active" aria-labelledby="programas-activos-title">
    <div class="container home-active__inner">
      <p class="eyebrow">Programas activos</p>
      <h2 id="programas-activos-title">Encuentros presenciales. Integración online.</h2>
      <p>Reunimos las cuatro miradas en el encuentro presencial y las seguimos en los círculos de integración online.</p>
      <a class="btn btn--outline" href={path('/encuentros/')}>Ver encuentros <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="container home-library" aria-labelledby="biblioteca-home-title">
    <p class="eyebrow">Abierto para todos</p>
    <h2 id="biblioteca-home-title">Contenido para tu camino</h2>
    <div class="home-library__intro">
      <p>Recursos gratuitos para empezar hoy. Explorá, practicá y elegí a tu propio ritmo.</p>
      <a class="journey-link" href={path('/biblioteca/')}>Ir a la Biblioteca <span aria-hidden="true">↗</span></a>
    </div>
    <ResourceList resources={resources} cards />
  </section>

  <div class="values-strip" aria-hidden="true">
    <div class="container values-list">
      <span>Presencia</span><span>Integración</span><span>Autonomía</span><span>Respeto</span><span>Comunidad</span>
    </div>
  </div>

  {calendar.length > 0 && (
    <section class="container home-calendar" aria-labelledby="proximos-encuentros">
      <div class="journey-row">
        <div>
          <h2 id="proximos-encuentros">Próximos encuentros</h2>
          <p>Fechas para encontrarnos en persona y seguir lo vivido en la integración.</p>
        </div>
      </div>
      <ul class="home-calendar__list">
        {calendar.map((event) => (
          <li>
            <div>
              <h3><a href={event.href}>{event.title}</a></h3>
              <p>
                {event.when && <span><Icon name="iconoir:calendar" size={18} aria-hidden="true" />{event.when}</span>}
                {event.venue && <span><Icon name="iconoir:map-pin" size={18} aria-hidden="true" />{event.venue}</span>}
              </p>
            </div>
            <a class="journey-link" href={event.href}>{event.title === door?.title ? 'Ver el evento' : 'Ver el encuentro'} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
      <div class="home-base">
        <div>
          <p class="eyebrow">Nuestra base</p>
          <h3>Casa Sabia</h3>
          <p>La Falda, Córdoba. Desde aquí salen los encuentros presenciales.</p>
        </div>
        <img src={path('/media/photography/casa-sabia.jpg')} alt="Casa de piedra con pileta y jardín en Casa Sabia, La Falda" width="1570" height="1001" loading="lazy" decoding="async" />
      </div>
    </section>
  )}
  {signupEnabled && <SignupDialog />}
</SiteLayout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-block-size: 100vh;
    min-block-size: 100dvh;
    padding: clamp(5.5rem, 14vh, 8rem) 1.25rem;
    overflow: hidden;
    text-align: center;
    color: var(--pine-dark);
  }
  .home-hero__photo {
    position: absolute;
    z-index: -2;
    top: 50%;
    left: 50%;
    inline-size: 130%;
    block-size: 130%;
    max-inline-size: none;
    object-fit: cover;
    transform: translate(-50%, -50%);
    animation: hero-drift 26s ease-in-out infinite;
  }
  .home-hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 42%, rgba(246, 239, 227, .16), transparent 62%),
      linear-gradient(180deg, rgba(246, 239, 227, .58) 0%, rgba(246, 239, 227, .18) 42%, rgba(246, 239, 227, .5) 100%);
  }
  .home-hero__copy { max-inline-size: 40rem; }
  .home-hero__down {
    position: absolute;
    left: 50%;
    bottom: clamp(1.35rem, 4vh, 2.5rem);
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--pine-dark) 35%, transparent);
    border-radius: 50%;
    background: transparent;
    color: var(--pine-dark);
    cursor: pointer;
    animation: hero-nudge 6s ease-in-out infinite;
  }
  .home-hero__down:hover { background: rgba(251, 248, 241, .28); }
  .home-hero__down.is-quiet { animation: none; }
  @keyframes hero-nudge {
    0%, 68%, 100% { transform: translateX(-50%) translateY(0); }
    76% { transform: translateX(-50%) translateY(8px); }
    84% { transform: translateX(-50%) translateY(0); }
    90% { transform: translateX(-50%) translateY(4px); }
  }
  @keyframes hero-drift {
    0%, 4% { transform: translate(-56%, -46%) scale(1); }
    46%, 54% { transform: translate(-44%, -56%) scale(1.08); }
    96%, 100% { transform: translate(-56%, -46%) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero__down { animation: none; }
    .home-hero__photo {
      top: 0;
      left: 0;
      inline-size: 100%;
      block-size: 100%;
      transform: none;
      animation: none;
    }
  }
  .home-hero h1 {
    margin: 0 auto;
    max-inline-size: 11ch;
    color: var(--pine-dark);
    font-size: clamp(3.4rem, 8vw, 7rem);
    line-height: .92;
    text-wrap: balance;
  }
  .home-hero p {
    max-inline-size: 34ch;
    margin: clamp(1.4rem, 3vh, 2.2rem) auto 0;
    color: #314038;
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .program-section {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    scroll-margin-top: 6.5rem;
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .program-overlay-art {
    position: absolute;
    z-index: -1;
    inset: 14% -6% auto auto;
    inline-size: min(63%, 51rem);
    block-size: 105%;
    object-fit: cover;
    border-radius: 54% 43% 41% 53% / 44% 44% 45% 47%;
    visibility: hidden;
  }
  :global(html:has(#program-launch-dialog[open][data-program-open])) .program-overlay-art { visibility: visible; opacity: .45; }
  .program-preview { text-align: center; }
  .program-preview .eyebrow { margin-bottom: .45rem; }
  .program-preview h2 {
    margin: 0 auto .85rem;
    color: var(--pine-dark);
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    text-wrap: balance;
  }
  .program-preview__intro {
    max-inline-size: 62ch;
    margin: 0 auto;
    text-wrap: pretty;
  }
  .program-preview__composition {
    --orbit: 58%;
    --glyph: 2.7rem;
    position: relative;
    inline-size: min(100%, 46rem);
    aspect-ratio: 1;
    margin: clamp(1.2rem, 3vw, 2rem) auto .4rem;
  }
  .program-preview__orbit {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 48%;
    inline-size: var(--orbit);
    aspect-ratio: 430 / 441;
    transform: translate(-50%, -50%);
  }
  .program-preview__form {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .program-preview__mark {
    position: absolute;
    z-index: 2;
    left: 85%;
    top: 85%;
    display: grid;
    place-items: center;
    inline-size: 42%;
    aspect-ratio: 1;
    padding: 5%;
    border: 1px solid #c4a36a;
    border-radius: 50%;
    background: #f7f1e6;
    transform: translate(-50%, -50%);
  }
  .program-preview__mark img { display: block; inline-size: 100%; block-size: auto; }
  .program-preview__themes {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .program-preview__theme {
    position: absolute;
    display: flex;
    align-items: center;
    gap: .55rem;
    margin: 0;
    color: var(--pine-dark);
    font-size: clamp(.78rem, 1.15vw, .95rem);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }
  .program-preview__glyph {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: var(--glyph);
    block-size: var(--glyph);
  }
  .program-preview__glyph :global(img) { display: block; inline-size: 100%; block-size: auto; }
  .program-preview__theme--jasper {
    left: 22.5%;
    top: 22.8%;
    inline-size: 13rem;
    flex-direction: row-reverse;
    text-align: end;
    transform: translate(calc(-100% + var(--glyph) / 2), -50%);
  }
  .program-preview__theme--nico {
    left: 16.4%;
    top: 55.5%;
    inline-size: 12.5rem;
    flex-direction: row-reverse;
    text-align: end;
    transform: translate(calc(-100% + var(--glyph) / 2), -50%);
  }
  .program-preview__theme--yanina {
    left: 69.1%;
    top: 17.8%;
    inline-size: 9.5rem;
    text-align: start;
    transform: translate(calc(var(--glyph) / -2), -50%);
  }
  .program-preview__theme--nicole {
    left: 39.3%;
    top: 79.9%;
    inline-size: 8.5rem;
    flex-direction: column;
    gap: .3rem;
    text-align: center;
    transform: translate(-50%, calc(var(--glyph) / -2));
  }
  .nucleus-points {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem clamp(.8rem, 2vw, 1.6rem);
    max-inline-size: 62rem;
    margin: clamp(1.2rem, 3vw, 2rem) auto 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }
  .nucleus-points li {
    min-inline-size: 0;
    color: var(--pine-dark);
    font-weight: 700;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .nucleus-points span {
    display: block;
    margin-bottom: .25rem;
    color: var(--journey-clay, var(--terra));
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
  }
  .home-active {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    background: #efe4d2;
  }
  .home-active__inner {
    max-inline-size: 40rem;
    text-align: center;
  }
  .home-active h2 {
    margin: .2rem auto .7rem;
    color: var(--pine-dark);
    font-size: clamp(2rem, 4vw, 3.3rem);
    text-wrap: balance;
  }
  .home-active p:not(.eyebrow) {
