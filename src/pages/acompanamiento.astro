---
import SiteLayout from '../layouts/SiteLayout.astro';
import Offerings from '../components/Offerings.astro';
import { offerings } from '../lib/offerings';
import { path } from '../lib/paths';
import { loadHomepage } from '../lib/home';
import { mediaUrl } from '../lib/media';

const integration = offerings.filter(({ slug }) => slug === 'circulos' || slug === 'grupo-whatsapp');
const home = await loadHomepage();
const journal = mediaUrl(home.onlineImage);
const pictures = journal ? { circulos: { src: journal, alt: home.onlineAlt } } : {};
---
<SiteLayout title="Integración online" description="Círculo de integración online, una vez por semana, ARS 20.000 por mes. También podés entrar al grupo gratuito de WhatsApp.">
  <section class="page-hero">
    <div class="container">
      <h1>Integración online</h1>
      <p>Un espacio grupal para retomar lo vivido y darle lugar en lo cotidiano.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <Offerings offers={integration} pictures={pictures} />
    </div>
  </section>
  <section class="section--tight digital-band">
    <div class="container">
      <h2>Nos encontramos en persona</h2>
      <p class="section-intro">Conocé las próximas vivencias presenciales de SOMA. El encuentro de enero incluye un mes de círculos de integración online.</p>
      <a class="btn" href={path('/encuentros/#encuentro-enero')}>Ver el próximo encuentro ↗</a>
    </div>
  </section>
</SiteLayout>

<style>
  .page-hero { background: transparent; padding-bottom: 1.5rem; }
</style>
