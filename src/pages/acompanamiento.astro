---
import SiteLayout from '../layouts/SiteLayout.astro';
import Offerings from '../components/Offerings.astro';
import { offerings } from '../lib/offerings';
import { path } from '../lib/paths';

const integration = offerings.filter(({ slug }) => slug === 'circulos' || slug === 'grupo-whatsapp');
---
<SiteLayout title="Integración online" description="Acompañamiento para integrar las vivencias presenciales de SOMA. Participá en el círculo online semanal o pedí acceso al grupo gratuito de WhatsApp.">
  <section class="page-hero">
    <div class="container">
      <h1>Integración online</h1>
      <p>El encuentro presencial tiene un después. Los círculos online ofrecen un espacio grupal para compartir lo que quedó resonando y llevar lo vivido a la vida cotidiana.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Círculos y comunidad</h2>
      <Offerings offers={integration} />
    </div>
  </section>
  <section class="section--tight digital-band">
    <div class="container">
      <h2>Nos encontramos en persona</h2>
      <p class="section-intro">Conocé las próximas vivencias presenciales de SOMA. El encuentro de enero incluye un mes de círculos de integración online.</p>
      <a class="btn" href={path('/encuentros/#encuentro-enero')}>Ver el próximo encuentro ↗</a>
    </div>
  </section>
</SiteLayout>
