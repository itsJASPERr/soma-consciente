---
import EditorialPhoto from '../components/EditorialPhoto.astro';
import OfferingAction from '../components/OfferingAction.astro';
import SignupDialog from '../components/SignupDialog.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getOnlineCirclePhoto, loadHomepage } from '../lib/home';
import { offeringUrl, offerings } from '../lib/offerings';
import { retreatCta } from '../lib/analytics';
import { path } from '../lib/paths';

const home = await loadHomepage();
const circle = offerings.find(offer => offer.slug === 'circulos');
const community = offerings.find(offer => offer.slug === 'grupo-whatsapp');
const circlePhoto = getOnlineCirclePhoto(home);
const requestsEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const showDialog = requestsEnabled && [circle, community].some(offer => offer && !offeringUrl(offer));
---
<SiteLayout
  title="Círculo de integración online"
  description="Sumate al círculo semanal de integración online de SOMA para compartir lo vivido y darle lugar en lo cotidiano. También hay una comunidad gratuita en WhatsApp."
  ogImage={circlePhoto.src}
  ogImageAlt={circlePhoto.alt}
  openJourney
>
  {circle ? (
    <article
      id={circle.slug}
      class:list={['offering', 'container', 'journey-hero', { 'journey-hero--photo': circlePhoto.src }]}
      aria-labelledby="circulo-title"
    >
      <div class="journey-hero__copy">
        <span class="eyebrow">Integración online</span>
        <h1 id="circulo-title">{circle.title}</h1>
        <p class="journey-lead">{circle.description}</p>
        {circle.when && <p class="circle-frequency">{circle.when}</p>}
        <div class="offering__action">
          <OfferingAction offer={circle} requestsEnabled={requestsEnabled} showArrow />
          {!offeringUrl(circle) && requestsEnabled && circle.followUp && <p>{circle.followUp}</p>}
        </div>
      </div>
      <EditorialPhoto image={circlePhoto} class="journey-photo--circle" priority />
    </article>
  ) : (
    <section class="container journey-hero"><h1>Integración online</h1></section>
  )}
  {circle?.context && (
    <div class="container journey-row">
      <p>{circle.context}</p>
      <a class="journey-link" href={path('/encuentros/#encuentro-enero')} {...retreatCta('listing', 'integration_page')}>Ver fechas del retiro <span aria-hidden="true">↗</span></a>
    </div>
  )}
  {community && (
    <section id={community.slug} class="offering journey-band" aria-labelledby="grupo-title">
      <div class="container journey-row">
        <div>
          <h2 id="grupo-title">Comunidad gratuita de WhatsApp</h2>
          <p>{community.description}</p>
        </div>
        <div class="offering__action">
          <OfferingAction offer={community} requestsEnabled={requestsEnabled} class="btn btn--light" showArrow />
          {!offeringUrl(community) && requestsEnabled && community.followUp && <p>{community.followUp}</p>}
        </div>
      </div>
    </section>
  )}
  {showDialog && <SignupDialog />}
</SiteLayout>

<style>
  .circle-frequency {
    max-inline-size: 24rem;
    padding-block: .75rem;
    margin-block: 1rem;
    border-block: 1px solid var(--journey-rule);
    color: var(--pine-dark);
  }
</style>
