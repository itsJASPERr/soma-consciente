---
import Brand from './Brand.astro';
import { Icon } from 'astro-icon/components';
import { retreatCta } from '../lib/analytics';
import { path } from '../lib/paths';

interface Props {
  reveal?: boolean;
}

const { reveal = false } = Astro.props;
const links = [
  { label: 'Encuentros', href: '/encuentros/' },
  { label: 'Círculos', href: '/acompanamiento/#circulos' },
  { label: 'Comunidad', href: '/acompanamiento/#grupo-whatsapp' },
  { label: 'Enfoque', href: '/enfoque/' },
  { label: 'El Núcleo', href: '/nucleo/' },
  { label: 'Biblioteca', href: '/biblioteca/' },
  { label: 'Equipo', href: '/equipo/' }
];
---
<header class="site-header" data-reveal-header={reveal || undefined}>
  <div class="container header-inner">
    <Brand />
    <nav class="desktop-nav" aria-label="Navegación principal">
      {links.map((link) => <a href={path(link.href)}>{link.label}</a>)}
    </nav>
    <a class="header-cta" href={path('/encuentros/')} {...retreatCta('listing', 'site_header')}>Ver encuentros <span aria-hidden="true">↗</span></a>
    <button class="theme-toggle" type="button" aria-label="Modo oscuro" title="Modo oscuro" data-theme-toggle hidden>
      <Icon name="iconoir:half-moon" size={20} class="theme-toggle__moon" aria-hidden="true" />
      <Icon name="iconoir:sun-light" size={20} class="theme-toggle__sun" aria-hidden="true" />
    </button>
    <details class="mobile-nav">
      <summary aria-label="Abrir menú de navegación">Menú <Icon name="iconoir:menu" size={20} aria-hidden="true"/></summary>
      <nav aria-label="Navegación móvil">
        {links.map((link) => <a href={path(link.href)}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
<script is:inline>
  (() => {
    const header = document.querySelector('.site-header');
    if (!header) return;

    const menu = header.querySelector('.mobile-nav');
    menu?.querySelector('nav')?.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });

    const finishIntro = () => header.removeAttribute('data-intro-hidden');
    if (header.hasAttribute('data-reveal-header')) {
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      header.classList.add('site-header--reveal');
      if (!motion.matches && window.scrollY <= 8) {
        header.setAttribute('data-intro-hidden', '');
        window.setTimeout(finishIntro, 4000);
        header.addEventListener('focusin', finishIntro, { once: true });
        motion.addEventListener('change', finishIntro, { once: true });
      }
    }

    // Ignore overscroll at either end of the page.
    const scrollPosition = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      return Math.max(0, Math.min(window.scrollY, max));
    };
    let previousY = scrollPosition();
    let turnY = previousY;
    let direction = 0;

    window.addEventListener('scroll', () => {
      const y = scrollPosition();
      const nextDirection = Math.sign(y - previousY);
      if (!nextDirection) return;
      if (nextDirection !== direction) {
        turnY = previousY;
        direction = nextDirection;
      }
      previousY = y;

      if (y > 8 && header.hasAttribute('data-intro-hidden')) finishIntro();
      if (y <= header.offsetHeight) {
        header.removeAttribute('data-scroll-hidden');
      } else if (Math.abs(y - turnY) >= 12) {
        header.toggleAttribute('data-scroll-hidden', direction > 0);
      }
    }, { passive: true });
  })();
</script>

<style>
  .site-header { transition: transform .25s ease, opacity .55s ease; }
  .site-header--reveal {
    position: fixed;
    inset-inline: 0;
    z-index: 30;
  }
  .site-header[data-intro-hidden] {
    opacity: 0;
    transform: translateY(-.7rem);
    pointer-events: none;
  }
  .site-header[data-scroll-hidden]:not(:has(.mobile-nav[open], :focus-visible)) {
    transform: translateY(-100%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
  .theme-toggle {
    flex: 0 0 auto;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--cream);
    color: var(--pine-dark);
    cursor: pointer;
  }
  .theme-toggle:not([hidden]) { display: grid; }
  .theme-toggle:hover { background: var(--surface-sage); }
  .theme-toggle[aria-pressed='false'] .theme-toggle__sun,
  .theme-toggle[aria-pressed='true'] .theme-toggle__moon { display: none; }
  @media (max-width: 1150px) {
    .theme-toggle { margin-inline-start: auto; }
    .theme-toggle:not([hidden]) + .mobile-nav { margin-inline-start: 0; }
  }
</style>
