---
import { path } from '../lib/paths';
import SomaMark from './SomaMark.astro';
const { compact = false } = Astro.props;
---
<a href={path('/')} class:list={['brand', { 'brand--compact': compact }]} aria-label="SOMA CONSCIENTE · Inicio">
  <span class="brand__symbol"><SomaMark id={compact ? 'soma-footer' : 'soma-header'} decorative /></span>
  <span class="brand__type"><strong>SOMA</strong><small>CONSCIENTE</small></span>
</a>
