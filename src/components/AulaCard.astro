---
import type { Aula } from '../lib/content';
import { path } from '../lib/paths';
import { Icon } from 'astro-icon/components';
import SomaAulaSymbol from './SomaAulaSymbol.astro';
import { mediaUrl } from '../lib/media';
import { coverObjectPosition } from '../lib/cover-position';

interface Props {
  aula: Aula;
  index?: number;
}

const { aula, index = 0 } = Astro.props;
const upcoming = aula.launchStatus === 'upcoming';
const CardTag = upcoming ? 'div' : 'a';
const photo = mediaUrl(aula.coverImage);
const position = coverObjectPosition(aula.coverPosition);
---
<CardTag
  class:list={['aula-card', 'aula-card--' + aula.theme, 'aula-card--symbol-' + aula.symbol, { 'aula-card--disabled': upcoming }]}
  href={upcoming ? undefined : path('/aulas/' + aula.slug + '/')}
  role={upcoming ? 'link' : undefined}
  aria-disabled={upcoming ? 'true' : undefined}
>
  <div class:list={['aula-card__art', {'aula-card__art--photo':!!photo}]}>
    <div class="aula-card__media" aria-hidden={!photo ? 'true' : undefined}>
      {photo
        ? <img class="aula-card__photo" src={photo} alt={aula.coverAlt || 'Imagen ilustrativa del Aula'} loading="lazy" decoding="async" width="900" height="1000" style={{objectPosition:position}}/>
        : <><span class="art-circle art-circle--one"></span><span class="art-circle art-circle--two"></span></>}
    </div>
    <span class="aula-icon" aria-hidden="true"><SomaAulaSymbol symbol={aula.symbol}/></span>
    <span class="aula-card__number" aria-hidden="true">0{index + 1}</span>
  </div>
  <div class="aula-card__content">
    <span class="eyebrow eyebrow--light">{aula.guide}</span>
    <h3>{aula.name}</h3>
    <p>{aula.summary}</p>
    {!upcoming && (
      <span class="text-link text-link--light">Entrar al Aula <Icon name="iconoir:arrow-up-right" size={18} aria-hidden="true"/></span>
    )}
  </div>
</CardTag>
