---
import OfferingAction from './OfferingAction.astro';
import { offeringIntro, offerings } from '../lib/offerings';
import { path } from '../lib/paths';

interface Props {
  image?: { src: string; alt: string; position?: string };
  circleImage?: { src: string; alt: string };
  requestsEnabled: boolean;
}

const { image, circleImage, requestsEnabled } = Astro.props;
const encounter = offerings.find(({ slug }) => slug === 'encuentro-enero');
const circles = offerings.find(({ slug }) => slug === 'circulos');
const openDoor = offerings.find(({ slug }) => slug === 'puerta-abierta');
const community = offerings.find(({ slug }) => slug === 'grupo-whatsapp');
---
<section class="participation-hero" aria-labelledby="participation-heading">
  <div class:list={['participation-hero__layout', { 'participation-hero__layout--with-image': image?.src }]}>
    <div class="participation-hero__copy">
      <h1 id="participation-heading">Encuentros presenciales. <em>Integración online.</em></h1>
      <p class="participation-hero__lede">{offeringIntro}</p>
      {encounter && (
        <div class="participation-feature" id={encounter.slug}>
          <p class="participation-label">Próximo encuentro</p>
          <h2 class="participation-feature__date">{encounter.when || encounter.title}</h2>
          {encounter.venue && <p class="participation-feature__venue">{encounter.venue}</p>}
          {(encounter.homeNote || encounter.details) && <p class="participation-feature__included">{encounter.homeNote || encounter.details}</p>}
          <a class="btn" href={path('/encuentros/#' + encounter.slug)}>Ver el encuentro <span aria-hidden="true">↗</span></a>
        </div>
      )}
    </div>
    {image?.src && (
      <div class="participation-hero__frame">
        <img src={image.src} alt={image.alt} width="1100" height="780" fetchpriority="high" decoding="async" style={image.position && 'object-position:' + image.position} />
      </div>
    )}
  </div>
</section>

{circles && (
  <section id={circles.slug} class="participation-row participation-row--circles" aria-labelledby="participation-circles">
    <div class="participation-split">
      <div class="participation-split__copy">
        <h2 id="participation-circles">{circles.shortTitle || circles.title}</h2>
        {circles.description && <p class="participation-row__summary">{circles.description}</p>}
        {(circles.details || circles.when) && (
          <div class="participation-row__details">
            {circles.details && <p class="participation-row__price">{circles.details}</p>}
            {circles.when && <p class="participation-row__secondary">{circles.when}</p>}
          </div>
        )}
        {circles.context && <p class="participation-row__context">{circles.context}</p>}
        <div class="participation-row__action">
          <OfferingAction offer={circles} requestsEnabled={requestsEnabled} class="btn btn--outline" showArrow />
          {circles.followUp && <p class="participation-row__handoff">{circles.followUp}</p>}
        </div>
      </div>
      {circleImage?.src && (
        <div class="participation-split__frame">
          <img src={circleImage.src} alt={circleImage.alt} width="1100" height="780" loading="lazy" decoding="async" />
        </div>
      )}
    </div>
  </section>
)}

{openDoor && (
  <section id={openDoor.slug} class="participation-row participation-row--door" aria-labelledby="participation-door">
    <div class="container participation-row__layout">
      <div class="participation-row__lead">
        <h2 id="participation-door">{openDoor.shortTitle || openDoor.title}</h2>
        {openDoor.description && <p class="participation-row__summary">{openDoor.description}</p>}
      </div>
      {(openDoor.when || openDoor.venue || openDoor.details) && (
        <div class="participation-row__details">
          {openDoor.when && <p class="participation-row__date">{openDoor.when}</p>}
          {(openDoor.venue || openDoor.details) && <p class="participation-row__secondary">{[openDoor.venue, openDoor.details].filter(Boolean).join(' · ')}</p>}
        </div>
      )}
      <div class="participation-row__action">
        <OfferingAction offer={openDoor} requestsEnabled={requestsEnabled} class="text-link" showArrow />
        {openDoor.followUp && <p class="participation-row__handoff">{openDoor.followUp}</p>}
      </div>
    </div>
  </section>
)}

{community && (
  <section id={community.slug} class="participation-row participation-row--community" aria-labelledby="participation-community">
    <div class="container participation-row__layout">
      <div class="participation-row__lead">
        {community.details && <p class="participation-kicker">{community.details}</p>}
        <h2 id="participation-community">{community.title}</h2>
        {community.description && <p class="participation-row__invite">{community.description}</p>}
      </div>
      <div class="participation-row__action">
        <OfferingAction offer={community} requestsEnabled={requestsEnabled} class="btn btn--light" showArrow />
        {community.followUp && <p class="participation-row__handoff">{community.followUp}</p>}
      </div>
    </div>
  </section>
)}

<style>
  .participation-hero {
    background: transparent;
    padding-block: clamp(2.4rem, 7vw, 5.75rem) clamp(1.5rem, 4vw, 3rem);
  }
  .participation-hero__layout {
    display: grid;
    align-items: center;
    gap: clamp(1.75rem, 5vw, 4.5rem);
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }
  .participation-hero__layout--with-image {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .9fr);
  }
  .participation-hero__copy {
    min-inline-size: 0;
    align-self: center;
  }
  .participation-hero h1 {
    color: var(--pine-dark);
    font-size: clamp(2.4rem, 5.5vw, 4.65rem);
    line-height: 1.01;
    margin: 0;
  }
  .participation-hero h1 em {
    display: block;
    color: var(--pine);
    font-weight: 400;
  }
  .participation-hero__lede {
    max-inline-size: 42rem;
    margin: .9rem 0 0;
    color: var(--ink);
    font-size: clamp(1rem, 2vw, 1.12rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .participation-hero__frame {
    position: relative;
    min-block-size: clamp(20rem, 42vw, 34rem);
    border-radius: 48% 48% 1.35rem 1.35rem / 28% 28% 1.35rem 1.35rem;
    overflow: hidden;
    background: var(--pine-dark);
  }
  .participation-hero__frame img {
    position: absolute;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 61% 50%;
  }
  .participation-feature {
    max-inline-size: 34rem;
    margin-top: clamp(1.4rem, 3vw, 2.2rem);
    padding-top: 0;
    border-top: 0;
  }
  .participation-label, .participation-row__date {
    color: #994b37;
    font-weight: 700;
  }
  .participation-label {
    margin: 0 0 .42rem;
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .participation-feature__date {
    color: var(--pine-dark);
    font-size: clamp(1.94rem, 3.55vw, 3.15rem);
    margin: 0 0 .26rem;
  }
  .participation-feature__venue {
    color: var(--pine);
    line-height: 1.4;
    margin: 0 0 .48rem;
  }
  .participation-feature__included {
    max-width: 47ch;
    color: var(--pine-dark);
    font-weight: 700;
    line-height: 1.38;
    margin: 0 0 1rem;
  }
  .participation-feature .btn {
    inline-size: fit-content;
  }
  .participation-feature, .participation-row {
    scroll-margin-top: 1.5rem;
  }
  .participation-row {
    background: transparent;
  }
  .participation-row--circles {
    background: transparent;
  }
  .participation-row--community {
    background: var(--pine-dark);
    color: var(--cream);
  }
  .participation-split,
  .participation-row__layout {
    display: grid;
    grid-template-columns: minmax(0, 36rem);
    align-items: start;
    gap: .85rem 1.5rem;
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
    padding-block: clamp(2.75rem, 7vw, 5.25rem);
  }
  .participation-split {
    grid-template-columns: minmax(0, 1.05fr) minmax(14rem, .82fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .participation-split__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 46% 46% 1.2rem 1.2rem / 24% 24% 1.2rem 1.2rem;
    overflow: hidden;
    background: var(--pine-dark);
  }
  .participation-split__frame img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .participation-row__details {
    display: grid;
    gap: .15rem;
    line-height: 1.4;
  }
  .participation-row__action {
    grid-column: 1;
    justify-self: start;
    max-inline-size: 36rem;
    margin-top: .35rem;
  }
  .participation-row h2 {
    margin: 0;
    color: var(--pine-dark);
    font-size: clamp(2rem, 4vw, 3.4rem);
  }
  .participation-row--community h2 {
    color: inherit;
  }
  .participation-row p {
    margin: 0;
    font-size: .93rem;
  }
  .participation-row__price {
    color: var(--pine-dark);
    font-weight: 700;
  }
  .participation-row__secondary {
    color: var(--pine);
  }
  .participation-row__lead {
    min-inline-size: 0;
  }
  .participation-row__context,
  .participation-row__summary,
  .participation-row__invite,
  .participation-row__handoff {
    margin-top: .35rem;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .participation-row__handoff {
    max-inline-size: 100%;
    font-size: .82rem;
  }
  .participation-feature__date {
    text-wrap: balance;
  }
  .participation-kicker {
    margin: 0 0 .2rem;
    color: inherit;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  @media (max-width: 800px) {
    .participation-hero__layout,
    .participation-split,
    .participation-row__layout {
      width: min(100% - 32px, 1180px);
    }
    .participation-split { grid-template-columns: minmax(0, 1fr); }
    .participation-split__frame { order: 2; aspect-ratio: 1.5; }
  }
  @media (max-width: 680px) {
    .participation-hero__layout--with-image { grid-template-columns: minmax(0, 1fr); }
    .participation-hero h1 { font-size: clamp(2.4rem, 8.3vw, 3.8rem); }
    .participation-hero__frame { min-block-size: 0; aspect-ratio: 1.62; }
  }
</style>
