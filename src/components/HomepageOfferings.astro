---
import EditorialPhoto from './EditorialPhoto.astro';
import OfferingAction from './OfferingAction.astro';
import { offeringIntro, offerings } from '../lib/offerings';
import { path } from '../lib/paths';

type Photo = { src?: string; alt: string; position?: string };

interface Props {
  image?: Photo;
  circleImage?: Photo;
  requestsEnabled: boolean;
}

const { image, circleImage, requestsEnabled } = Astro.props;
const encounter = offerings.find(({ slug }) => slug === 'encuentro-enero');
const included = encounter?.homeNote || encounter?.details;
const alternatives = offerings.filter(({ slug }) => slug === 'circulos' || slug === 'puerta-abierta');
const community = offerings.find(({ slug }) => slug === 'grupo-whatsapp');
---
<section class="participation-hero" aria-labelledby="participation-heading">
  <div class:list={['container', 'journey-hero', { 'journey-hero--photo': image?.src }]}>
    <div class="journey-hero__copy">
      <h1 id="participation-heading">Encuentros presenciales.<br/><em>Integración online.</em></h1>
      <p class="journey-lead participation-hero__intro">{offeringIntro}</p>
      {encounter && (
        <div class="participation-feature" id={encounter.slug}>
          <p class="eyebrow">Próximo encuentro</p>
          <h2 class="participation-feature__date">{encounter.when || encounter.title}</h2>
          {encounter.venue && <p class="participation-feature__venue">{encounter.venue}</p>}
          {included && <p class="participation-feature__included">{included}</p>}
          <a class="btn" href={path('/encuentros/#' + encounter.slug)}>Ver el encuentro <span aria-hidden="true">↗</span></a>
        </div>
      )}
    </div>
    <EditorialPhoto image={image} class="participation-hero__frame" priority />
  </div>
</section>

{alternatives.length > 0 && (
  <section class:list={['container', 'participation-options', { 'participation-options--photo': circleImage?.src }]} aria-labelledby="participation-options-title">
    <EditorialPhoto image={circleImage} class="journey-photo--wide" />
    <div class="participation-options__copy">
      <h2 id="participation-options-title">Otras formas de participar</h2>
      {alternatives.map((offer) => {
        const circle = offer.slug === 'circulos';
        const href = path(circle ? '/acompanamiento/#circulos' : '/encuentros/#puerta-abierta');
        return (
          <article class="participation-row journey-row" id={offer.slug} aria-labelledby={offer.slug + '-home-title'}>
            <div>
              <h3 id={offer.slug + '-home-title'}><a href={href}>{offer.shortTitle || offer.title}</a></h3>
              <p class="participation-row__details">
                {circle ? <><strong>{offer.details}</strong> <span>{offer.when}</span></> :
                  <><strong class="participation-row__date">{offer.when}</strong> <span>{[offer.venue, offer.details].filter(Boolean).join(' · ')}</span></>}
              </p>
            </div>
            <div class="participation-row__action">
              <OfferingAction offer={offer} requestsEnabled={requestsEnabled} class="journey-link" showArrow />
            </div>
          </article>
        );
      })}
    </div>
  </section>
)}

{community && (
  <section id={community.slug} class="participation-row--community journey-band" aria-labelledby="participation-community">
    <div class="container journey-row">
      <div>
        <h2 id="participation-community">Comunidad gratuita de WhatsApp</h2>
        <p>{community.description}</p>
      </div>
      <div class="participation-row__action">
        <OfferingAction offer={community} requestsEnabled={requestsEnabled} class="btn btn--light" showArrow />
      </div>
    </div>
  </section>
)}

<style>
  .participation-hero h1 {
    max-inline-size: none;
    font-size: clamp(2.55rem, 4.65vw, 4.25rem);
    text-wrap: initial;
  }
  .participation-hero em { color: var(--journey-clay); font-style: normal; }
  .participation-feature {
    max-inline-size: 33rem;
    margin-block-start: clamp(1.1rem, 2vw, 1.6rem);
    padding-block-start: .85rem;
    border-block-start: 1px solid var(--journey-rule);
    scroll-margin-top: 1.5rem;
  }
  .participation-feature p { margin: 0 0 .22rem; }
  .participation-feature .eyebrow { margin-block-end: .4rem; }
  .participation-feature__date {
    margin: 0 0 .35rem;
    color: var(--pine-dark);
    font-size: clamp(1.75rem, 3.25vw, 2.8rem);
    text-wrap: balance;
  }
  .participation-feature__venue { font-weight: 700; }
  .participation-feature .btn { margin-block-start: .75rem; }
  .participation-options {
    display: grid;
    align-items: center;
    gap: clamp(1.25rem, 4.5vw, 4.75rem);
    padding-block: clamp(2rem, 4.4vw, 3.75rem);
    border-block-start: 1px solid var(--journey-rule);
  }
  .participation-options--photo { grid-template-columns: minmax(0, .73fr) minmax(0, 1.27fr); }
  .participation-options__copy { min-inline-size: 0; }
  .participation-options h2 {
    color: var(--pine-dark);
    font-size: clamp(2rem, 4vw, 3.6rem);
    margin-block-end: .85rem;
  }
  .participation-row { padding-block: .8rem; scroll-margin-top: 1.5rem; }
  .participation-row h3 { margin-block-end: .2rem; }
  .participation-row h3 a:hover { text-decoration: underline; }
  .participation-row__details {
    display: flex;
    flex-wrap: wrap;
    gap: .15rem .6rem;
    font-size: .94rem;
  }
  .participation-row__date { color: var(--journey-clay); }
  .participation-row__action { min-inline-size: 0; flex: 0 1 auto; }
  .participation-row__action :global(.offering-action-hint) { margin-block-start: .15rem; }
  .participation-row--community { scroll-margin-top: .5rem; }
  @media (max-width: 740px) {
    .participation-hero h1 { font-size: clamp(2.45rem, 9vw, 4.5rem); }
    .participation-options--photo { grid-template-columns: minmax(0,1fr); }
    .participation-options__copy { grid-row: 1; }
    .participation-options :global(.journey-photo) { inline-size: min(100%, 29rem); }
  }
  @media (max-width: 510px) {
    .participation-row { display: block; }
    .participation-row__action { margin-block-start: .25rem; }
    .participation-row__details { display: grid; }
  }
</style>
