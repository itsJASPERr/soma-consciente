---
import OfferingAction from './OfferingAction.astro';
import OfferingSignup from './OfferingSignup.astro';
import { offeringUrl, offerings } from '../lib/offerings';
import { path } from '../lib/paths';

interface Props {
  image?: { src: string; alt: string; position?: string };
}

const { image } = Astro.props;
const encounter = offerings.find(({ slug }) => slug === 'encuentro-enero');
const circles = offerings.find(({ slug }) => slug === 'circulos');
const openDoor = offerings.find(({ slug }) => slug === 'puerta-abierta');
const community = offerings.find(({ slug }) => slug === 'grupo-whatsapp');
const requestsEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const hasRequests = requestsEnabled && [circles, openDoor, community].some(offer => offer && !offeringUrl(offer));
---
<section class="participation-hero" aria-labelledby="participation-heading">
  <div class:list={['container', 'participation-hero__layout', { 'participation-hero__layout--with-image': image?.src }]}>
    <div class="participation-hero__copy">
      <h1 id="participation-heading">Encuentros presenciales. <em>Integración online.</em></h1>
      {encounter && (
        <div class="participation-feature" id={encounter.slug}>
          <p class="participation-label">Próximo encuentro</p>
          <h2 class="participation-feature__date">{encounter.when || encounter.title}</h2>
          {encounter.details && <p class="participation-feature__included">{encounter.details}</p>}
          <a class="btn" href={path('/encuentros/#' + encounter.slug)}>Ver el encuentro <span aria-hidden="true">↗</span></a>
        </div>
      )}
    </div>
    {image?.src && (
      <div class="participation-hero__frame">
        <img src={image.src} alt={image.alt} width="1100" height="780" fetchpriority="high" decoding="async" style={image.position && 'object-position:' + image.position} />
      </div>
    )}
  </div>
</section>

{circles && (
  <section id={circles.slug} class="participation-row participation-row--circles" aria-labelledby="participation-circles">
    <div class="container participation-row__layout">
      <h2 id="participation-circles">{circles.shortTitle || circles.title}</h2>
      {circles.when && <p class="participation-row__frequency">{circles.when}</p>}
      {circles.details && <p class="participation-row__price">{circles.details}</p>}
      <OfferingAction offer={circles} requestsEnabled={requestsEnabled} class="btn btn--outline" showArrow />
    </div>
  </section>
)}

{openDoor && (
  <section id={openDoor.slug} class="participation-row participation-row--door" aria-labelledby="participation-door">
    <div class="container participation-row__layout">
      <h2 id="participation-door">{openDoor.shortTitle || openDoor.title}</h2>
      {(openDoor.venue || openDoor.details) && <p class="participation-row__place">{[openDoor.venue, openDoor.details].filter(Boolean).join(' · ')}</p>}
      {openDoor.when && <p class="participation-row__date">{openDoor.when}</p>}
      <OfferingAction offer={openDoor} requestsEnabled={requestsEnabled} class="text-link" showArrow />
    </div>
  </section>
)}

{community && (
  <section id={community.slug} class="participation-row participation-row--community" aria-labelledby="participation-community">
    <div class="container participation-row__layout">
      <h2 id="participation-community">{community.title}</h2>
      <OfferingAction offer={community} requestsEnabled={requestsEnabled} class="btn btn--light" showArrow />
    </div>
  </section>
)}

{hasRequests && <OfferingSignup />}

<style>
  .participation-hero {
    background: var(--paper);
    padding-block: clamp(1.65rem, 5vw, 4rem);
  }
  .participation-hero__layout {
    display: grid;
    align-items: stretch;
    gap: clamp(1.25rem, 4.5vw, 3.25rem);
  }
  .participation-hero__layout--with-image {
    grid-template-columns: minmax(0, 1.13fr) minmax(0, 1fr);
  }
  .participation-hero__copy {
    min-inline-size: 0;
    align-self: center;
  }
  .participation-hero h1 {
    color: var(--pine-dark);
    font-size: clamp(2.4rem, 5.5vw, 4.65rem);
    line-height: 1.01;
    margin: 0;
  }
  .participation-hero h1 em {
    display: block;
    color: var(--pine);
    font-weight: 400;
  }
  .participation-hero__frame {
    position: relative;
    min-block-size: clamp(19rem, 37vw, 31rem);
    border-radius: 41% 41% 1.15rem 1.15rem / 26% 26% 1.15rem 1.15rem;
    overflow: hidden;
    background: var(--pine-dark);
  }
  .participation-hero__frame img {
    position: absolute;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 61% 50%;
  }
  .participation-feature {
    max-inline-size: 32rem;
    margin-top: clamp(1rem, 2.7vw, 1.7rem);
    padding-top: clamp(.75rem, 2vw, 1.2rem);
    border-top: 1px solid var(--line);
  }
  .participation-label, .participation-row__date {
    color: #994b37;
    font-weight: 700;
  }
  .participation-label {
    margin: 0 0 .42rem;
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .participation-feature__date {
    color: var(--pine-dark);
    font-size: clamp(1.94rem, 3.55vw, 3.15rem);
    margin: 0 0 .26rem;
  }
  .participation-feature__included {
    max-width: 47ch;
    color: var(--pine-dark);
    font-weight: 700;
    line-height: 1.38;
    margin: 0 0 1rem;
  }
  .participation-feature .btn {
    inline-size: fit-content;
  }
  .participation-feature, .participation-row {
    scroll-margin-top: 1.5rem;
  }
  .participation-row {
    background: var(--cream);
  }
  .participation-row + .participation-row,
  .participation-row--circles {
    border-top: 1px solid var(--line);
  }
  .participation-row--circles {
    background: #e8ecdf;
  }
  .participation-row--community {
    background: var(--pine-dark);
    color: var(--cream);
  }
  .participation-row__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: center;
    justify-items: start;
    gap: .65rem clamp(.85rem, 2.3vw, 1.65rem);
    padding-block: clamp(.9rem, 2vw, 1.3rem);
  }
  .participation-row--community .participation-row__layout {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .participation-row h2 {
    margin: 0;
    color: var(--pine-dark);
    font-size: clamp(1.63rem, 2.75vw, 2.38rem);
  }
  .participation-row--community h2 {
    color: inherit;
  }
  .participation-row p {
    margin: 0;
    font-size: .93rem;
  }
  .participation-row__price {
    color: var(--pine-dark);
    font-weight: 700;
  }
  .participation-row__place, .participation-row__frequency {
    color: var(--pine-dark);
  }
  @media (max-width: 850px) {
    .participation-row__layout {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }
    .participation-row__layout h2 { grid-column: 1 / -1; }
    .participation-row--community h2 { grid-column: auto; }
  }
  @media (max-width: 680px) {
    .participation-hero__layout--with-image { grid-template-columns: minmax(0, 1fr); }
    .participation-hero h1 { font-size: clamp(2.4rem, 8.3vw, 3.8rem); }
    .participation-hero__frame { min-block-size: 0; aspect-ratio: 1.62; }
  }
  @media (max-width: 550px) {
    .participation-row__layout,
    .participation-row--community .participation-row__layout { grid-template-columns: minmax(0, 1fr); gap: .34rem; }
    .participation-row :global(.btn) { margin-top: .32rem; }
  }
</style>
