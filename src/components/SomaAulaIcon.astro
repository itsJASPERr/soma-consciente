---
type SomaSymbol = 'heart' | 'sound' | 'horse' | 'body';
const { symbol } = Astro.props as { symbol: SomaSymbol };
---
<svg class="soma-aula-icon" viewBox="0 0 128 128" width="128" height="128" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
  {symbol === 'heart' && <>
    <path d="M64 27v73M64 50c-14-27-40-20-40 2 0 17 12 22 24 22M64 50c14-27 40-20 40 2 0 17-12 22-24 22" />
    <path d="M39 93c8-8 16-12 25-12s17 4 25 12M48 30c8 1 12 8 16 18M80 30c-8 1-12 8-16 18" />
    <circle cx="28" cy="76" r="4" fill="currentColor" stroke="none"/><circle cx="100" cy="76" r="4" fill="currentColor" stroke="none"/>
  </>}
  {symbol === 'sound' && <>
    <circle cx="64" cy="64" r="8"/><path d="M64 36c-20-1-31 9-32 28-1 18 12 31 30 33 22 2 39-14 40-35"/>
    <path d="M63 20c-30-1-48 15-48 44-1 27 20 49 47 49 30 0 52-23 52-52"/>
    <path d="M66 49c-9 0-14 6-14 15 0 8 5 13 13 13 9 0 14-6 14-15"/>
  </>}
  {symbol === 'horse' && <>
    <path d="M46 103c-5-13-7-26-6-35L29 53l14-19 15-3 10-16 9 14 6 17 16 16-7 21-21 3-7 17"/>
    <path d="m40 69 14-9 13 8M61 46c8 0 16 6 21 13M63 78c10 1 17 0 24-5"/>
    <circle cx="65" cy="49" r="2.5" fill="currentColor" stroke="none"/>
  </>}
  {symbol === 'body' && <>
    <circle cx="65" cy="35" r="13" fill="currentColor" stroke="none"/>
    <path d="M28 91c15-34 37-40 63-27M22 110c17-20 40-25 62-16M67 107c16-20 28-26 44-26" />
    <path d="M29 67c16-13 24-19 40-19" />
  </>}
</svg>
