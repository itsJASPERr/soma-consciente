---
import { offeringUrl, type Offering } from '../lib/offerings';

interface Props {
  offer: Offering;
  requestsEnabled: boolean;
  class?: string;
  showArrow?: boolean;
}

const { offer, requestsEnabled, class: actionClass = 'btn', showArrow = false } = Astro.props;
const url = offeringUrl(offer);
const hintId = url && offer.actionHint ? offer.slug + '-action-hint' : undefined;
const label = url && offer.slug === 'grupo-whatsapp' ? 'Unirme al grupo' : offer.action;
---
{url ? (
  <>
    <a class={actionClass} href={url} aria-describedby={hintId}>
      {label}
      {showArrow && <span aria-hidden="true">↗</span>}
    </a>
    {hintId && <p class="offering-action-hint" id={hintId}>{offer.actionHint}</p>}
  </>
) : requestsEnabled && (
  <button
    class={actionClass}
    type="button"
    data-offering-signup={offer.slug}
    data-signup-title={offer.title}
    data-signup-action={offer.action}
    data-signup-follow-up={offer.followUp}
    aria-haspopup="dialog"
    aria-controls="program-launch-dialog"
    hidden
  >
    {label}
    {showArrow && <span aria-hidden="true">↗</span>}
  </button>
)}

<style>
  button { cursor: pointer; font-family: inherit; text-align: left; }
  button[hidden] { display: none; }
  .offering-action-hint {
    margin: .5rem 0 0;
    max-inline-size: 40ch;
    font-size: .85rem;
    line-height: 1.4;
  }
  button.text-link { appearance: none; }
  .text-link {
    background: transparent;
    border: 0;
    color: var(--pine-dark);
    text-decoration: underline;
    text-underline-offset: .25em;
    min-block-size: 44px;
    padding: 0;
  }
</style>
