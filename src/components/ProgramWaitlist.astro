---
import { path } from '../lib/paths';

interface Props {
  signupEnabled: boolean;
}

const { signupEnabled } = Astro.props;
---
<section id="programa-online" class="program-waitlist" aria-labelledby="programa-online-title">
  <div>
    <p class="eyebrow">Próximamente</p>
    <h3 id="programa-online-title">Nuestro programa online</h3>
    <p class="program-waitlist__description">Estamos desarrollando nuestro propio programa online para acompañarte online.</p>
  </div>
  {signupEnabled && (
    <button
      id="program-launch-open"
      class="btn btn--outline"
      type="button"
      data-program-waitlist
      data-signup-title="Nuestro programa online"
      data-signup-intro="Dejanos tu contacto para recibir novedades cuando esté listo."
      data-signup-action="Avisame cuando esté listo"
      aria-haspopup="dialog"
      aria-controls="program-launch-dialog"
      hidden
    >
      Avisame cuando esté listo <span aria-hidden="true">↗</span>
    </button>
  )}
  <div class="program-waitlist__encounter">
    <div>
      <p class="eyebrow">Programas activos</p>
      <h3>Encuentros presenciales. Integración online.</h3>
      <p class="program-waitlist__description">Reunimos las cuatro miradas en el encuentro presencial y las seguimos en los círculos de integración online.</p>
    </div>
    <a class="btn btn--outline" href={path('/encuentros/')}>Ver encuentros <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .program-waitlist {
    max-inline-size: 52rem;
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--journey-rule, var(--line));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    text-align: start;
    justify-content: space-between;
    gap: .85rem 1.4rem;
    scroll-margin-top: 1.5rem;
  }
  .program-waitlist .eyebrow { margin-bottom: .35rem; }
  .program-waitlist h3 {
    color: var(--pine-dark);
    margin: 0 0 .4rem;
  }
  .program-waitlist__description {
    max-inline-size: 47ch;
    margin: 0;
    color: var(--ink);
    text-wrap: pretty;
  }
  .program-waitlist button {
    cursor: pointer;
    text-align: start;
    font-family: inherit;
  }
  .program-waitlist button[hidden] { display: none; }
  .program-waitlist__encounter {
    flex: 1 0 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .85rem 1.4rem;
    margin-top: .35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--journey-rule, var(--line));
  }
  .program-waitlist__encounter h3 { margin: 0 0 .4rem; }
</style>
