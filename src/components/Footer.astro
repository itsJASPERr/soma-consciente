---
import Brand from './Brand.astro';
import { path } from '../lib/paths';
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <Brand compact />
      <p>Cuatro caminos, un mismo núcleo.<br/>Un espacio para aprender, integrar y encontrarnos.</p>
    </div>
    <nav class="footer-links" aria-label="Enlaces del pie de página">
      <a href={path('/aulas/')}>Las cuatro Aulas</a>
      <a href={path('/nucleo/')}>El Núcleo</a>
      <a href={path('/biblioteca/')}>Biblioteca gratuita</a>
      <a href={path('/encuentros/')}>Encuentros</a>
    </nav>
    <div class="footer-note">
      <span>Con presencia, respeto y curiosidad.</span>
      <p>Los contenidos educativos y de bienestar no sustituyen atención médica o psicológica individual cuando es necesaria.</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <small>© {new Date().getFullYear()} SOMA CONSCIENTE</small>
    <small>Un camino de integración, presencia y consciencia</small>
    <a
      class="footer-admin-link"
      href="https://app.pagescms.org/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Administrar contenido en Pages CMS (abre en una pestaña nueva)"
    >Administrar contenido ↗</a>
  </div>
</footer>
<style>
  .footer-bottom { flex-wrap: wrap; align-items: center; }
  .footer-admin-link {
    color: inherit;
    font-size: .74rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .footer-admin-link:hover { color: var(--pine); }
</style>
