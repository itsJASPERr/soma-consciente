---
import { Icon } from 'astro-icon/components';
import Brand from './Brand.astro';
import { yaninaWhatsApp } from '../lib/offerings';
import { path } from '../lib/paths';
import { somaInstagram } from '../lib/site-identity';

---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <Brand compact />
      <p>Cuatro caminos, un mismo núcleo.<br/>Un espacio para aprender, integrar y encontrarnos.</p>
      <nav class="footer-social" aria-label="Redes y contacto">
        <a href={somaInstagram} aria-label="Instagram de SOMA Consciente">
          <span class="footer-social__icon"><Icon name="iconoir:instagram" size={18} aria-hidden="true" /></span>
          Instagram
        </a>
        {yaninaWhatsApp && (
          <a href={yaninaWhatsApp} aria-label="WhatsApp con Yanina">
            <span class="footer-social__icon"><Icon name="iconoir:whatsapp" size={18} aria-hidden="true" /></span>
            WhatsApp
          </a>
        )}
      </nav>
    </div>
    <nav class="footer-links" aria-label="Enlaces del pie de página">
      <a href={path('/encuentros/')}>Encuentros</a>
      <a href={path('/nucleo/')}>El Núcleo</a>
      <a href={path('/biblioteca/')}>Biblioteca gratuita</a>
    </nav>
    <div class="footer-note">
      <span>Con presencia, respeto y curiosidad.</span>
      <p>Los contenidos educativos y de bienestar no sustituyen atención médica o psicológica individual cuando es necesaria.</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <small>© {new Date().getFullYear()} SOMA CONSCIENTE</small>
    <nav class="footer-legal" aria-label="Información legal">
      <a href={path('/politica-de-privacidad/')}>Política de privacidad</a>
      <a href={path('/terminos-y-condiciones/')}>Términos y condiciones</a>
    </nav>
    <a
      class="footer-admin-link"
      href="https://app.pagescms.org/itsJASPERr/soma-consciente/main"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Administrar contenido en Pages CMS (abre en una pestaña nueva)"
    >Administrar contenido ↗</a>
  </div>
</footer>
<style>
  .footer-social, .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: .15rem 1.1rem;
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: .48rem;
    min-block-size: 2.75rem;
    color: var(--pine-dark);
    font-size: .85rem;
    font-weight: 700;
  }
  .footer-social__icon {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface-sage);
    color: var(--pine);
  }
  .footer-bottom {
    flex-wrap: wrap;
    align-items: center;
    gap: .3rem 1.3rem;
  }
  .footer-bottom small { font-size: inherit; }
  .footer-legal a, .footer-admin-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2rem;
  }
  .footer-admin-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .footer-social a:hover, .footer-legal a:hover, .footer-admin-link:hover {
    color: var(--pine);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 600px) {
    .footer-bottom { align-items: flex-start; }
  }
</style>
