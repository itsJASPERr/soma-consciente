---
import { getCountries, getCountryCallingCode } from 'libphonenumber-js/min';
import { offeringConsentText } from '../lib/waitlist-consent';

const collectsSignups = import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';

const regionNames = new Intl.DisplayNames('es', { type: 'region' });
const defaultCountry = 'AR';
const defaultDialingCode = getCountryCallingCode(defaultCountry);
const countries = getCountries()
  .map(code => ({ code, name: regionNames.of(code) ?? code, dialingCode: getCountryCallingCode(code) }))
  .sort((a, b) => a.name.localeCompare(b.name, 'es'));
---
<div class="program-signup">
  <dialog id="program-launch-dialog" class="program-signup__dialog" aria-labelledby="program-launch-title">
    <header class="program-signup__header">
      <div>
        <p class="eyebrow program-signup__status">Próximamente</p>
        <h3 id="program-launch-title">Participar en SOMA</h3>
      </div>
      <button id="program-launch-close" class="program-signup__close" type="button" aria-label="Cerrar"><span aria-hidden="true">×</span></button>
    </header>
    <p id="program-launch-offering" class="program-signup__offering"></p>
    <form id="program-launch-form" class="program-signup__form" method="post" data-collect={String(collectsSignups)}>
      <div class="program-signup__name">
        <label for="program-launch-name">Tu nombre</label>
        <input id="program-launch-name" name="name" autocomplete="name" placeholder="Nombre y apellido" required maxlength="120" autofocus />
      </div>
      <fieldset>
        <legend>¿Cómo querés que te avisemos?</legend>
        <div class="program-signup__channels">
          <label><input type="radio" name="channel" value="whatsapp" checked required /> WhatsApp</label>
          <label><input type="radio" name="channel" value="email" required /> Correo electrónico</label>
        </div>
      </fieldset>
      <div id="program-launch-contact-field" class="program-signup__contact" hidden>
        <div id="program-launch-country-field" class="program-signup__country" hidden>
          <label for="program-launch-country-toggle">País</label>
          <button
            id="program-launch-country-toggle"
            class="program-signup__country-toggle"
            type="button"
            aria-controls="program-launch-country-picker"
            aria-expanded="false"
            aria-label={'Código de país, ' + regionNames.of(defaultCountry) + ' (+' + defaultDialingCode + ')'}
          >
            <span id="program-launch-country-code">{defaultCountry} +{defaultDialingCode}</span>
          </button>
        </div>
        <div id="program-launch-country-picker" class="program-signup__country-picker" hidden>
          <input
            id="program-launch-country-search"
            type="text"
            role="combobox"
            aria-label="Buscar país o prefijo"
            aria-autocomplete="list"
            aria-controls="program-launch-country-options"
            aria-expanded="false"
            placeholder="Buscar país o prefijo"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
          />
          <ul id="program-launch-country-options" class="program-signup__country-options" role="listbox" aria-label="Países y prefijos">
            {countries.map(({ code, name, dialingCode }) => (
              <li
                id={'program-launch-option-' + code}
                role="option"
                aria-selected={code === defaultCountry ? 'true' : 'false'}
                data-country={code}
                data-name={name}
                data-dialing-code={dialingCode}
              >
                {name} (+{dialingCode})
              </li>
            ))}
          </ul>
          <p id="program-launch-country-empty" class="program-signup__country-empty" role="status" hidden>No encontramos países con esa búsqueda.</p>
        </div>
        <div class="program-signup__number">
          <label for="program-launch-contact">Tu contacto</label>
          <input id="program-launch-contact" name="contact" required maxlength="254" disabled />
        </div>
      </div>
      <label id="program-launch-contact-consent" class="program-signup__contact-consent" hidden>
        <input type="checkbox" name="contact-consent" value="yes" required disabled />
        <span>{offeringConsentText}</span>
      </label>
      {!collectsSignups && <p class="program-signup__note">Vista previa local. Los datos de esta prueba se descartan.</p>}
      <button class="btn" type="submit" disabled>Enviar solicitud</button>
    </form>
    <p id="program-launch-result" class="program-signup__result" role="status" tabindex="-1" hidden></p>
  </dialog>
</div>

<script>
  import { parsePhoneNumberFromString, type CountryCode } from 'libphonenumber-js/min';
  import {
    offeringConsentText,
    offeringConsentVersion,
    waitlistConsentText,
    waitlistConsentVersion,
  } from '../lib/waitlist-consent';

  type SignupChannel = 'whatsapp' | 'email';
  type WaitlistEvent = 'waitlist_opened' | 'waitlist_submitted';
  const analytics = window as Window & {
    umami?: { track(event: WaitlistEvent, properties?: { channel: SignupChannel }): unknown };
  };

  async function trackWaitlist(event: WaitlistEvent, properties?: { channel: SignupChannel }) {
    try {
      await analytics.umami?.track(event, properties);
    } catch {
      // A tracker failure must not interrupt the waitlist.
    }
  }

  const triggers = document.querySelectorAll<HTMLButtonElement>('button[data-offering-signup], button[data-program-waitlist]');
  const title = document.querySelector<HTMLElement>('#program-launch-title');
  const offeringLabel = document.querySelector<HTMLElement>('#program-launch-offering');
  const dialog = document.querySelector<HTMLDialogElement>('#program-launch-dialog');
  const close = document.querySelector<HTMLButtonElement>('#program-launch-close');
  const form = document.querySelector<HTMLFormElement>('#program-launch-form');
  const defaultChannel = form?.querySelector<HTMLInputElement>('input[name="channel"][checked]');
  const field = document.querySelector<HTMLElement>('#program-launch-contact-field');
  const contact = document.querySelector<HTMLInputElement>('#program-launch-contact');
  const nameInput = document.querySelector<HTMLInputElement>('#program-launch-name');
  const label = document.querySelector<HTMLLabelElement>('label[for="program-launch-contact"]');
  const countryField = document.querySelector<HTMLElement>('#program-launch-country-field');
  const countryToggle = document.querySelector<HTMLButtonElement>('#program-launch-country-toggle');
  const countryCode = document.querySelector<HTMLElement>('#program-launch-country-code');
  const countryPicker = document.querySelector<HTMLElement>('#program-launch-country-picker');
  const countrySearch = document.querySelector<HTMLInputElement>('#program-launch-country-search');
  const countryOptions = document.querySelector<HTMLElement>('#program-launch-country-options');
  const countryEmpty = document.querySelector<HTMLElement>('#program-launch-country-empty');
  const defaultOption = countryOptions?.querySelector<HTMLElement>('[aria-selected="true"]');
  const consentField = document.querySelector<HTMLLabelElement>('#program-launch-contact-consent');
  const contactConsent = consentField?.querySelector<HTMLInputElement>('input[type="checkbox"]');
  const consentCopy = consentField?.querySelector('span');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const result = document.querySelector<HTMLElement>('#program-launch-result');

  if (
    triggers.length && title && offeringLabel && dialog && close && form && defaultChannel && field && contact && nameInput && label && submit && result &&
    countryField && countryToggle && countryCode && countryPicker && countrySearch &&
    countryOptions && countryEmpty && defaultOption && consentField && contactConsent && consentCopy
  ) {
    const normalize = (value: string) => value.normalize('NFD').replace(/\p{M}/gu, '').trim().toLowerCase();
    const options = [...countryOptions.querySelectorAll<HTMLElement>('[data-country]')];
    let selectedOption = defaultOption;
    let matches: HTMLElement[] = [];
    let activeOption: HTMLElement | undefined;
    let submission: AbortController | undefined;
    let opener: HTMLButtonElement | undefined;
    let restoreScroll: number | undefined;

    const selectCountry = (option: HTMLElement) => {
      selectedOption.setAttribute('aria-selected', 'false');
      selectedOption = option;
      option.setAttribute('aria-selected', 'true');
      countryCode.textContent = option.dataset.country + ' +' + option.dataset.dialingCode;
      countryToggle.setAttribute('aria-label', 'Código de país, ' + option.textContent?.trim());
      contact.setCustomValidity('');
    };

    const highlightCountry = (option?: HTMLElement) => {
      delete activeOption?.dataset.highlighted;
      activeOption = option;

      if (!option) {
        countrySearch.removeAttribute('aria-activedescendant');
        return;
      }

      option.dataset.highlighted = '';
      countrySearch.setAttribute('aria-activedescendant', option.id);
      const optionBottom = option.offsetTop + option.offsetHeight;
      const listBottom = countryOptions.scrollTop + countryOptions.clientHeight;
      if (option.offsetTop < countryOptions.scrollTop) {
        countryOptions.scrollTop = option.offsetTop;
      } else if (optionBottom > listBottom) {
        countryOptions.scrollTop = optionBottom - countryOptions.clientHeight;
      }
    };

    const filterCountries = () => {
      const query = normalize(countrySearch.value);
      const dialingQuery = query.replace(/^\+/, '');
      matches = options.filter(option => {
        const matchesSearch = !query
          || normalize(option.dataset.name ?? '').includes(query)
          || option.dataset.country?.toLowerCase() === query
          || (/^\d+$/.test(dialingQuery) && option.dataset.dialingCode?.startsWith(dialingQuery));
        option.hidden = !matchesSearch;
        return matchesSearch;
      });
      countryEmpty.hidden = matches.length > 0;
      countryOptions.scrollTop = 0;
      highlightCountry(query ? matches[0] : selectedOption);
    };

    const closeCountryPicker = () => {
      countryPicker.hidden = true;
      countryToggle.setAttribute('aria-expanded', 'false');
      countrySearch.setAttribute('aria-expanded', 'false');
      highlightCountry();
    };

    const acceptCountry = (option: HTMLElement) => {
      selectCountry(option);
      closeCountryPicker();
      countryToggle.focus();
      syncSubmit();
    };

    countryToggle.addEventListener('mousedown', event => {
      if (!countryPicker.hidden) event.preventDefault();
    });
    countryToggle.addEventListener('click', () => {
      if (!countryPicker.hidden) {
        closeCountryPicker();
        countryToggle.focus();
        return;
      }

      countrySearch.value = '';
      countryPicker.hidden = false;
      countryToggle.setAttribute('aria-expanded', 'true');
      countrySearch.setAttribute('aria-expanded', 'true');
      filterCountries();
      countrySearch.focus();
    });

    countrySearch.addEventListener('input', filterCountries);
    countrySearch.addEventListener('blur', closeCountryPicker);
    countrySearch.addEventListener('keydown', event => {
      if (event.isComposing) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeCountryPicker();
        countryToggle.focus();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        if (activeOption) acceptCountry(activeOption);
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const index = activeOption ? matches.indexOf(activeOption) + step : 0;
        highlightCountry(matches[Math.max(0, Math.min(index, matches.length - 1))]);
      }
    });

    countryOptions.addEventListener('mousedown', event => {
      if (event.target instanceof Element && event.target.closest('[data-country]')) event.preventDefault();
    });
    countryOptions.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const option = event.target.closest<HTMLElement>('[data-country]');
      if (option) acceptCountry(option);
    });

    const syncSubmit = () => {
      submit.disabled = Boolean(submission) || !contactConsent.checked ||
        !nameInput.value.trim() || !contact.value.trim() || !contact.validity.valid;
    };

    const setChannel = (channel: string) => {
      const isWhatsApp = channel === 'whatsapp';
      contact.value = '';
      contact.setCustomValidity('');
      contact.type = isWhatsApp ? 'tel' : 'email';
      contact.autocomplete = isWhatsApp ? 'tel-national' : 'email';
      contact.placeholder = isWhatsApp ? 'Tu número' : 'tu@correo.com';
      label.textContent = isWhatsApp ? 'Tu número de WhatsApp' : 'Tu correo electrónico';
      closeCountryPicker();
      countryField.hidden = !isWhatsApp;
      field.dataset.channel = channel;
      contactConsent.checked = false;
      syncSubmit();
      result.hidden = true;
    };

    const resetForm = () => {
      form.reset();
      nameInput.setCustomValidity('');
      selectCountry(defaultOption);
      setChannel(defaultChannel.value);
    };

    for (const trigger of triggers) {
      trigger.addEventListener('click', () => {
        opener = trigger;
        const isProgramWaitlist = trigger.hasAttribute('data-program-waitlist');
        dialog.toggleAttribute('data-program-open', isProgramWaitlist);
        title.textContent = isProgramWaitlist
          ? trigger.dataset.signupTitle || 'Nuestro programa online'
          : trigger.dataset.signupAction || 'Participar en SOMA';
        offeringLabel.textContent = isProgramWaitlist
          ? trigger.dataset.signupIntro || ''
          : trigger.dataset.signupTitle || '';
        submit.textContent = isProgramWaitlist
          ? trigger.dataset.signupAction || 'Avisame cuando esté listo'
          : 'Enviar solicitud';
        consentCopy.textContent = isProgramWaitlist ? waitlistConsentText : offeringConsentText;
        const methodology = isProgramWaitlist && trigger.closest('#metodologia');
        const heading = methodology?.querySelector('#metodologia-title');
        if (heading instanceof HTMLElement) {
          restoreScroll = window.scrollY;
          heading.style.scrollMarginTop = '5.25rem';
          heading.scrollIntoView({ block: 'start', behavior: 'instant' });
        }
        dialog.showModal();
        if (heading instanceof HTMLElement) heading.scrollIntoView({ block: 'start', behavior: 'instant' });
        if (form.dataset.collect === 'true' && isProgramWaitlist) {
          void trackWaitlist('waitlist_opened');
        }
      });
      trigger.hidden = false;
    }
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      submission?.abort();
      submission = undefined;
      form.inert = false;
      resetForm();
      if (restoreScroll !== undefined) {
        window.scrollTo({ top: restoreScroll, behavior: 'instant' });
        restoreScroll = undefined;
      }
      opener?.focus({ preventScroll: true });
    });
    form.addEventListener('change', (event) => {
      const option = event.target;
      if (!(option instanceof HTMLInputElement) || option.name !== 'channel') return;
      setChannel(option.value);
    });

    nameInput.addEventListener('input', () => {
      nameInput.setCustomValidity('');
      syncSubmit();
    });
    contact.addEventListener('input', () => {
      contact.setCustomValidity('');
      syncSubmit();
    });
    contactConsent.addEventListener('change', syncSubmit);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const offering = opener?.dataset.offeringSignup;
      const isProgramWaitlist = opener?.hasAttribute('data-program-waitlist') === true;
      const followUp = opener?.dataset.signupFollowUp || 'Te contactaremos por el medio que elegiste.';
      if (submission || (!isProgramWaitlist && !offering) || !contactConsent.checked) return;

      const name = nameInput.value.trim();
      if (!name) {
        nameInput.setCustomValidity('Ingresá tu nombre.');
        nameInput.reportValidity();
        return;
      }

      if (contact.type === 'tel') {
        const number = parsePhoneNumberFromString(contact.value, {
          defaultCountry: selectedOption.dataset.country as CountryCode,
          extract: false,
        });
        const selectedCode = selectedOption.dataset.dialingCode;
        if (!number?.isPossible() || number.countryCallingCode !== selectedCode || number.ext) {
          contact.setCustomValidity('Ingresá un número de WhatsApp válido para el país que elegiste.');
          contact.reportValidity();
          return;
        }
      }

      const showResult = (message: string, state: 'success' | 'error' = 'success') => {
        result.dataset.state = state;
        result.textContent = message;
        result.hidden = false;
        result.focus();
      };

      if (form.dataset.collect !== 'true') {
        resetForm();
        showResult('Vista previa completada. Los datos de esta prueba se descartaron.');
        return;
      }

      const channel = contact.type === 'tel' ? 'whatsapp' : 'email';
      const currentSubmission = new AbortController();
      submission = currentSubmission;
      submit.disabled = true;
      result.hidden = true;
      form.inert = true;
      try {
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            offering,
            name,
            channel,
            contact: contact.value,
            country: channel === 'whatsapp' ? selectedOption.dataset.country : undefined,
            consent: isProgramWaitlist ? waitlistConsentVersion : offeringConsentVersion,
          }),
          signal: currentSubmission.signal,
        });
        if (!response.ok) throw new Error('Waitlist signup failed');
        if (currentSubmission.signal.aborted) return;
        resetForm();
        showResult(isProgramWaitlist
          ? 'Gracias. Te avisaremos por el medio que elegiste.'
          : 'Recibimos tu solicitud. ' + followUp);
        if (isProgramWaitlist) void trackWaitlist('waitlist_submitted', { channel });
      } catch {
        if (currentSubmission.signal.aborted) return;
        showResult('No pudimos guardar tu solicitud. Probá de nuevo en unos minutos.', 'error');
      } finally {
        if (submission === currentSubmission) {
          submission = undefined;
          form.inert = false;
          syncSubmit();
        }
      }
    });

    resetForm();
    contact.disabled = false;
    field.hidden = false;
    contactConsent.disabled = false;
    consentField.hidden = false;
  }
</script>

<style>
  .program-signup [hidden] {
    display: none;
  }
  .program-signup button {
    cursor: pointer;
    font-family: inherit;
  }
  :global(html:has(#program-launch-dialog[open])) {
    overflow: hidden;
  }
  .program-signup__dialog {
    inline-size: min(29rem, calc(100% - 2rem));
    max-block-size: calc(100dvh - 2rem);
    margin: auto;
    padding: clamp(1.1rem, 4vw, 1.75rem);
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--cream);
    color: var(--pine-dark);
    box-shadow: 0 18px 55px #17382f33;
    text-align: left;
  }
  .program-signup__dialog::backdrop {
    background: #142b25a6;
  }
  .program-signup__dialog[data-program-open] {
    margin: auto;
    border: 0;
    border-radius: 28px;
    background: var(--paper);
    box-shadow: 0 30px 80px #17382f55;
  }
  .program-signup__dialog[data-program-open]::backdrop { background: #19392f5c; }
  .program-signup__status { display: none; margin: 0 0 .3rem; }
  [data-program-open] .program-signup__status { display: block; }
  @media (max-width: 650px) {
    .program-signup__dialog[data-program-open] {
      inline-size: 100%;
      max-inline-size: none;
      max-block-size: min(92dvh, 100%);
      margin: auto 0 0;
      border-radius: 24px 24px 0 0;
    }
    .program-signup__dialog[data-program-open] .program-signup__form { gap: .7rem; }
  }
  @media (max-width: 650px) and (prefers-reduced-motion: no-preference) {
    .program-signup__dialog[open][data-program-open] { animation: waitlist-enter .18s ease-out; }
  }
  @keyframes waitlist-enter {
    from { opacity: 0; transform: translateY(.85rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  .program-signup__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: .75rem;
    margin-block-end: 1.1rem;
  }
  .program-signup__header h3 {
    margin: 0;
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    text-wrap: balance;
  }
  .program-signup__offering {
    margin: 0 0 1.1rem;
    color: var(--muted);
  }
  .program-signup__close {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--pine);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .program-signup__close:hover {
    background: var(--paper);
  }
  .program-signup__form {
    display: grid;
    gap: 1rem;
  }
  .program-signup fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .program-signup legend,
  .program-signup__contact label,
  .program-signup__name label {
    margin-block-end: .4rem;
    padding: 0;
    font-weight: 700;
  }
  .program-signup__channels {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem 1rem;
  }
  .program-signup__channels label {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-block-size: 2.75rem;
    cursor: pointer;
  }
  .program-signup__channels input {
    margin: 0;
    accent-color: var(--pine);
  }
  .program-signup__contact:not([hidden]) {
    display: grid;
    gap: .75rem;
  }
  .program-signup__contact[data-channel="whatsapp"] {
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: end;
  }
  .program-signup__contact[data-channel="whatsapp"] .program-signup__number {
    grid-column: 2;
    grid-row: 1;
  }
  .program-signup__contact label,
  .program-signup__name label {
    display: block;
    line-height: 1.3;
  }
  .program-signup__contact input,
  .program-signup__name input,
  .program-signup__country-toggle {
    inline-size: 100%;
    min-block-size: 2.75rem;
    padding-inline: .8rem;
    border: 1px solid var(--sage);
    border-radius: .55rem;
    background: var(--white);
    color: var(--ink);
    font: inherit;
  }
  .program-signup__country-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: .65rem;
    min-inline-size: 6.5rem;
    white-space: nowrap;
  }
  .program-signup__country-toggle::after {
    content: '';
    inline-size: .42rem;
    block-size: .42rem;
    margin-block-end: .2rem;
    border-inline-end: 1px solid currentColor;
    border-block-end: 1px solid currentColor;
    transform: rotate(45deg);
  }
  .program-signup__country-toggle[aria-expanded="true"]::after {
    transform: rotate(225deg);
  }
  .program-signup__country-picker {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  .program-signup__country-options {
    position: relative;
    max-block-size: 9rem;
    margin: .3rem 0 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    border-radius: .55rem;
    background: var(--white);
    list-style: none;
  }
  .program-signup__country-options:has(+ .program-signup__country-empty:not([hidden])) {
    border: 0;
    margin: 0;
  }
  .program-signup__country-options li {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: .3rem .8rem;
    cursor: pointer;
  }
  .program-signup__country-options li[aria-selected="true"] {
    font-weight: 700;
  }
  .program-signup__country-options li:is(:hover, [data-highlighted]) {
    background: #e4e9d8;
  }
  .program-signup__country-empty {
    margin: .4rem 0 0;
    color: var(--muted);
    font-size: .9rem;
  }
  .program-signup__contact :is(input, button):focus-visible,
  .program-signup__name input:focus-visible {
    outline: 2px solid var(--pine);
    outline-offset: 2px;
  }
  .program-signup__contact-consent {
    display: flex;
    align-items: start;
    gap: .55rem;
    color: var(--pine-dark);
    font-size: .9rem;
    line-height: 1.4;
    cursor: pointer;
  }
  .program-signup__contact-consent input {
    flex: none;
    inline-size: 1.05rem;
    block-size: 1.05rem;
    margin: .12rem 0 0;
    accent-color: var(--pine);
  }
  .program-signup__contact-consent input:focus-visible {
    outline: 2px solid var(--pine);
    outline-offset: 2px;
  }
  .program-signup__note,
  .program-signup__result {
