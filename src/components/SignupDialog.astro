---
import { getCountries, getCountryCallingCode } from 'libphonenumber-js/min';
import { offeringConsentText } from '../lib/waitlist-consent';
import { analyticsEnabled, circleCta, retreatCta } from '../lib/analytics';
import { retreatPaymentPlans, retreatPrice, retreatRebates, undecidedPayment } from '../lib/retreat-requests';
import { path } from '../lib/paths';

type RequestOptions = { href: string; receiptPage?: boolean } & (
  { kind: 'waitlist' } |
  ({ offering: string; whatsappUrl?: string } & ({ kind: 'retreat'; edition: string } | { kind: 'circle' }))
);

interface Props {
  request?: RequestOptions;
}

const { request } = Astro.props;
const retreat = request?.kind === 'retreat' ? request : undefined;
const offeringRequest = request?.kind === 'waitlist' ? undefined : request;
const waitlistReturn = request?.kind === 'waitlist' ? path('/#programa-online') : undefined;

const collectsSignups = import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';

const regionNames = new Intl.DisplayNames('es', { type: 'region' });
const defaultCountry = 'AR';
const defaultDialingCode = getCountryCallingCode(defaultCountry);
const countries = getCountries()
  .map(code => ({ code, name: regionNames.of(code) ?? code, dialingCode: getCountryCallingCode(code) }))
  .sort((a, b) => a.name.localeCompare(b.name, 'es'));
---
{request?.receiptPage && (
  <script is:inline define:vars={{ requestPath: request.href + 'solicitud/', isWaitlist: request.kind === 'waitlist' }}>
    const requestState = history.state?.somaRequest ?? history.state?.somaRetreat;
    if (!(isWaitlist ? requestState?.waitlistReceived : requestState?.receipt?.reference)) {
      history.replaceState(history.state, '', requestPath + location.search);
    }
  </script>
)}
<div class="program-signup">
  <dialog id="program-launch-dialog" class="program-signup__dialog" aria-labelledby="program-launch-title">
    <header class="program-signup__header">
      <div>
        <p class="eyebrow program-signup__status">Próximamente</p>
        <h3 id="program-launch-title" tabindex="-1" autofocus>Participar en SOMA</h3>
      </div>
      <button id="program-launch-close" class="program-signup__close" type="button" aria-label="Cerrar"><span aria-hidden="true">×</span></button>
    </header>
    <div class="program-signup__body" tabindex="0" role="region" aria-label="Contenido del formulario">
      <p id="program-launch-offering" class="program-signup__offering"></p>
      <form id="program-launch-form" class="program-signup__form" method="post" data-collect={String(collectsSignups)}
        data-retreat-edition={retreat?.edition} data-request-url={request?.href} data-request-offering={offeringRequest?.offering}
        data-waitlist-return={waitlistReturn} data-track-request={offeringRequest && analyticsEnabled ? 'true' : undefined}
      >
        {retreat && (
          <fieldset class="program-signup__payment">
            <legend>Preferencia de pago</legend>
            <div class="program-signup__plans">
              {retreatPaymentPlans.map(plan => (
                <label class="program-signup__choice">
                  <input type="radio" name="payment-plan" value={plan.id} />
                  <span>
                    <span class="program-signup__choice-label">{plan.label}</span>
                    <strong>{plan.payments > 1 ? plan.payments + ' × ' : ''}{retreatPrice(plan.amount)}</strong>
                    {plan.payments > 1 && <small>Total {retreatPrice(plan.payments * plan.amount)}</small>}
                  </span>
                </label>
              ))}
              <label class="program-signup__choice program-signup__choice--undecided">
                <input type="radio" name="payment-plan" value={undecidedPayment} checked />
                <span>Todavía no decidí</span>
              </label>
            </div>
          </fieldset>
          <fieldset class="program-signup__promotions">
            <legend>Promociones que querés consultar <span>Opcional</span></legend>
            {retreatRebates.map(rebate => (
              <label class="program-signup__choice">
                <input type="checkbox" name="rebates" value={rebate.id} />
                <span><strong>{rebate.discount}</strong><small>{rebate.label}</small></span>
              </label>
            ))}
            <p>Yanina confirma qué descuentos se aplican.</p>
          </fieldset>
        )}
        <div class="program-signup__name">
          <label for="program-launch-name">Tu nombre</label>
          <input id="program-launch-name" name="name" autocomplete="name" placeholder="Nombre y apellido" required maxlength="120" />
        </div>
        <fieldset>
          <legend>{offeringRequest ? "¿Cómo querés que te contactemos?" : "¿Cómo querés que te avisemos?"}</legend>
          <div class="program-signup__channels">
            <label><input type="radio" name="channel" value="whatsapp" checked required /> WhatsApp</label>
            <label><input type="radio" name="channel" value="email" required /> Correo electrónico</label>
          </div>
        </fieldset>
        <div id="program-launch-contact-field" class="program-signup__contact" hidden>
          <div id="program-launch-country-field" class="program-signup__country" hidden>
            <label for="program-launch-country-toggle">País</label>
            <button
              id="program-launch-country-toggle"
              class="program-signup__country-toggle"
              type="button"
              aria-controls="program-launch-country-picker"
              aria-expanded="false"
              aria-label={'Código de país, ' + regionNames.of(defaultCountry) + ' (+' + defaultDialingCode + ')'}
            >
              <span id="program-launch-country-code">{defaultCountry} +{defaultDialingCode}</span>
            </button>
          </div>
          <div id="program-launch-country-picker" class="program-signup__country-picker" hidden>
            <input
              id="program-launch-country-search"
              type="text"
              role="combobox"
              aria-label="Buscar país o prefijo"
              aria-autocomplete="list"
              aria-controls="program-launch-country-options"
              aria-expanded="false"
              placeholder="Buscar país o prefijo"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
            />
            <ul id="program-launch-country-options" class="program-signup__country-options" role="listbox" aria-label="Países y prefijos">
              {countries.map(({ code, name, dialingCode }) => (
                <li
                  id={'program-launch-option-' + code}
                  role="option"
                  aria-selected={code === defaultCountry ? 'true' : 'false'}
                  data-country={code}
                  data-name={name}
                  data-dialing-code={dialingCode}
                >
                  {name} (+{dialingCode})
                </li>
              ))}
            </ul>
            <p id="program-launch-country-empty" class="program-signup__country-empty" role="status" hidden>No encontramos países con esa búsqueda.</p>
          </div>
          <div class="program-signup__number">
            <label for="program-launch-contact">Tu contacto</label>
            <input id="program-launch-contact" name="contact" required maxlength="254" disabled />
          </div>
        </div>
        <div id="program-launch-contact-consent" class="program-signup__contact-consent" hidden>
          <input id="program-launch-consent" type="checkbox" name="contact-consent" value="yes" required disabled />
          <div>
            <label for="program-launch-consent"><span>{offeringConsentText}</span></label>
            {offeringRequest && (
              <p id="request-legal" hidden>
                Al marcar la casilla, acepto los
                {' '}<a href={path('/terminos-y-condiciones/')} target="_blank" rel="noopener">Términos y condiciones</a>
                {' '}y la <a href={path('/politica-de-privacidad/')} target="_blank" rel="noopener">Política de privacidad</a>.
              </p>
            )}
          </div>
        </div>
        {!collectsSignups && <p class="program-signup__note">Vista previa local. Los datos de esta prueba se descartan.</p>}
        <button class="btn" type="submit" disabled>Enviar solicitud</button>
      </form>
      <p id="program-launch-result" class="program-signup__result" role="status" tabindex="-1" hidden></p>
      {offeringRequest && (
        <div id="request-receipt" class="program-signup__receipt" hidden>
          <p>Tu referencia <strong id="request-reference"></strong></p>
          {offeringRequest.whatsappUrl && (
            <a class="btn" id="request-whatsapp" data-url={offeringRequest.whatsappUrl}
              {...(retreat ? retreatCta('whatsapp', 'retreat_confirmation', retreat.edition) : circleCta('whatsapp', 'circle_confirmation'))}
            >Continuar por WhatsApp <span aria-hidden="true">↗</span></a>
          )}
        </div>
      )}
    </div>
  </dialog>
</div>

<script>
  import { parsePhoneNumberFromString, type CountryCode } from 'libphonenumber-js/min';
  import {
    circleConsentVersion,
    offeringConsentText,
    offeringConsentVersion,
    retreatConsentVersion,
    waitlistConsentText,
    waitlistConsentVersion,
  } from '../lib/waitlist-consent';

  import { retreatPaymentLabel, retreatPaymentPlans, retreatRebates, retreatReference, undecidedPayment } from '../lib/retreat-requests';

  type SignupChannel = 'whatsapp' | 'email';
  type RequestReceipt = { reference: string; channel: SignupChannel; paymentPlan?: string | null; rebates?: string[] };
  type RequestHistory = { fromOffering?: boolean; fromRetreat?: boolean; receipt?: RequestReceipt; waitlistReceived?: true };
  type SignupEvent = 'waitlist_opened' | 'waitlist_submitted' | 'retreat_request_submitted' | 'circle_request_submitted';
  type SignupProperties = { channel: SignupChannel; retreat_edition?: string; payment_plan?: string };
  const analytics = window as Window & {
    umami?: { track(event: SignupEvent, properties?: SignupProperties): unknown };
  };

  async function trackSignup(event: SignupEvent, properties?: SignupProperties) {
    try {
      await analytics.umami?.track(event, properties);
    } catch {
      // A tracker failure must not interrupt the waitlist.
    }
  }

  const triggers = document.querySelectorAll<HTMLButtonElement>('button[data-offering-signup], button[data-program-waitlist]');
  const title = document.querySelector<HTMLElement>('#program-launch-title');
  const offeringLabel = document.querySelector<HTMLElement>('#program-launch-offering');
  const dialog = document.querySelector<HTMLDialogElement>('#program-launch-dialog');
  const close = document.querySelector<HTMLButtonElement>('#program-launch-close');
  const form = document.querySelector<HTMLFormElement>('#program-launch-form');
  const defaultChannel = form?.querySelector<HTMLInputElement>('input[name="channel"][checked]');
  const field = document.querySelector<HTMLElement>('#program-launch-contact-field');
  const contact = document.querySelector<HTMLInputElement>('#program-launch-contact');
  const nameInput = document.querySelector<HTMLInputElement>('#program-launch-name');
  const label = document.querySelector<HTMLLabelElement>('label[for="program-launch-contact"]');
  const countryField = document.querySelector<HTMLElement>('#program-launch-country-field');
  const countryToggle = document.querySelector<HTMLButtonElement>('#program-launch-country-toggle');
  const countryCode = document.querySelector<HTMLElement>('#program-launch-country-code');
  const countryPicker = document.querySelector<HTMLElement>('#program-launch-country-picker');
  const countrySearch = document.querySelector<HTMLInputElement>('#program-launch-country-search');
  const countryOptions = document.querySelector<HTMLElement>('#program-launch-country-options');
  const countryEmpty = document.querySelector<HTMLElement>('#program-launch-country-empty');
  const defaultOption = countryOptions?.querySelector<HTMLElement>('[aria-selected="true"]');
  const consentField = document.querySelector<HTMLElement>('#program-launch-contact-consent');
  const contactConsent = consentField?.querySelector<HTMLInputElement>('input[type="checkbox"]');
  const consentCopy = consentField?.querySelector('span');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const paymentOptions = [...(form?.querySelectorAll<HTMLInputElement>('input[name="payment-plan"]') ?? [])];
  const scrollBody = dialog?.querySelector<HTMLElement>('.program-signup__body');
  const legal = document.querySelector<HTMLElement>('#request-legal');
  const receipt = document.querySelector<HTMLElement>('#request-receipt');
  const referenceLabel = document.querySelector<HTMLElement>('#request-reference');
  const handoff = document.querySelector<HTMLAnchorElement>('#request-whatsapp');
  const result = document.querySelector<HTMLElement>('#program-launch-result');

  if (
    triggers.length && title && offeringLabel && dialog && close && form && defaultChannel && field && contact && nameInput && label && submit && result && scrollBody &&
    countryField && countryToggle && countryCode && countryPicker && countrySearch &&
    countryOptions && countryEmpty && defaultOption && consentField && contactConsent && consentCopy
  ) {
    const normalize = (value: string) => value.normalize('NFD').replace(/\p{M}/gu, '').trim().toLowerCase();
    const options = [...countryOptions.querySelectorAll<HTMLElement>('[data-country]')];
    let selectedOption = defaultOption;
    let matches: HTMLElement[] = [];
    let activeOption: HTMLElement | undefined;
    let submission: AbortController | undefined;
    let opener: HTMLButtonElement | undefined;
    let restoreUrlOnClose = true;
    const waitlistReturn = form.dataset.waitlistReturn;
    const requestTrigger = [...triggers].find(trigger => waitlistReturn
      ? trigger.hasAttribute('data-program-waitlist')
      : trigger.dataset.offeringSignup === form.dataset.requestOffering);
    const offeringUrl = form.dataset.requestUrl;
    const requestPath = offeringUrl ? offeringUrl + 'solicitud/' : undefined;
    const receiptPath = requestPath ? requestPath + 'recibida/' : undefined;
    const currentRequestState = () => {
      const state = history.state as { somaRequest?: RequestHistory; somaRetreat?: RequestHistory } | null;
      return state?.somaRequest ?? state?.somaRetreat;
    };
    const isRequestPath = () => Boolean(requestPath && (location.pathname === requestPath || location.pathname === receiptPath));


    const selectCountry = (option: HTMLElement) => {
      selectedOption.setAttribute('aria-selected', 'false');
      selectedOption = option;
      option.setAttribute('aria-selected', 'true');
      countryCode.textContent = option.dataset.country + ' +' + option.dataset.dialingCode;
      countryToggle.setAttribute('aria-label', 'Código de país, ' + option.textContent?.trim());
      contact.setCustomValidity('');
    };

    const highlightCountry = (option?: HTMLElement) => {
      delete activeOption?.dataset.highlighted;
      activeOption = option;

      if (!option) {
        countrySearch.removeAttribute('aria-activedescendant');
        return;
      }

      option.dataset.highlighted = '';
      countrySearch.setAttribute('aria-activedescendant', option.id);
      const optionBottom = option.offsetTop + option.offsetHeight;
      const listBottom = countryOptions.scrollTop + countryOptions.clientHeight;
      if (option.offsetTop < countryOptions.scrollTop) {
        countryOptions.scrollTop = option.offsetTop;
      } else if (optionBottom > listBottom) {
        countryOptions.scrollTop = optionBottom - countryOptions.clientHeight;
      }
    };

    const filterCountries = () => {
      const query = normalize(countrySearch.value);
      const dialingQuery = query.replace(/^\+/, '');
      matches = options.filter(option => {
        const matchesSearch = !query
          || normalize(option.dataset.name ?? '').includes(query)
          || option.dataset.country?.toLowerCase() === query
          || (/^\d+$/.test(dialingQuery) && option.dataset.dialingCode?.startsWith(dialingQuery));
        option.hidden = !matchesSearch;
        return matchesSearch;
      });
      countryEmpty.hidden = matches.length > 0;
      countryOptions.scrollTop = 0;
      highlightCountry(query ? matches[0] : selectedOption);
    };

    const closeCountryPicker = () => {
      countryPicker.hidden = true;
      countryToggle.setAttribute('aria-expanded', 'false');
      countrySearch.setAttribute('aria-expanded', 'false');
      highlightCountry();
    };

    const acceptCountry = (option: HTMLElement) => {
      selectCountry(option);
      closeCountryPicker();
      countryToggle.focus();
      syncSubmit();
    };

    countryToggle.addEventListener('mousedown', event => {
      if (!countryPicker.hidden) event.preventDefault();
    });
    countryToggle.addEventListener('click', () => {
      if (!countryPicker.hidden) {
        closeCountryPicker();
        countryToggle.focus();
        return;
      }

      countrySearch.value = '';
      countryPicker.hidden = false;
      countryToggle.setAttribute('aria-expanded', 'true');
      countrySearch.setAttribute('aria-expanded', 'true');
      filterCountries();
      countrySearch.focus();
    });

    countrySearch.addEventListener('input', filterCountries);
    countrySearch.addEventListener('blur', closeCountryPicker);
    countrySearch.addEventListener('keydown', event => {
      if (event.isComposing) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeCountryPicker();
        countryToggle.focus();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        if (activeOption) acceptCountry(activeOption);
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const index = activeOption ? matches.indexOf(activeOption) + step : 0;
        highlightCountry(matches[Math.max(0, Math.min(index, matches.length - 1))]);
      }
    });

    countryOptions.addEventListener('mousedown', event => {
      if (event.target instanceof Element && event.target.closest('[data-country]')) event.preventDefault();
    });
    countryOptions.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const option = event.target.closest<HTMLElement>('[data-country]');
      if (option) acceptCountry(option);
    });

    const syncSubmit = () => {
      submit.disabled = Boolean(submission) || !contactConsent.checked ||
        !nameInput.value.trim() || !contact.value.trim() || !contact.validity.valid;
    };

    const setChannel = (channel: string) => {
      const isWhatsApp = channel === 'whatsapp';
      contact.value = '';
      contact.setCustomValidity('');
      contact.type = isWhatsApp ? 'tel' : 'email';
      contact.autocomplete = isWhatsApp ? 'tel-national' : 'email';
      contact.placeholder = isWhatsApp ? 'Tu número' : 'tu@correo.com';
      label.textContent = isWhatsApp ? 'Tu número de WhatsApp' : 'Tu correo electrónico';
      closeCountryPicker();
      countryField.hidden = !isWhatsApp;
      field.dataset.channel = channel;
      contactConsent.checked = false;
      syncSubmit();
      result.hidden = true;
    };

    const resetForm = () => {
      form.reset();
      form.hidden = false;
      if (receipt) receipt.hidden = true;
      handoff?.removeAttribute('href');
      if (referenceLabel) referenceLabel.textContent = '';
      nameInput.setCustomValidity('');
      selectCountry(defaultOption);
      setChannel(defaultChannel.value);
    };

    const openDialog = (trigger: HTMLButtonElement, fromHistory = false) => {
      if (dialog.open || dialog.hasAttribute('data-closing')) return;
      opener = trigger;
      const isProgramWaitlist = trigger.hasAttribute('data-program-waitlist');
      dialog.toggleAttribute('data-program-open', isProgramWaitlist);
      title.textContent = isProgramWaitlist
        ? trigger.dataset.signupTitle || 'Nuestro programa online'
        : trigger.dataset.signupAction || 'Participar en SOMA';
      offeringLabel.textContent = isProgramWaitlist
        ? trigger.dataset.signupIntro || ''
        : trigger.dataset.signupTitle || '';
      offeringLabel.hidden = false;
      submit.textContent = isProgramWaitlist
        ? trigger.dataset.signupAction || 'Avisame cuando esté listo'
        : 'Enviar solicitud';
      consentCopy.textContent = isProgramWaitlist ? waitlistConsentText : offeringConsentText;
      const payment = paymentOptions.find(option => option.value === (trigger.dataset.paymentPlan || undecidedPayment));
      if (payment) payment.checked = true;
      const usesReceipt = Boolean(form.dataset.requestOffering && trigger.dataset.offeringSignup === form.dataset.requestOffering);
      if (legal) legal.hidden = !usesReceipt;
      if (usesReceipt) contactConsent.setAttribute('aria-describedby', 'request-legal');
      else contactConsent.removeAttribute('aria-describedby');
      if ((usesReceipt || (isProgramWaitlist && waitlistReturn)) && requestPath && !fromHistory && !isRequestPath()) {
        history.pushState({ somaRequest: { fromOffering: true } }, '', requestPath + location.search);
      }
      trigger.focus({ preventScroll: true });
      dialog.showModal();
      scrollBody.scrollTop = 0;
      if (form.dataset.collect === 'true' && isProgramWaitlist && !currentRequestState()?.waitlistReceived) {
        void trackSignup('waitlist_opened');
      }
    };

    for (const trigger of triggers) {
      trigger.addEventListener('click', () => openDialog(trigger));
      trigger.hidden = false;
    }
    const closeDialog = (restoreUrl = true) => {
      if (!dialog.open || dialog.hasAttribute('data-closing')) return;
      restoreUrlOnClose = restoreUrl;
      submission?.abort();
      dialog.setAttribute('data-closing', '');
      void getComputedStyle(dialog).opacity;
      const transitions = dialog.getAnimations({ subtree: true });
      if (transitions.length === 0) {
        dialog.close();
        return;
      }
      void Promise.allSettled(transitions.map(transition => transition.finished)).then(() => dialog.close());
    };

    close.addEventListener('click', () => closeDialog());
    dialog.addEventListener('cancel', event => {
      event.preventDefault();
      closeDialog();
    });
    dialog.addEventListener('close', () => {
      submission?.abort();
      submission = undefined;
      form.inert = false;
      resetForm();
      const closedTrigger = opener;
      closedTrigger?.focus({ preventScroll: true });
      opener = undefined;
      dialog.removeAttribute('data-closing');
      if (!restoreUrlOnClose) {
        if (isRequestPath()) openFromLocation();
        return;
      }
      if (offeringUrl && isRequestPath()) {
        const state = currentRequestState();
        if (state?.fromOffering || state?.fromRetreat) {
          window.addEventListener('popstate', () => {
            // Back to a section anchor can move focus after the dialog closes.
            window.requestAnimationFrame(() => closedTrigger?.focus({ preventScroll: true }));
          }, { once: true });
          history.back();
        } else if (waitlistReturn) {
          const returnUrl = new URL(waitlistReturn, location.origin);
          returnUrl.search = location.search;
          location.replace(returnUrl);
        } else history.replaceState(null, '', offeringUrl + location.search);
      }
    });
    form.addEventListener('change', (event) => {
      const option = event.target;
      if (!(option instanceof HTMLInputElement) || option.name !== 'channel') return;
      setChannel(option.value);
    });

    nameInput.addEventListener('input', () => {
      nameInput.setCustomValidity('');
      syncSubmit();
    });
    contact.addEventListener('input', () => {
      contact.setCustomValidity('');
      syncSubmit();
    });
    contactConsent.addEventListener('change', syncSubmit);

    const showResult = (message: string, state: 'success' | 'error' = 'success') => {
      result.dataset.state = state;
      result.textContent = message;
      result.hidden = false;
      result.focus();
    };

    const renderReceipt = ({ reference, channel, paymentPlan, rebates }: RequestReceipt) => {
      if (!receipt || !referenceLabel) return;
      form.hidden = true;
      title.textContent = 'Recibimos tu solicitud';
      referenceLabel.textContent = reference;
      if (handoff?.dataset.url) {
        const url = new URL(handoff.dataset.url);
        const savedPlan = retreatPaymentPlans.find(plan => plan.id === paymentPlan);
        const plan = savedPlan ? ' Mi preferencia de pago es ' + retreatPaymentLabel(savedPlan) + '.' : '';
        const promotions = retreatRebates.filter(rebate => rebates?.includes(rebate.id));
        const rebateNote = promotions.length
          ? ' Quisiera consultar por: ' + promotions.map(rebate => rebate.label + ' (' + rebate.discount + ')').join(' y ') + '.'
          : '';
        const activity = form.dataset.retreatEdition
          ? 'el retiro del ' + (opener?.dataset.retreatDate ?? '')
          : 'participar en el círculo de integración online';
        url.searchParams.set('text', 'Hola, Yanina. Envié mi solicitud para ' +
          activity + '. Mi referencia es ' + reference + '.' + plan + rebateNote);
        handoff.href = url.href;
      }
      receipt.hidden = false;
      const nextStep = form.dataset.retreatEdition
        ? ' para confirmar disponibilidad y coordinar la inscripción.'
        : ' para compartirte los horarios y los pasos para sumarte al círculo.';
      showResult('Yanina te va a contactar por ' + (channel === 'whatsapp' ? 'WhatsApp' : 'correo electrónico') + nextStep);
      scrollBody.scrollTop = 0;
    };

    const renderWaitlistReceipt = () => {
      resetForm();
      form.hidden = true;
      offeringLabel.hidden = true;
      title.textContent = 'Te anotaste en la lista';
      showResult('Gracias. Te avisaremos por el medio que elegiste.');
      scrollBody.scrollTop = 0;
    };

    function openFromLocation() {
      if (!requestPath || !receiptPath || !requestTrigger) return;
      if (!isRequestPath()) {
        closeDialog(false);
        return;
      }
      if (dialog.hasAttribute('data-closing')) return;
      const receiptState = location.pathname === receiptPath ? currentRequestState() : undefined;
      const savedReceipt = receiptState?.receipt;
      const hasReceipt = savedReceipt && retreatReference.test(savedReceipt.reference);
      const waitlistReceived = waitlistReturn && receiptState?.waitlistReceived;
      if (location.pathname === receiptPath && !hasReceipt && !waitlistReceived) {
        history.replaceState(null, '', requestPath + location.search);
      }
      openDialog(requestTrigger, true);
      if (hasReceipt) renderReceipt(savedReceipt);
      if (waitlistReceived) renderWaitlistReceipt();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const offering = opener?.dataset.offeringSignup;
      const usesReceipt = Boolean(offering && offering === form.dataset.requestOffering);
      const isProgramWaitlist = opener?.hasAttribute('data-program-waitlist') === true;
      const followUp = opener?.dataset.signupFollowUp || 'Te contactaremos por el medio que elegiste.';
      if (submission || (!isProgramWaitlist && !offering) || !contactConsent.checked) return;

      const name = nameInput.value.trim();
      if (!name) {
        nameInput.setCustomValidity('Ingresá tu nombre.');
        nameInput.reportValidity();
        return;
      }

      if (contact.type === 'tel') {
        const number = parsePhoneNumberFromString(contact.value, {
          defaultCountry: selectedOption.dataset.country as CountryCode,
          extract: false,
        });
        const selectedCode = selectedOption.dataset.dialingCode;
        if (!number?.isPossible() || number.countryCallingCode !== selectedCode || number.ext) {
          contact.setCustomValidity('Ingresá un número de WhatsApp válido para el país que elegiste.');
          contact.reportValidity();
          return;
        }
      }

      if (form.dataset.collect !== 'true') {
        resetForm();
        showResult('Vista previa completada. Los datos de esta prueba se descartaron.');
        return;
      }

      const channel = contact.type === 'tel' ? 'whatsapp' : 'email';
      const paymentPlan = paymentOptions.find(option => option.checked)?.value;
      const rebates = paymentPlan ? new FormData(form).getAll('rebates') : undefined;
      const currentSubmission = new AbortController();
      submission = currentSubmission;
      submit.disabled = true;
      result.hidden = true;
      form.inert = true;
      try {
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            offering,
            paymentPlan,
            rebates,
            name,
            channel,
            contact: contact.value,
            country: channel === 'whatsapp' ? selectedOption.dataset.country : undefined,
            consent: paymentPlan ? retreatConsentVersion
              : usesReceipt ? circleConsentVersion
              : isProgramWaitlist ? waitlistConsentVersion : offeringConsentVersion,
          }),
          signal: currentSubmission.signal,
        });
        if (!response.ok) throw new Error('Waitlist signup failed');
        if (currentSubmission.signal.aborted) return;
        const edition = form.dataset.retreatEdition;
        if (usesReceipt && receipt && referenceLabel) {
          const { reference, paymentPlan: savedPaymentPlan, rebates: savedRebates } = await response.json() as {
            reference?: string; paymentPlan?: string | null; rebates?: string[];
          };
          if (currentSubmission.signal.aborted) return;
          if (typeof reference !== 'string' || !retreatReference.test(reference)) throw new Error('Missing request reference');

          const savedReceipt = { reference, channel, paymentPlan: savedPaymentPlan, rebates: savedRebates };
          if (receiptPath) {
            const somaRequest = { ...currentRequestState(), receipt: savedReceipt };
            history.replaceState({ somaRequest }, '', receiptPath + location.search);
          }
          renderReceipt(savedReceipt);
          if (response.status === 201 && form.dataset.trackRequest === 'true') {
            if (edition) {
              void trackSignup('retreat_request_submitted', { channel, retreat_edition: edition, payment_plan: paymentPlan });
            } else {
              void trackSignup('circle_request_submitted', { channel });
            }
          }
          return;
        }
        if (isProgramWaitlist) {
          if (receiptPath) {
            const somaRequest = { ...currentRequestState(), waitlistReceived: true };
            history.replaceState({ somaRequest }, '', receiptPath + location.search);
          }
          renderWaitlistReceipt();
          void trackSignup('waitlist_submitted', { channel });
          return;
        }
        resetForm();
        showResult('Recibimos tu solicitud. ' + followUp);
      } catch {
        if (currentSubmission.signal.aborted) return;
        showResult('No pudimos guardar tu solicitud. Probá de nuevo en unos minutos.', 'error');
      } finally {
        if (submission === currentSubmission) {
          submission = undefined;
          form.inert = false;
          syncSubmit();
        }
      }
    });

    resetForm();
    contact.disabled = false;
    field.hidden = false;
    contactConsent.disabled = false;
    consentField.hidden = false;
    if (requestPath) {
      window.addEventListener('popstate', openFromLocation);
      openFromLocation();
    }
  }
</script>

