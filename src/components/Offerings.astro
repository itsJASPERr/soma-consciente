---
import { offeringUrl, type Offering } from '../lib/offerings';
import OfferingAction from './OfferingAction.astro';
import { path } from '../lib/paths';
import SignupDialog from './SignupDialog.astro';

interface Props {
  offers: Offering[];
  image?: { src: string; alt: string };
}

const { offers, image } = Astro.props;
const requestsEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const hasRequests = requestsEnabled && offers.some(offer => !offeringUrl(offer));
---
<div class="offerings-grid">
  {offers.map((offer) => {
    const url = offeringUrl(offer);
    const featured = offer.slug === 'encuentro-enero';
    return (
      <article id={offer.slug} class:list={['offering', { 'offering--featured': featured }]} aria-labelledby={offer.slug + '-title'}>
        <div class="offering__copy">
          {offer.when && <p class="offering__when">{offer.when}</p>}
          <h3 id={offer.slug + '-title'}>{offer.title}</h3>
          <p>{offer.description}</p>
          {(offer.details || offer.venue) && <p class="offering__details">{[offer.venue, offer.details].filter(Boolean).join(' · ')}</p>}
          {featured && <a class="text-link offering__integration" href={path('/acompanamiento/#circulos')}>Conocer los círculos incluidos <span aria-hidden="true">↗</span></a>}
          <OfferingAction offer={offer} requestsEnabled={requestsEnabled} />
          {!url && requestsEnabled && offer.followUp && <p class="offering__next">{offer.followUp}</p>}
        </div>
        {featured && image?.src && (
          <img class="offering__image" src={image.src} alt={image.alt} width="1100" height="780" loading="lazy" decoding="async" />
        )}
      </article>
    );
  })}
</div>
{hasRequests && <SignupDialog />}

<style>
  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1rem, 2.5vw, 1.65rem);
  }
  .offering {
    display: flex;
    min-inline-size: 0;
    scroll-margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--cream);
  }
  .offering--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    background: #e8ecdf;
  }
  .offering__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.3rem, 4vw, 2.5rem);
  }
  .offering__when {
    margin-bottom: .55rem;
    color: var(--pine);
    font-size: .92rem;
    font-weight: 700;
  }
  .offering h3 {
    margin-bottom: .7rem;
    color: var(--pine-dark);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    text-wrap: balance;
  }
  .offering--featured h3 { font-size: clamp(1.9rem, 4.15vw, 3.65rem); }
  .offering p { max-inline-size: 48ch; }
  .offering__details {
    color: var(--pine-dark);
    font-weight: 700;
  }
  .offering__copy :global(.btn) { margin-top: auto; }
  .offering__integration { margin-bottom: 1rem; }
  .offering__next {
    color: var(--pine-dark);
    font-size: .85rem;
    margin: .5rem 0 0;
  }
  .offering__image {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 15rem;
    max-block-size: 25rem;
    object-fit: cover;
  }
  @media (max-width: 680px) {
    .offering--featured { display: flex; flex-direction: column; }
    .offering__image { block-size: 12rem; min-block-size: 0; }
  }
</style>
