---
import { offeringUrl, type Offering } from '../lib/offerings';
import OfferingAction from './OfferingAction.astro';
import { path } from '../lib/paths';
import SignupDialog from './SignupDialog.astro';

interface Props {
  offers: Offering[];
  image?: { src: string; alt: string };
  pictures?: Record<string, { src: string; alt: string }>;
}

const { offers, image, pictures = {} } = Astro.props;
const requestsEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_WAITLIST_ENABLED === 'true';
const hasRequests = requestsEnabled && offers.some(offer => !offeringUrl(offer));
---
<div class="offerings-grid">
  {offers.map((offer) => {
    const featured = offer.slug === 'encuentro-enero';
    const picture = pictures[offer.slug];
    const place = [offer.venue, offer.details].filter(Boolean).join(' · ');
    return (
      <article id={offer.slug} class:list={['offering', { 'offering--featured': featured }]} aria-labelledby={offer.slug + '-title'}>
        {picture?.src && (
          <img class="offering__image" src={picture.src} alt={picture.alt} width="1100" height="780" loading="lazy" decoding="async" />
        )}
        <div class="offering__copy">
          {featured && <p class="offering__kicker">Encuentros</p>}
          {offer.slug === 'grupo-whatsapp' && offer.details && <p class="offering__kicker">{offer.details}</p>}
          <h3 id={offer.slug + '-title'}>{offer.title}</h3>
          {offer.when && offer.slug !== 'circulos' && <p class="offering__when">{offer.when}</p>}
          {featured && offer.venue && <p class="offering__venue">{offer.venue}</p>}
          <p>{offer.description}</p>
          {featured && offer.details && (
            <div class="offering__includes">
              <p class="offering__includes-label">Qué incluye</p>
              <p>{offer.details}</p>
            </div>
          )}
          {!featured && place && offer.slug !== 'circulos' && offer.slug !== 'grupo-whatsapp' && <p class="offering__details">{place}</p>}
          {offer.slug === 'circulos' && offer.details && <p class="offering__details">{offer.details}</p>}
          {offer.slug === 'circulos' && offer.when && <p class="offering__when">{offer.when}</p>}
          {featured && <a class="text-link offering__integration" href={path('/acompanamiento/#circulos')}>Conocer los círculos incluidos <span aria-hidden="true">↗</span></a>}
          <OfferingAction offer={offer} requestsEnabled={requestsEnabled} />
          {offer.followUp && <p class="offering__next">{offer.followUp}</p>}
          {offer.context && <p class="offering__next">{offer.context}</p>}
          {offer.pending && <p class="offering__pending">{offer.pending}</p>}
        </div>
        {featured && image?.src && (
          <img class="offering__image" src={image.src} alt={image.alt} width="1100" height="780" loading="lazy" decoding="async" />
        )}
      </article>
    );
  })}
</div>
{hasRequests && <SignupDialog />}

<style>
  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1rem, 2.5vw, 1.65rem);
  }
  .offering {
    display: flex;
    min-inline-size: 0;
    scroll-margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--cream);
  }
  .offering--featured,
  .offering--featured + .offering {
    grid-column: 1 / -1;
  }
  .offering--featured {
    background: #e8ecdf;
  }
  .offering--featured + .offering {
    max-inline-size: 36rem;
  }
  .offering:not(.offering--featured) {
    flex-direction: column;
  }
  .offering__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.3rem, 4vw, 2.5rem);
  }
  .offering__kicker {
    margin: 0 0 .35rem;
    color: var(--terra);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .offering__when {
    margin-bottom: .55rem;
    color: var(--pine);
    font-size: .92rem;
    font-weight: 700;
  }
  .offering--featured .offering__when {
    color: var(--terra);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
  }
  .offering h3 {
    margin-bottom: .7rem;
    color: var(--pine-dark);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    text-wrap: balance;
  }
  .offering--featured h3 { font-size: clamp(1.9rem, 4.15vw, 3.65rem); }
  .offering p { max-inline-size: 48ch; }
  .offering__venue {
    color: var(--pine);
    margin-bottom: .6rem;
  }
  .offering__details {
    color: var(--pine-dark);
    font-weight: 700;
  }
  .offering__includes {
    margin: .2rem 0 1rem;
    padding: .85rem 1rem;
    border-radius: 16px;
    background: #f7f1e8;
  }
  .offering__includes p { margin: 0; }
  .offering__includes-label {
    margin-bottom: .25rem;
    color: var(--pine-dark);
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .offering__copy :global(.btn) { margin-top: auto; }
  .offering__integration { margin-bottom: 1rem; }
  .offering__next,
  .offering__pending {
    color: var(--pine-dark);
    font-size: .85rem;
    margin: .5rem 0 0;
    text-wrap: pretty;
  }
  .offering__pending { color: var(--muted); }
  .offering__image {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 15rem;
    max-block-size: 25rem;
    object-fit: cover;
  }
  .offering:not(.offering--featured) .offering__image {
    block-size: 13rem;
    min-block-size: 0;
    max-block-size: none;
  }
  @media (max-width: 680px) {
    .offering__image { block-size: 12rem; min-block-size: 0; }
  }
</style>
