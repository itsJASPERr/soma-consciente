---
import SomaAulaIcon from './SomaAulaIcon.astro';
const { id = 'soma', decorative = false } = Astro.props as { id?: string; decorative?: boolean };
---
<svg class="soma-mark" viewBox="0 0 640 600" fill="none" role={decorative ? undefined : 'img'} aria-hidden={decorative ? 'true' : undefined} aria-label={decorative ? undefined : 'Símbolo de SOMA: cuatro Aulas conectadas por un Núcleo orgánico'}>
  <defs>
    <linearGradient id={id + '-core'} x1="235" y1="200" x2="438" y2="400" gradientUnits="userSpaceOnUse">
      <stop stop-color="#064b36"/><stop offset=".42" stop-color="#0a3d2b"/><stop offset=".66" stop-color="#b56735"/><stop offset="1" stop-color="#eb5c36"/>
    </linearGradient>
    <pattern id={id + '-seeds'} width="23" height="22" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="8" r="1.2" fill="#efd19d" opacity=".78"/><circle cx="18" cy="3" r=".8" fill="#eaa04f" opacity=".64"/><path d="M10 19l3-2" stroke="#e0b47c" stroke-width="1" opacity=".6"/>
    </pattern>
    <clipPath id={id + '-center-mask'}><path d="M332 77c-70 32-124 105-132 203-10 114 46 230 120 241 57 9 125-52 142-117 24-94-74-161-106-211-22-35 18-100-24-116Z"/></clipPath>
  </defs>
  <g stroke-linecap="round" stroke-width="4.4">
    <path d="M239 109c62-62 122-72 178-47" stroke="#063f2d"/>
    <path d="M428 66c65 16 110 67 130 134" stroke="#e8653d"/>
    <path d="M563 234c17 61 4 125-22 166" stroke="#ee693e"/>
    <path d="M430 528c-62 31-113 35-167 17" stroke="#dc7042"/>
    <path d="M229 530c-63-21-98-68-112-127" stroke="#0b4935"/>
    <path d="M101 335c-7-53 5-111 35-152" stroke="#c99b46"/>
  </g>
  <path d="M332 77c-70 32-124 105-132 203-10 114 46 230 120 241 57 9 125-52 142-117 24-94-74-161-106-211-22-35 18-100-24-116Z" fill={'url(#' + id + '-core)'}/>
  <g clip-path={'url(#' + id + '-center-mask)'} opacity=".54">
    <path d="M270 105c-15 100-9 267 112 397" stroke="#da995a" stroke-width="1.8" stroke-dasharray="3 8"/>
    <path d="M245 207c57 95 135 162 208 198" stroke="#d7af72" stroke-width="1.6" stroke-dasharray="2 10"/>
    <path d="M210 336c66 10 161 75 206 147" stroke="#f9c985" stroke-width="1.5" stroke-dasharray="4 12"/>
    <rect x="170" y="66" width="340" height="490" fill={'url(#' + id + '-seeds)'} opacity=".65"/>
  </g>
  <path d="M130 406C221 323 411 294 511 217" stroke="#d79c46" stroke-width="4.7" stroke-linecap="round"/>
  <g>
    <circle cx="151" cy="149" r="78" stroke="#02402e" stroke-width="7"/>
    <circle cx="502" cy="149" r="79" stroke="#e5613b" stroke-width="7"/>
    <circle cx="150" cy="449" r="78" stroke="#d39d45" stroke-width="7"/>
    <circle cx="500" cy="451" r="78" stroke="#241c1c" stroke-width="7"/>
  </g>
  <g class="soma-mark__emblem"><g transform="translate(88 86)"><SomaAulaIcon symbol="heart"/></g></g>
  <g class="soma-mark__emblem soma-mark__emblem--sound"><g transform="translate(439 87)"><SomaAulaIcon symbol="sound"/></g></g>
  <g class="soma-mark__emblem soma-mark__emblem--horse"><g transform="translate(87 386)"><SomaAulaIcon symbol="horse"/></g></g>
  <g class="soma-mark__emblem soma-mark__emblem--body"><g transform="translate(437 389)"><SomaAulaIcon symbol="body"/></g></g>
  <circle cx="242" cy="150" r="17" fill="#034730"/><circle cx="425" cy="146" r="17" fill="#df653a"/>
  <circle cx="145" cy="367" r="16" fill="#d29b45"/><circle cx="424" cy="447" r="16" fill="#271c1b"/>
</svg>
<style>
  .soma-mark { display:block; width:100%; height:100%; overflow:visible; }
  .soma-mark__emblem{color:#06432f}
  .soma-mark__emblem--sound{color:#e85c35}
  .soma-mark__emblem--horse{color:#d79e3e}
  .soma-mark__emblem--body{color:#241c1c}
</style>
