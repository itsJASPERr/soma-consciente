# Public configuration only. Never put API credentials in PUBLIC_ variables.
# Reserved for the future SOMA <-> Mágico OS integration.
PUBLIC_MAGICO_API_BASE_URL=
PUBLIC_MAGICO_ORGANIZATION_SLUG=soma

# Server-only. Meta hub challenge for GET /api/whatsapp/webhook.
# Set the same value as the Verify token in the Meta app. Never commit a real token.
WHATSAPP_VERIFY_TOKEN=
# Server-only. Meta App Secret used to validate X-Hub-Signature-256 on POST.
WHATSAPP_APP_SECRET=
# Server-only. Enable manual replies for this Pages environment after configuring the number and token.
WHATSAPP_REPLIES_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Server-only password for /mensajes/. If this is empty, the page is refused.
MENSJAES_PASSWORD=
